      "excerpts": [
        {
          "name": "Fin.divNat and Fin.modNat",
          "first_line": 132,
          "last_line": 138,
          "excerpt": "/-- Compute `i / n`, where `n` is a `Nat` and inferred the type of `i`. -/\ndef divNat (i : Fin (m * n)) : Fin m :=\n  \u27e8i / n, Nat.div_lt_of_lt_mul <| Nat.mul_comm m n \u25b8 i.is_lt\u27e9\n\n/-- Compute `i % n`, where `n` is a `Nat` and inferred the type of `i`. -/\ndef modNat (i : Fin (m * n)) : Fin n :=\n  \u27e8i % n, Nat.mod_lt _ <| Nat.pos_of_mul_pos_left i.pos\u27e9\n",
          "excerpt_sha256": "ccb041bcf586aab6419b5b1bf78a3cf5e8c2185b44e5e3a457f34b00812ce322"
        }
