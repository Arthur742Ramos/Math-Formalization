def periodic015_blocks : List (List AffineJump) := [periodic015_part00, periodic015_part01, periodic015_part02, periodic015_part03]

theorem periodic015_compiled : periodic015 = compiledJumpBlocks periodic015_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic015_value (t : ℝ) : affineJumpSum periodic015 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic015) t := by
  rw [periodic015_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic015_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic015_part00_eq, periodic015_part01_eq, periodic015_part02_eq, periodic015_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic015 = ((FrontierData.periodic015.drop 0).take 16) ++ ((FrontierData.periodic015.drop 16).take 16) ++ ((FrontierData.periodic015.drop 32).take 16) ++ ((FrontierData.periodic015.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
