def periodic040_blocks : List (List AffineJump) := [periodic040_part00, periodic040_part01, periodic040_part02, periodic040_part03]

theorem periodic040_compiled : periodic040 = compiledJumpBlocks periodic040_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic040_value (t : ℝ) : affineJumpSum periodic040 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic040) t := by
  rw [periodic040_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic040_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic040_part00_eq, periodic040_part01_eq, periodic040_part02_eq, periodic040_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic040 = ((FrontierData.periodic040.drop 0).take 16) ++ ((FrontierData.periodic040.drop 16).take 16) ++ ((FrontierData.periodic040.drop 32).take 16) ++ ((FrontierData.periodic040.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
