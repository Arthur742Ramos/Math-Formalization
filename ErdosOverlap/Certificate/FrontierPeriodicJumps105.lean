def periodic105_blocks : List (List AffineJump) := [periodic105_part00, periodic105_part01, periodic105_part02, periodic105_part03]

theorem periodic105_compiled : periodic105 = compiledJumpBlocks periodic105_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic105_value (t : ℝ) : affineJumpSum periodic105 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic105) t := by
  rw [periodic105_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic105_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic105_part00_eq, periodic105_part01_eq, periodic105_part02_eq, periodic105_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic105 = ((FrontierData.periodic105.drop 0).take 16) ++ ((FrontierData.periodic105.drop 16).take 16) ++ ((FrontierData.periodic105.drop 32).take 16) ++ ((FrontierData.periodic105.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
