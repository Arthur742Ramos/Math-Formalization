theorem slopeCache06_checked :
    slopeCache06.check 16384 nodes06 tauNumerator06 = true := by
  apply PLSlopeCache.check_of_dense slopeCache06 16384 nodes06 tauNumerator06 values06
  · rfl
  · decide +kernel

theorem slopeCache06_prefix : ∀ p ∈ nodes06,
    slopeCache06.firstCell+1 ≤ p.index := by
  decide +kernel

theorem dualSlope06_before {l r : ℝ}
    (hr : r ≤ (16154 : ℝ)/16384) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau06 : ℝ) v06 t = 2*(tau06 : ℝ) := by
  exact plWitness_ae_dualSlope_before (by norm_num : 0 < 16384)
    1000000000000000000 nodes06 slopeCache06.firstCell
    (tau06 : ℝ) slopeCache06_prefix hr

theorem dualSlope06_on_leaf {j : ℕ} (hj : j < slopeCache06.numerators.size)
    {l r : ℝ} (hl : (((slopeCache06.firstCell+j : ℕ) : ℝ)/16384) ≤ l)
    (hr : r ≤ ((((slopeCache06.firstCell+j : ℕ) : ℝ)+1)/16384)) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau06 : ℝ) v06 t = (slopeCache06.value 1000000000000000000 j : ℝ) := by
  have htau : (tau06 : ℝ) = ((tauNumerator06 : ℤ) : ℝ) / 1000000000000000000 := by
    norm_num [tauNumerator06, tau06]
  rw [htau]
  exact slopeCache06.ae_dualSlope_on_leaf (by norm_num : 0 < 16384)
    1000000000000000000 nodes06 tauNumerator06 slopeCache06_checked hj hl hr

