def nodes06 : List PLNode := densePLNodes 16155 values06

theorem nodes06_valid : PLValid 16384 nodes06 := by
  decide +kernel

theorem nodes06_mass : plMass nodes06 = 584107463464222 := by
  decide +kernel

def v06 : ℝ → ℝ := plWitness 16384 1000000000000000000 nodes06

def tau06 : ℚ := (34389742376329 / 125000000000000000 : ℚ)
def Iv06 : ℚ := (35651090299329957 / 1000000000000000000000000 : ℚ)
def exactCost06 : ℚ := (292053731732111 / 8192000000000000000000 : ℚ)
def tauNumerator06 : ℤ := 275117939010632

theorem exactCost06_le : exactCost06 ≤ Iv06 := by
  decide +kernel

theorem v06_absolutelyContinuous : AbsolutelyContinuousOnInterval v06 0 1 :=
  plWitness_absolutelyContinuous 16384 1000000000000000000 nodes06

theorem v06_one : v06 1 = 0 := plWitness_one nodes06_valid
theorem v06_zero : v06 0 = 0 := plWitness_zero nodes06_valid

theorem v06_integral_abs : (∫ t in (0 : ℝ)..1, |v06 t|) = (exactCost06 : ℝ) := by
  change (∫ t in (0 : ℝ)..1, |plWitness 16384 1000000000000000000 nodes06 t|) = _
  rw [plWitness_integral_abs (by norm_num) (by norm_num) nodes06_valid, nodes06_mass]
  norm_num [exactCost06]

theorem v06_integral_abs_le : (∫ t in (0 : ℝ)..1, |v06 t|) ≤ (Iv06 : ℝ) := by
  rw [v06_integral_abs]
  exact_mod_cast exactCost06_le

