def periodic20_blocks : List (List AffineJump) := [periodic20_part00, periodic20_part01, periodic20_part02, periodic20_part03, periodic20_part04, periodic20_part05, periodic20_part06]

theorem periodic20_compiled : periodic20 = compiledJumpBlocks periodic20_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic20_value (t : ℝ) : affineJumpSum periodic20 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic20) t := by
  rw [periodic20_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic20_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic20_part00_eq, periodic20_part01_eq, periodic20_part02_eq, periodic20_part03_eq, periodic20_part04_eq, periodic20_part05_eq, periodic20_part06_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic20 = ((Native6Data.native6Periodic20.drop 0).take 42) ++ ((Native6Data.native6Periodic20.drop 42).take 42) ++ ((Native6Data.native6Periodic20.drop 84).take 42) ++ ((Native6Data.native6Periodic20.drop 126).take 42) ++ ((Native6Data.native6Periodic20.drop 168).take 42) ++ ((Native6Data.native6Periodic20.drop 210).take 42) ++ ((Native6Data.native6Periodic20.drop 252).take 4) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
