def periodic082_blocks : List (List AffineJump) := [periodic082_part00, periodic082_part01, periodic082_part02, periodic082_part03]

theorem periodic082_compiled : periodic082 = compiledJumpBlocks periodic082_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic082_value (t : ℝ) : affineJumpSum periodic082 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic082) t := by
  rw [periodic082_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic082_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic082_part00_eq, periodic082_part01_eq, periodic082_part02_eq, periodic082_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic082 = ((FrontierData.periodic082.drop 0).take 16) ++ ((FrontierData.periodic082.drop 16).take 16) ++ ((FrontierData.periodic082.drop 32).take 16) ++ ((FrontierData.periodic082.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
