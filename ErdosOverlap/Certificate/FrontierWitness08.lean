def nodes08 : List PLNode := densePLNodes 16157 values08

theorem nodes08_valid : PLValid 16384 nodes08 := by
  decide +kernel

theorem nodes08_mass : plMass nodes08 = 554068400820146 := by
  decide +kernel

def v08 : ℝ → ℝ := plWitness 16384 1000000000000000000 nodes08

def tau08 : ℚ := (265732043537707 / 1000000000000000000 : ℚ)
def Iv08 : ℚ := (845441285431131 / 25000000000000000000000 : ℚ)
def exactCost08 : ℚ := (277034200410073 / 8192000000000000000000 : ℚ)
def tauNumerator08 : ℤ := 265732043537707

theorem exactCost08_le : exactCost08 ≤ Iv08 := by
  decide +kernel

theorem v08_absolutelyContinuous : AbsolutelyContinuousOnInterval v08 0 1 :=
  plWitness_absolutelyContinuous 16384 1000000000000000000 nodes08

theorem v08_one : v08 1 = 0 := plWitness_one nodes08_valid
theorem v08_zero : v08 0 = 0 := plWitness_zero nodes08_valid

theorem v08_integral_abs : (∫ t in (0 : ℝ)..1, |v08 t|) = (exactCost08 : ℝ) := by
  change (∫ t in (0 : ℝ)..1, |plWitness 16384 1000000000000000000 nodes08 t|) = _
  rw [plWitness_integral_abs (by norm_num) (by norm_num) nodes08_valid, nodes08_mass]
  norm_num [exactCost08]

theorem v08_integral_abs_le : (∫ t in (0 : ℝ)..1, |v08 t|) ≤ (Iv08 : ℝ) := by
  rw [v08_integral_abs]
  exact_mod_cast exactCost08_le

