theorem slopeCache08_checked :
    slopeCache08.check 16384 nodes08 tauNumerator08 = true := by
  apply PLSlopeCache.check_of_dense slopeCache08 16384 nodes08 tauNumerator08 values08
  · rfl
  · decide +kernel

theorem slopeCache08_prefix : ∀ p ∈ nodes08,
    slopeCache08.firstCell+1 ≤ p.index := by
  decide +kernel

theorem dualSlope08_before {l r : ℝ}
    (hr : r ≤ (16156 : ℝ)/16384) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau08 : ℝ) v08 t = 2*(tau08 : ℝ) := by
  exact plWitness_ae_dualSlope_before (by norm_num : 0 < 16384)
    1000000000000000000 nodes08 slopeCache08.firstCell
    (tau08 : ℝ) slopeCache08_prefix hr

theorem dualSlope08_on_leaf {j : ℕ} (hj : j < slopeCache08.numerators.size)
    {l r : ℝ} (hl : (((slopeCache08.firstCell+j : ℕ) : ℝ)/16384) ≤ l)
    (hr : r ≤ ((((slopeCache08.firstCell+j : ℕ) : ℝ)+1)/16384)) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau08 : ℝ) v08 t = (slopeCache08.value 1000000000000000000 j : ℝ) := by
  have htau : (tau08 : ℝ) = ((tauNumerator08 : ℤ) : ℝ) / 1000000000000000000 := by
    norm_num [tauNumerator08, tau08]
  rw [htau]
  exact slopeCache08.ae_dualSlope_on_leaf (by norm_num : 0 < 16384)
    1000000000000000000 nodes08 tauNumerator08 slopeCache08_checked hj hl hr

