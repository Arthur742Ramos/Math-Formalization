def periodic00_blocks : List (List AffineJump) := [periodic00_part00, periodic00_part01, periodic00_part02, periodic00_part03]

theorem periodic00_compiled : periodic00 = compiledJumpBlocks periodic00_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic00_value (t : ℝ) : affineJumpSum periodic00 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic00) t := by
  rw [periodic00_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic00_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic00_part00_eq, periodic00_part01_eq, periodic00_part02_eq, periodic00_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic00 = ((Native6Data.native6Periodic00.drop 0).take 64) ++ ((Native6Data.native6Periodic00.drop 64).take 64) ++ ((Native6Data.native6Periodic00.drop 128).take 64) ++ ((Native6Data.native6Periodic00.drop 192).take 64) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
