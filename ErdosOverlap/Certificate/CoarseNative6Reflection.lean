module

public import ErdosOverlap.Certificate.CoarseNative6
public import ErdosOverlap.Constant

/-!
# Colour reflection of the rounded cover

Generated by `scripts/generate_coarse_cover.py`.
The exact finite inequalities are kernel checked. The proposed integral
enclosures are not asserted to be analytically valid by these theorems.
-/

@[expose] public section

namespace ErdosOverlap.Certificate.CoarseNative6

set_option maxRecDepth 10000
set_option maxHeartbeats 4000000

theorem allRows_eq_reflections_append :
    allRows = positiveRows.reverse.map Row.reflected ++ positiveRows := by decide +kernel

/-- This only assembles separately proved physical inequalities. The
numerical integral enclosures must still be supplied in `hpositive`. -/
theorem allRows_physical_of_positive
    (hpositive : PhysicalMeanInequalities positiveRows auxiliaryHeight) :
    PhysicalMeanInequalities allRows auxiliaryHeight := by
  intro r hr
  rw [allRows_eq_reflections_append] at hr
  rcases List.mem_append.mp hr with hr | hr
  · rcases List.mem_map.mp hr with ⟨s, hs, rfl⟩
    exact (hpositive s (List.mem_reverse.mp hs)).reflected
  · exact hpositive r hr

theorem headline_lt_erdosConstant_of_positive
    (hpositive : PhysicalMeanInequalities positiveRows auxiliaryHeight) :
    (headlineTarget : ℝ) < erdosOverlapConstant := by
  exact headline_lt_erdosConstant_of_physicalMeanCover
    height_order.2.2.1 allRows_chain allRows_valid
    (allRows_physical_of_positive hpositive)

end ErdosOverlap.Certificate.CoarseNative6
