def periodic069_blocks : List (List AffineJump) := [periodic069_part00, periodic069_part01, periodic069_part02, periodic069_part03]

theorem periodic069_compiled : periodic069 = compiledJumpBlocks periodic069_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic069_value (t : ℝ) : affineJumpSum periodic069 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic069) t := by
  rw [periodic069_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic069_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic069_part00_eq, periodic069_part01_eq, periodic069_part02_eq, periodic069_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic069 = ((FrontierData.periodic069.drop 0).take 16) ++ ((FrontierData.periodic069.drop 16).take 16) ++ ((FrontierData.periodic069.drop 32).take 16) ++ ((FrontierData.periodic069.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
