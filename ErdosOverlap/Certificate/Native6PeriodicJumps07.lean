def periodic07_blocks : List (List AffineJump) := [periodic07_part00, periodic07_part01, periodic07_part02, periodic07_part03]

theorem periodic07_compiled : periodic07 = compiledJumpBlocks periodic07_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic07_value (t : ℝ) : affineJumpSum periodic07 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic07) t := by
  rw [periodic07_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic07_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic07_part00_eq, periodic07_part01_eq, periodic07_part02_eq, periodic07_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic07 = ((Native6Data.native6Periodic07.drop 0).take 64) ++ ((Native6Data.native6Periodic07.drop 64).take 64) ++ ((Native6Data.native6Periodic07.drop 128).take 64) ++ ((Native6Data.native6Periodic07.drop 192).take 64) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
