def periodic097_blocks : List (List AffineJump) := [periodic097_part00, periodic097_part01, periodic097_part02, periodic097_part03]

theorem periodic097_compiled : periodic097 = compiledJumpBlocks periodic097_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic097_value (t : ℝ) : affineJumpSum periodic097 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic097) t := by
  rw [periodic097_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic097_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic097_part00_eq, periodic097_part01_eq, periodic097_part02_eq, periodic097_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic097 = ((FrontierData.periodic097.drop 0).take 16) ++ ((FrontierData.periodic097.drop 16).take 16) ++ ((FrontierData.periodic097.drop 32).take 16) ++ ((FrontierData.periodic097.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
