def periodic049_blocks : List (List AffineJump) := [periodic049_part00, periodic049_part01, periodic049_part02, periodic049_part03]

theorem periodic049_compiled : periodic049 = compiledJumpBlocks periodic049_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic049_value (t : ℝ) : affineJumpSum periodic049 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic049) t := by
  rw [periodic049_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic049_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic049_part00_eq, periodic049_part01_eq, periodic049_part02_eq, periodic049_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic049 = ((FrontierData.periodic049.drop 0).take 16) ++ ((FrontierData.periodic049.drop 16).take 16) ++ ((FrontierData.periodic049.drop 32).take 16) ++ ((FrontierData.periodic049.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
