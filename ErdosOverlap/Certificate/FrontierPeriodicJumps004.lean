def periodic004_blocks : List (List AffineJump) := [periodic004_part00, periodic004_part01, periodic004_part02, periodic004_part03]

theorem periodic004_compiled : periodic004 = compiledJumpBlocks periodic004_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic004_value (t : ℝ) : affineJumpSum periodic004 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic004) t := by
  rw [periodic004_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic004_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic004_part00_eq, periodic004_part01_eq, periodic004_part02_eq, periodic004_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic004 = ((FrontierData.periodic004.drop 0).take 16) ++ ((FrontierData.periodic004.drop 16).take 16) ++ ((FrontierData.periodic004.drop 32).take 16) ++ ((FrontierData.periodic004.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
