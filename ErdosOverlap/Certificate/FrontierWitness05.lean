theorem slopeCache05_checked :
    slopeCache05.check 16384 nodes05 tauNumerator05 = true := by
  apply PLSlopeCache.check_of_dense slopeCache05 16384 nodes05 tauNumerator05 values05
  · rfl
  · decide +kernel

theorem slopeCache05_prefix : ∀ p ∈ nodes05,
    slopeCache05.firstCell+1 ≤ p.index := by
  decide +kernel

theorem dualSlope05_before {l r : ℝ}
    (hr : r ≤ (16157 : ℝ)/16384) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau05 : ℝ) v05 t = 2*(tau05 : ℝ) := by
  exact plWitness_ae_dualSlope_before (by norm_num : 0 < 16384)
    1000000000000000000 nodes05 slopeCache05.firstCell
    (tau05 : ℝ) slopeCache05_prefix hr

theorem dualSlope05_on_leaf {j : ℕ} (hj : j < slopeCache05.numerators.size)
    {l r : ℝ} (hl : (((slopeCache05.firstCell+j : ℕ) : ℝ)/16384) ≤ l)
    (hr : r ≤ ((((slopeCache05.firstCell+j : ℕ) : ℝ)+1)/16384)) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau05 : ℝ) v05 t = (slopeCache05.value 1000000000000000000 j : ℝ) := by
  have htau : (tau05 : ℝ) = ((tauNumerator05 : ℤ) : ℝ) / 1000000000000000000 := by
    norm_num [tauNumerator05, tau05]
  rw [htau]
  exact slopeCache05.ae_dualSlope_on_leaf (by norm_num : 0 < 16384)
    1000000000000000000 nodes05 tauNumerator05 slopeCache05_checked hj hl hr

