def nodes05 : List PLNode := densePLNodes 16158 values05

theorem nodes05_valid : PLValid 16384 nodes05 := by
  decide +kernel

theorem nodes05_mass : plMass nodes05 = 539360050856164 := by
  decide +kernel

def v05 : ℝ → ℝ := plWitness 16384 1000000000000000000 nodes05

def tau05 : ℚ := (4079304191633 / 15625000000000000 : ℚ)
def Iv05 : ℚ := (32919924979013917 / 1000000000000000000000000 : ℚ)
def exactCost05 : ℚ := (134840012714041 / 4096000000000000000000 : ℚ)
def tauNumerator05 : ℤ := 261075468264512

theorem exactCost05_le : exactCost05 ≤ Iv05 := by
  decide +kernel

theorem v05_absolutelyContinuous : AbsolutelyContinuousOnInterval v05 0 1 :=
  plWitness_absolutelyContinuous 16384 1000000000000000000 nodes05

theorem v05_one : v05 1 = 0 := plWitness_one nodes05_valid
theorem v05_zero : v05 0 = 0 := plWitness_zero nodes05_valid

theorem v05_integral_abs : (∫ t in (0 : ℝ)..1, |v05 t|) = (exactCost05 : ℝ) := by
  change (∫ t in (0 : ℝ)..1, |plWitness 16384 1000000000000000000 nodes05 t|) = _
  rw [plWitness_integral_abs (by norm_num) (by norm_num) nodes05_valid, nodes05_mass]
  norm_num [exactCost05]

theorem v05_integral_abs_le : (∫ t in (0 : ℝ)..1, |v05 t|) ≤ (Iv05 : ℝ) := by
  rw [v05_integral_abs]
  exact_mod_cast exactCost05_le

