def periodic073_blocks : List (List AffineJump) := [periodic073_part00, periodic073_part01, periodic073_part02, periodic073_part03]

theorem periodic073_compiled : periodic073 = compiledJumpBlocks periodic073_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic073_value (t : ℝ) : affineJumpSum periodic073 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic073) t := by
  rw [periodic073_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic073_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic073_part00_eq, periodic073_part01_eq, periodic073_part02_eq, periodic073_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic073 = ((FrontierData.periodic073.drop 0).take 16) ++ ((FrontierData.periodic073.drop 16).take 16) ++ ((FrontierData.periodic073.drop 32).take 16) ++ ((FrontierData.periodic073.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
