theorem periodic17_compiled : periodic17 = compiledJumpBlocks periodic17_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic17_value (t : ℝ) : affineJumpSum periodic17 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic17) t := by
  rw [periodic17_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic17_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic17_part00_eq, periodic17_part01_eq, periodic17_part02_eq, periodic17_part03_eq, periodic17_part04_eq, periodic17_part05_eq, periodic17_part06_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic17 = ((Native6Data.native6Periodic17.drop 0).take 42) ++ ((Native6Data.native6Periodic17.drop 42).take 42) ++ ((Native6Data.native6Periodic17.drop 84).take 42) ++ ((Native6Data.native6Periodic17.drop 126).take 42) ++ ((Native6Data.native6Periodic17.drop 168).take 42) ++ ((Native6Data.native6Periodic17.drop 210).take 42) ++ ((Native6Data.native6Periodic17.drop 252).take 4) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

