def periodic036_blocks : List (List AffineJump) := [periodic036_part00, periodic036_part01, periodic036_part02, periodic036_part03]

theorem periodic036_compiled : periodic036 = compiledJumpBlocks periodic036_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic036_value (t : ℝ) : affineJumpSum periodic036 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic036) t := by
  rw [periodic036_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic036_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic036_part00_eq, periodic036_part01_eq, periodic036_part02_eq, periodic036_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic036 = ((FrontierData.periodic036.drop 0).take 16) ++ ((FrontierData.periodic036.drop 16).take 16) ++ ((FrontierData.periodic036.drop 32).take 16) ++ ((FrontierData.periodic036.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
