theorem periodic19_value (t : ℝ) : affineJumpSum periodic19 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic19) t := by
  rw [periodic19_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic19_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic19_part00_eq, periodic19_part01_eq, periodic19_part02_eq, periodic19_part03_eq, periodic19_part04_eq, periodic19_part05_eq, periodic19_part06_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
