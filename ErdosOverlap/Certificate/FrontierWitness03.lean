theorem slopeCache03_checked :
    slopeCache03.check 16384 nodes03 tauNumerator03 = true := by
  apply PLSlopeCache.check_of_dense slopeCache03 16384 nodes03 tauNumerator03 values03
  · rfl
  · decide +kernel

theorem slopeCache03_prefix : ∀ p ∈ nodes03,
    slopeCache03.firstCell+1 ≤ p.index := by
  decide +kernel

theorem dualSlope03_before {l r : ℝ}
    (hr : r ≤ (16067 : ℝ)/16384) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau03 : ℝ) v03 t = 2*(tau03 : ℝ) := by
  exact plWitness_ae_dualSlope_before (by norm_num : 0 < 16384)
    1000000000000000000 nodes03 slopeCache03.firstCell
    (tau03 : ℝ) slopeCache03_prefix hr

theorem dualSlope03_on_leaf {j : ℕ} (hj : j < slopeCache03.numerators.size)
    {l r : ℝ} (hl : (((slopeCache03.firstCell+j : ℕ) : ℝ)/16384) ≤ l)
    (hr : r ≤ ((((slopeCache03.firstCell+j : ℕ) : ℝ)+1)/16384)) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau03 : ℝ) v03 t = (slopeCache03.value 1000000000000000000 j : ℝ) := by
  have htau : (tau03 : ℝ) = ((tauNumerator03 : ℤ) : ℝ) / 1000000000000000000 := by
    norm_num [tauNumerator03, tau03]
  rw [htau]
  exact slopeCache03.ae_dualSlope_on_leaf (by norm_num : 0 < 16384)
    1000000000000000000 nodes03 tauNumerator03 slopeCache03_checked hj hl hr

