def exactCost03 : ℚ := (290185818126351 / 1638400000000000000000 : ℚ)
def tauNumerator03 : ℤ := 770388482790670

theorem exactCost03_le : exactCost03 ≤ Iv03 := by
  decide +kernel

theorem v03_absolutelyContinuous : AbsolutelyContinuousOnInterval v03 0 1 :=
  plWitness_absolutelyContinuous 16384 1000000000000000000 nodes03

theorem v03_one : v03 1 = 0 := plWitness_one nodes03_valid
theorem v03_zero : v03 0 = 0 := plWitness_zero nodes03_valid

theorem v03_integral_abs : (∫ t in (0 : ℝ)..1, |v03 t|) = (exactCost03 : ℝ) := by
  change (∫ t in (0 : ℝ)..1, |plWitness 16384 1000000000000000000 nodes03 t|) = _
  rw [plWitness_integral_abs (by norm_num) (by norm_num) nodes03_valid, nodes03_mass]
  norm_num [exactCost03]

theorem v03_integral_abs_le : (∫ t in (0 : ℝ)..1, |v03 t|) ≤ (Iv03 : ℝ) := by
  rw [v03_integral_abs]
  exact_mod_cast exactCost03_le

