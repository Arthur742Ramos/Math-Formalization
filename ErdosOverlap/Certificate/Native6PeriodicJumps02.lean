theorem periodic02_value (t : ℝ) : affineJumpSum periodic02 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic02) t := by
  rw [periodic02_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic02_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic02_part00_eq, periodic02_part01_eq, periodic02_part02_eq, periodic02_part03_eq]
