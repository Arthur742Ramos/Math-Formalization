theorem polynomial_denominator_upper : signedKernelDenominator Outer180.polynomial168.value ≤ (262723/100000 : ℝ) := by
  simpa only [Rat.cast_div, Rat.cast_ofNat] using
    Outer180.polynomial168.denominator_le_of_rational_integral_bounds positiveIntegral_bound negativeIntegral_bound total_checked

theorem denominator_upper : signedKernelDenominator Outer180.bin168.kernel ≤ (262723/100000 : ℝ) := by
  have he : Outer180.bin168.kernel = Outer180.polynomial168.value :=
    funext (fun t => (Outer180.polynomial168_value t).symm)
  rw [he]
  exact polynomial_denominator_upper

