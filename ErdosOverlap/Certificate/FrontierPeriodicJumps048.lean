def periodic048_blocks : List (List AffineJump) := [periodic048_part00, periodic048_part01, periodic048_part02, periodic048_part03]

theorem periodic048_compiled : periodic048 = compiledJumpBlocks periodic048_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic048_value (t : ℝ) : affineJumpSum periodic048 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic048) t := by
  rw [periodic048_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic048_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic048_part00_eq, periodic048_part01_eq, periodic048_part02_eq, periodic048_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic048 = ((FrontierData.periodic048.drop 0).take 16) ++ ((FrontierData.periodic048.drop 16).take 16) ++ ((FrontierData.periodic048.drop 32).take 16) ++ ((FrontierData.periodic048.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
