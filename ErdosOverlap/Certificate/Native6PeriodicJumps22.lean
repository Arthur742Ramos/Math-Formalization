def periodic22_blocks : List (List AffineJump) := [periodic22_part00, periodic22_part01, periodic22_part02, periodic22_part03, periodic22_part04, periodic22_part05, periodic22_part06, periodic22_part07]

theorem periodic22_compiled : periodic22 = compiledJumpBlocks periodic22_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic22_value (t : ℝ) : affineJumpSum periodic22 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic22) t := by
  rw [periodic22_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic22_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic22_part00_eq, periodic22_part01_eq, periodic22_part02_eq, periodic22_part03_eq, periodic22_part04_eq, periodic22_part05_eq, periodic22_part06_eq, periodic22_part07_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic22 = ((Native6Data.native6Periodic22.drop 0).take 32) ++ ((Native6Data.native6Periodic22.drop 32).take 32) ++ ((Native6Data.native6Periodic22.drop 64).take 32) ++ ((Native6Data.native6Periodic22.drop 96).take 32) ++ ((Native6Data.native6Periodic22.drop 128).take 32) ++ ((Native6Data.native6Periodic22.drop 160).take 32) ++ ((Native6Data.native6Periodic22.drop 192).take 32) ++ ((Native6Data.native6Periodic22.drop 224).take 32) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
