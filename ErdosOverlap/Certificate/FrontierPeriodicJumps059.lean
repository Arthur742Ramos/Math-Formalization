def periodic059_blocks : List (List AffineJump) := [periodic059_part00, periodic059_part01, periodic059_part02, periodic059_part03]

theorem periodic059_compiled : periodic059 = compiledJumpBlocks periodic059_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic059_value (t : ℝ) : affineJumpSum periodic059 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic059) t := by
  rw [periodic059_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic059_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic059_part00_eq, periodic059_part01_eq, periodic059_part02_eq, periodic059_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic059 = ((FrontierData.periodic059.drop 0).take 16) ++ ((FrontierData.periodic059.drop 16).take 16) ++ ((FrontierData.periodic059.drop 32).take 16) ++ ((FrontierData.periodic059.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
