def periodic009_blocks : List (List AffineJump) := [periodic009_part00, periodic009_part01, periodic009_part02, periodic009_part03]

theorem periodic009_compiled : periodic009 = compiledJumpBlocks periodic009_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic009_value (t : ℝ) : affineJumpSum periodic009 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic009) t := by
  rw [periodic009_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic009_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic009_part00_eq, periodic009_part01_eq, periodic009_part02_eq, periodic009_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic009 = ((FrontierData.periodic009.drop 0).take 16) ++ ((FrontierData.periodic009.drop 16).take 16) ++ ((FrontierData.periodic009.drop 32).take 16) ++ ((FrontierData.periodic009.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
