def periodic04_blocks : List (List AffineJump) := [periodic04_part00, periodic04_part01, periodic04_part02, periodic04_part03]

theorem periodic04_compiled : periodic04 = compiledJumpBlocks periodic04_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic04_value (t : ℝ) : affineJumpSum periodic04 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic04) t := by
  rw [periodic04_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic04_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic04_part00_eq, periodic04_part01_eq, periodic04_part02_eq, periodic04_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic04 = ((Native6Data.native6Periodic04.drop 0).take 64) ++ ((Native6Data.native6Periodic04.drop 64).take 64) ++ ((Native6Data.native6Periodic04.drop 128).take 64) ++ ((Native6Data.native6Periodic04.drop 192).take 64) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
