theorem periodic072_value (t : ℝ) : affineJumpSum periodic072 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic072) t := by
  rw [periodic072_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic072_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic072_part00_eq, periodic072_part01_eq, periodic072_part02_eq, periodic072_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
