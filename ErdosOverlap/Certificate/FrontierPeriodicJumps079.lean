def periodic079_blocks : List (List AffineJump) := [periodic079_part00, periodic079_part01, periodic079_part02, periodic079_part03]

theorem periodic079_compiled : periodic079 = compiledJumpBlocks periodic079_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic079_value (t : ℝ) : affineJumpSum periodic079 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic079) t := by
  rw [periodic079_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic079_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic079_part00_eq, periodic079_part01_eq, periodic079_part02_eq, periodic079_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic079 = ((FrontierData.periodic079.drop 0).take 16) ++ ((FrontierData.periodic079.drop 16).take 16) ++ ((FrontierData.periodic079.drop 32).take 16) ++ ((FrontierData.periodic079.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
