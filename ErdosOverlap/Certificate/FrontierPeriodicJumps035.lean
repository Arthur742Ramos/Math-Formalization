def periodic035_blocks : List (List AffineJump) := [periodic035_part00, periodic035_part01, periodic035_part02, periodic035_part03]

theorem periodic035_compiled : periodic035 = compiledJumpBlocks periodic035_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic035_value (t : ℝ) : affineJumpSum periodic035 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic035) t := by
  rw [periodic035_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic035_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic035_part00_eq, periodic035_part01_eq, periodic035_part02_eq, periodic035_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic035 = ((FrontierData.periodic035.drop 0).take 16) ++ ((FrontierData.periodic035.drop 16).take 16) ++ ((FrontierData.periodic035.drop 32).take 16) ++ ((FrontierData.periodic035.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
