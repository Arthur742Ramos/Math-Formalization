def periodic058_blocks : List (List AffineJump) := [periodic058_part00, periodic058_part01, periodic058_part02, periodic058_part03]

theorem periodic058_compiled : periodic058 = compiledJumpBlocks periodic058_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic058_value (t : ℝ) : affineJumpSum periodic058 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic058) t := by
  rw [periodic058_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic058_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic058_part00_eq, periodic058_part01_eq, periodic058_part02_eq, periodic058_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic058 = ((FrontierData.periodic058.drop 0).take 16) ++ ((FrontierData.periodic058.drop 16).take 16) ++ ((FrontierData.periodic058.drop 32).take 16) ++ ((FrontierData.periodic058.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
