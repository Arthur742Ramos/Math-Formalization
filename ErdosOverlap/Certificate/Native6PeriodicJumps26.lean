def periodic26_blocks : List (List AffineJump) := [periodic26_part00, periodic26_part01, periodic26_part02, periodic26_part03, periodic26_part04, periodic26_part05, periodic26_part06, periodic26_part07]

theorem periodic26_compiled : periodic26 = compiledJumpBlocks periodic26_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic26_value (t : ℝ) : affineJumpSum periodic26 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic26) t := by
  rw [periodic26_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic26_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic26_part00_eq, periodic26_part01_eq, periodic26_part02_eq, periodic26_part03_eq, periodic26_part04_eq, periodic26_part05_eq, periodic26_part06_eq, periodic26_part07_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic26 = ((Native6Data.native6Periodic26.drop 0).take 32) ++ ((Native6Data.native6Periodic26.drop 32).take 32) ++ ((Native6Data.native6Periodic26.drop 64).take 32) ++ ((Native6Data.native6Periodic26.drop 96).take 32) ++ ((Native6Data.native6Periodic26.drop 128).take 32) ++ ((Native6Data.native6Periodic26.drop 160).take 32) ++ ((Native6Data.native6Periodic26.drop 192).take 32) ++ ((Native6Data.native6Periodic26.drop 224).take 32) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
