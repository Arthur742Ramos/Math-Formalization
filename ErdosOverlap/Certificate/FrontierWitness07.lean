def nodes07 : List PLNode := densePLNodes 16156 values07

theorem nodes07_valid : PLValid 16384 nodes07 := by
  decide +kernel

theorem nodes07_mass : plMass nodes07 = 568982777408793 := by
  decide +kernel

def v07 : ℝ → ℝ := plWitness 16384 1000000000000000000 nodes07

def tau07 : ℚ := (270412621368237 / 1000000000000000000 : ℚ)
def Iv07 : ℚ := (34727952722704651 / 1000000000000000000000000 : ℚ)
def exactCost07 : ℚ := (568982777408793 / 16384000000000000000000 : ℚ)
def tauNumerator07 : ℤ := 270412621368237

theorem exactCost07_le : exactCost07 ≤ Iv07 := by
  decide +kernel

theorem v07_absolutelyContinuous : AbsolutelyContinuousOnInterval v07 0 1 :=
  plWitness_absolutelyContinuous 16384 1000000000000000000 nodes07

theorem v07_one : v07 1 = 0 := plWitness_one nodes07_valid
theorem v07_zero : v07 0 = 0 := plWitness_zero nodes07_valid

theorem v07_integral_abs : (∫ t in (0 : ℝ)..1, |v07 t|) = (exactCost07 : ℝ) := by
  change (∫ t in (0 : ℝ)..1, |plWitness 16384 1000000000000000000 nodes07 t|) = _
  rw [plWitness_integral_abs (by norm_num) (by norm_num) nodes07_valid, nodes07_mass]
  norm_num [exactCost07]

theorem v07_integral_abs_le : (∫ t in (0 : ℝ)..1, |v07 t|) ≤ (Iv07 : ℝ) := by
  rw [v07_integral_abs]
  exact_mod_cast exactCost07_le

