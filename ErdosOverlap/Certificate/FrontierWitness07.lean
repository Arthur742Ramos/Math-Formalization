theorem slopeCache07_checked :
    slopeCache07.check 16384 nodes07 tauNumerator07 = true := by
  apply PLSlopeCache.check_of_dense slopeCache07 16384 nodes07 tauNumerator07 values07
  · rfl
  · decide +kernel

theorem slopeCache07_prefix : ∀ p ∈ nodes07,
    slopeCache07.firstCell+1 ≤ p.index := by
  decide +kernel

theorem dualSlope07_before {l r : ℝ}
    (hr : r ≤ (16155 : ℝ)/16384) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau07 : ℝ) v07 t = 2*(tau07 : ℝ) := by
  exact plWitness_ae_dualSlope_before (by norm_num : 0 < 16384)
    1000000000000000000 nodes07 slopeCache07.firstCell
    (tau07 : ℝ) slopeCache07_prefix hr

theorem dualSlope07_on_leaf {j : ℕ} (hj : j < slopeCache07.numerators.size)
    {l r : ℝ} (hl : (((slopeCache07.firstCell+j : ℕ) : ℝ)/16384) ≤ l)
    (hr : r ≤ ((((slopeCache07.firstCell+j : ℕ) : ℝ)+1)/16384)) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau07 : ℝ) v07 t = (slopeCache07.value 1000000000000000000 j : ℝ) := by
  have htau : (tau07 : ℝ) = ((tauNumerator07 : ℤ) : ℝ) / 1000000000000000000 := by
    norm_num [tauNumerator07, tau07]
  rw [htau]
  exact slopeCache07.ae_dualSlope_on_leaf (by norm_num : 0 < 16384)
    1000000000000000000 nodes07 tauNumerator07 slopeCache07_checked hj hl hr

