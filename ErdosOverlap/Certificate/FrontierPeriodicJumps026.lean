def periodic026_blocks : List (List AffineJump) := [periodic026_part00, periodic026_part01, periodic026_part02, periodic026_part03]

theorem periodic026_compiled : periodic026 = compiledJumpBlocks periodic026_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic026_value (t : ℝ) : affineJumpSum periodic026 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic026) t := by
  rw [periodic026_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic026_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic026_part00_eq, periodic026_part01_eq, periodic026_part02_eq, periodic026_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic026 = ((FrontierData.periodic026.drop 0).take 16) ++ ((FrontierData.periodic026.drop 16).take 16) ++ ((FrontierData.periodic026.drop 32).take 16) ++ ((FrontierData.periodic026.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
