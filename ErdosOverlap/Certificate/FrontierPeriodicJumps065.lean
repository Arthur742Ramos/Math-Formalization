def periodic065_blocks : List (List AffineJump) := [periodic065_part00, periodic065_part01, periodic065_part02, periodic065_part03]

theorem periodic065_compiled : periodic065 = compiledJumpBlocks periodic065_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic065_value (t : ℝ) : affineJumpSum periodic065 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic065) t := by
  rw [periodic065_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic065_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic065_part00_eq, periodic065_part01_eq, periodic065_part02_eq, periodic065_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic065 = ((FrontierData.periodic065.drop 0).take 16) ++ ((FrontierData.periodic065.drop 16).take 16) ++ ((FrontierData.periodic065.drop 32).take 16) ++ ((FrontierData.periodic065.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
