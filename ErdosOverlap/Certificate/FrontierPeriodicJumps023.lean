def periodic023_blocks : List (List AffineJump) := [periodic023_part00, periodic023_part01, periodic023_part02, periodic023_part03]

theorem periodic023_compiled : periodic023 = compiledJumpBlocks periodic023_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic023_value (t : ℝ) : affineJumpSum periodic023 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic023) t := by
  rw [periodic023_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic023_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic023_part00_eq, periodic023_part01_eq, periodic023_part02_eq, periodic023_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic023 = ((FrontierData.periodic023.drop 0).take 16) ++ ((FrontierData.periodic023.drop 16).take 16) ++ ((FrontierData.periodic023.drop 32).take 16) ++ ((FrontierData.periodic023.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
