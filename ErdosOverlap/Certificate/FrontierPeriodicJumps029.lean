def periodic029_blocks : List (List AffineJump) := [periodic029_part00, periodic029_part01, periodic029_part02, periodic029_part03]

theorem periodic029_compiled : periodic029 = compiledJumpBlocks periodic029_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic029_value (t : ℝ) : affineJumpSum periodic029 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic029) t := by
  rw [periodic029_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic029_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic029_part00_eq, periodic029_part01_eq, periodic029_part02_eq, periodic029_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic029 = ((FrontierData.periodic029.drop 0).take 16) ++ ((FrontierData.periodic029.drop 16).take 16) ++ ((FrontierData.periodic029.drop 32).take 16) ++ ((FrontierData.periodic029.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
