def periodic017_blocks : List (List AffineJump) := [periodic017_part00, periodic017_part01, periodic017_part02, periodic017_part03]

theorem periodic017_compiled : periodic017 = compiledJumpBlocks periodic017_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic017_value (t : ℝ) : affineJumpSum periodic017 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic017) t := by
  rw [periodic017_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic017_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic017_part00_eq, periodic017_part01_eq, periodic017_part02_eq, periodic017_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic017 = ((FrontierData.periodic017.drop 0).take 16) ++ ((FrontierData.periodic017.drop 16).take 16) ++ ((FrontierData.periodic017.drop 32).take 16) ++ ((FrontierData.periodic017.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
