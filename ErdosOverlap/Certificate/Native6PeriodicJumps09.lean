theorem periodic09_value (t : ℝ) : affineJumpSum periodic09 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic09) t := by
  rw [periodic09_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic09_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic09_part00_eq, periodic09_part01_eq, periodic09_part02_eq, periodic09_part03_eq]
