  rw [periodic03_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic03_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic03_part00_eq, periodic03_part01_eq, periodic03_part02_eq, periodic03_part03_eq]
