def periodic091_blocks : List (List AffineJump) := [periodic091_part00, periodic091_part01, periodic091_part02, periodic091_part03]

theorem periodic091_compiled : periodic091 = compiledJumpBlocks periodic091_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic091_value (t : ℝ) : affineJumpSum periodic091 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic091) t := by
  rw [periodic091_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic091_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic091_part00_eq, periodic091_part01_eq, periodic091_part02_eq, periodic091_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic091 = ((FrontierData.periodic091.drop 0).take 16) ++ ((FrontierData.periodic091.drop 16).take 16) ++ ((FrontierData.periodic091.drop 32).take 16) ++ ((FrontierData.periodic091.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
