  rw [periodic083_part00_eq, periodic083_part01_eq, periodic083_part02_eq, periodic083_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic083 = ((FrontierData.periodic083.drop 0).take 16) ++ ((FrontierData.periodic083.drop 16).take 16) ++ ((FrontierData.periodic083.drop 32).take 16) ++ ((FrontierData.periodic083.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

