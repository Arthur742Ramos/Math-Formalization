theorem periodic083_value (t : ℝ) : affineJumpSum periodic083 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic083) t := by
  rw [periodic083_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic083_blocks, List.flatten_cons, List.flatten_nil,
