theorem slopeCache04_checked :
    slopeCache04.check 16384 nodes04 tauNumerator04 = true := by
  apply PLSlopeCache.check_of_dense slopeCache04 16384 nodes04 tauNumerator04 values04
  · rfl
  · decide +kernel

theorem slopeCache04_prefix : ∀ p ∈ nodes04,
    slopeCache04.firstCell+1 ≤ p.index := by
  decide +kernel

theorem dualSlope04_before {l r : ℝ}
    (hr : r ≤ (16163 : ℝ)/16384) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau04 : ℝ) v04 t = 2*(tau04 : ℝ) := by
  exact plWitness_ae_dualSlope_before (by norm_num : 0 < 16384)
    1000000000000000000 nodes04 slopeCache04.firstCell
    (tau04 : ℝ) slopeCache04_prefix hr

theorem dualSlope04_on_leaf {j : ℕ} (hj : j < slopeCache04.numerators.size)
    {l r : ℝ} (hl : (((slopeCache04.firstCell+j : ℕ) : ℝ)/16384) ≤ l)
    (hr : r ≤ ((((slopeCache04.firstCell+j : ℕ) : ℝ)+1)/16384)) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau04 : ℝ) v04 t = (slopeCache04.value 1000000000000000000 j : ℝ) := by
  have htau : (tau04 : ℝ) = ((tauNumerator04 : ℤ) : ℝ) / 1000000000000000000 := by
    norm_num [tauNumerator04, tau04]
  rw [htau]
  exact slopeCache04.ae_dualSlope_on_leaf (by norm_num : 0 < 16384)
    1000000000000000000 nodes04 tauNumerator04 slopeCache04_checked hj hl hr

