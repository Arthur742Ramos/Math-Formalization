def nodes04 : List PLNode := densePLNodes 16164 values04

theorem nodes04_valid : PLValid 16384 nodes04 := by
  decide +kernel

theorem nodes04_mass : plMass nodes04 = 455504489987579 := by
  decide +kernel

def v04 : ℝ → ℝ := plWitness 16384 1000000000000000000 nodes04

def tau04 : ℚ := (23369748718369 / 100000000000000000 : ℚ)
def Iv04 : ℚ := (5560357543793689 / 200000000000000000000000 : ℚ)
def exactCost04 : ℚ := (455504489987579 / 16384000000000000000000 : ℚ)
def tauNumerator04 : ℤ := 233697487183690

theorem exactCost04_le : exactCost04 ≤ Iv04 := by
  decide +kernel

theorem v04_absolutelyContinuous : AbsolutelyContinuousOnInterval v04 0 1 :=
  plWitness_absolutelyContinuous 16384 1000000000000000000 nodes04

theorem v04_one : v04 1 = 0 := plWitness_one nodes04_valid
theorem v04_zero : v04 0 = 0 := plWitness_zero nodes04_valid

theorem v04_integral_abs : (∫ t in (0 : ℝ)..1, |v04 t|) = (exactCost04 : ℝ) := by
  change (∫ t in (0 : ℝ)..1, |plWitness 16384 1000000000000000000 nodes04 t|) = _
  rw [plWitness_integral_abs (by norm_num) (by norm_num) nodes04_valid, nodes04_mass]
  norm_num [exactCost04]

theorem v04_integral_abs_le : (∫ t in (0 : ℝ)..1, |v04 t|) ≤ (Iv04 : ℝ) := by
  rw [v04_integral_abs]
  exact_mod_cast exactCost04_le

