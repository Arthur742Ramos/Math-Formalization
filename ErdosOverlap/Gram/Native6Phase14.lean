public import ErdosOverlap.Certificate.Native6KernelData

/-!
# Physical signed-functional theorem for native phase row 14

Generated by `scripts/generate_gram_sos.py`.  Splitting exact decisions across
small, sequentially imported modules bounds the kernel's temporary memory.
-/

@[expose] public section

namespace ErdosOverlap.Gram.Native6Phase14

open scoped BigOperators
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
set_option Elab.async false

def certificate : RawPhaseCertificate 127 where
  denominator := Native6Raw14.denominator
  diagonal := Native6Raw14.diagonal
  gamma := Native6Raw14.gamma
  nonnegative := Native6Raw14.nonnegative
  eta := Native6Raw14.eta
  triangles := Native6Raw14.triangles
  triangleTable := Native6Raw14.triangleTable
  cells_pos := by decide +kernel
  denominator_pos := Native6Raw14.denominator_pos
  diagonal_nonnegative := fun i => (Native6Raw14.nonnegative_multipliers i).1
  auxiliary_nonnegative := fun i => (Native6Raw14.nonnegative_multipliers i).2
  eta_nonnegative := Native6Raw14.eta_nonnegative
  triangles_valid := Native6Raw14.triangles_valid
  triangle_aggregation := Native6Raw14.triangle_aggregation
  full_nonnegative := by
    intro y hy
    simpa only [Native6Raw14.fullMatrix, Native6Raw14.fullInteger, Native6Raw14.scale_exact, Nat.cast_ofNat] using
      Native6Raw14.nonnegative_on_sum_zero y hy

theorem cells_exact : Native6Data.phase14.cells = 127 := rfl

theorem gamma_exact : certificate.gammaRational = Native6Data.phase14.gamma := by
  decide +kernel

theorem lower_exact : certificate.lowerRational = Native6Data.phase14.lowerAtZero := by
  change phaseLowerRational 127 Native6Raw14.denominator Native6Raw14.diagonal Native6Raw14.gamma
    Native6Raw14.nonnegative Native6Raw14.eta Native6Raw14.triangles = _
  rw [Native6Raw14.lower_exact]
  decide +kernel

theorem mean_exact : certificate.meanCoefficient = Native6Data.phase14.meanCoefficient := by
  decide +kernel

/-- Unconditional physical validity of the exact native phase row. -/
theorem functional_lower_bound {h : ℝ → ℝ} (hh : Admissible h) :
    (Native6Data.phase14.lowerAtZero : ℝ) + (Native6Data.phase14.meanCoefficient : ℝ) *
        profileMean (overlapProfile h)^2 ≤
      quartetFunctional h (phaseKernel Native6Data.phase14.cells Native6Data.phase14.gamma) := by
  have hbound := certificate.kernel_functional_lower_bound hh
  rw [gamma_exact, lower_exact, mean_exact] at hbound
  rw [cells_exact]
  exact hbound

end ErdosOverlap.Gram.Native6Phase14
