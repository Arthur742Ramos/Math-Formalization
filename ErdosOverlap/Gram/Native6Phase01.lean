module

public import ErdosOverlap.Gram.Native6Raw01
public import ErdosOverlap.Gram.RawPhasePhysical
public import ErdosOverlap.Certificate.Native6KernelData

/-!
# Physical signed-functional theorem for native phase row 1

Generated by `scripts/generate_gram_sos.py`.  Splitting exact decisions across
small, sequentially imported modules bounds the kernel's temporary memory.
-/

@[expose] public section

namespace ErdosOverlap.Gram.Native6Phase01

open scoped BigOperators
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
set_option Elab.async false

def certificate : RawPhaseCertificate 59 where
  denominator := Native6Raw01.denominator
  diagonal := Native6Raw01.diagonal
  gamma := Native6Raw01.gamma
  nonnegative := Native6Raw01.nonnegative
  eta := Native6Raw01.eta
  triangles := Native6Raw01.triangles
  triangleTable := Native6Raw01.triangleTable
  cells_pos := by decide +kernel
  denominator_pos := Native6Raw01.denominator_pos
  diagonal_nonnegative := fun i => (Native6Raw01.nonnegative_multipliers i).1
  auxiliary_nonnegative := fun i => (Native6Raw01.nonnegative_multipliers i).2
  eta_nonnegative := Native6Raw01.eta_nonnegative
  triangles_valid := Native6Raw01.triangles_valid
  triangle_aggregation := Native6Raw01.triangle_aggregation
  full_nonnegative := by
    intro y hy
    simpa only [Native6Raw01.fullMatrix, Native6Raw01.fullInteger, Native6Raw01.scale_exact, Nat.cast_ofNat] using
      Native6Raw01.nonnegative_on_sum_zero y hy

theorem cells_exact : Native6Data.phase01.cells = 59 := rfl

theorem gamma_exact : certificate.gammaRational = Native6Data.phase01.gamma := by
  decide +kernel

theorem lower_exact : certificate.lowerRational = Native6Data.phase01.lowerAtZero := by
  change phaseLowerRational 59 Native6Raw01.denominator Native6Raw01.diagonal Native6Raw01.gamma
    Native6Raw01.nonnegative Native6Raw01.eta Native6Raw01.triangles = _
  rw [Native6Raw01.lower_exact]
  decide +kernel

theorem mean_exact : certificate.meanCoefficient = Native6Data.phase01.meanCoefficient := by
  decide +kernel

/-- Unconditional physical validity of the exact native phase row. -/
theorem functional_lower_bound {h : ℝ → ℝ} (hh : Admissible h) :
    (Native6Data.phase01.lowerAtZero : ℝ) + (Native6Data.phase01.meanCoefficient : ℝ) *
        profileMean (overlapProfile h)^2 ≤
      quartetFunctional h (phaseKernel Native6Data.phase01.cells Native6Data.phase01.gamma) := by
  have hbound := certificate.kernel_functional_lower_bound hh
  rw [gamma_exact, lower_exact, mean_exact] at hbound
  rw [cells_exact]
  exact hbound

end ErdosOverlap.Gram.Native6Phase01
