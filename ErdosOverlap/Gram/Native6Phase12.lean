/-!
# Physical signed-functional theorem for native phase row 12

Generated by `scripts/generate_gram_sos.py`.  Splitting exact decisions across
small, sequentially imported modules bounds the kernel's temporary memory.
-/

@[expose] public section

namespace ErdosOverlap.Gram.Native6Phase12

open scoped BigOperators
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
set_option Elab.async false

def certificate : RawPhaseCertificate 83 where
  denominator := Native6Raw12.denominator
  diagonal := Native6Raw12.diagonal
  gamma := Native6Raw12.gamma
  nonnegative := Native6Raw12.nonnegative
  eta := Native6Raw12.eta
  triangles := Native6Raw12.triangles
  triangleTable := Native6Raw12.triangleTable
  cells_pos := by decide +kernel
  denominator_pos := Native6Raw12.denominator_pos
  diagonal_nonnegative := fun i => (Native6Raw12.nonnegative_multipliers i).1
  auxiliary_nonnegative := fun i => (Native6Raw12.nonnegative_multipliers i).2
  eta_nonnegative := Native6Raw12.eta_nonnegative
  triangles_valid := Native6Raw12.triangles_valid
  triangle_aggregation := Native6Raw12.triangle_aggregation
  full_nonnegative := by
    intro y hy
    simpa only [Native6Raw12.fullMatrix, Native6Raw12.fullInteger, Native6Raw12.scale_exact, Nat.cast_ofNat] using
      Native6Raw12.nonnegative_on_sum_zero y hy

theorem cells_exact : Native6Data.phase12.cells = 83 := rfl

theorem gamma_exact : certificate.gammaRational = Native6Data.phase12.gamma := by
  decide +kernel

theorem lower_exact : certificate.lowerRational = Native6Data.phase12.lowerAtZero := by
  change phaseLowerRational 83 Native6Raw12.denominator Native6Raw12.diagonal Native6Raw12.gamma
    Native6Raw12.nonnegative Native6Raw12.eta Native6Raw12.triangles = _
  rw [Native6Raw12.lower_exact]
  decide +kernel

theorem mean_exact : certificate.meanCoefficient = Native6Data.phase12.meanCoefficient := by
  decide +kernel

/-- Unconditional physical validity of the exact native phase row. -/
theorem functional_lower_bound {h : ℝ → ℝ} (hh : Admissible h) :
    (Native6Data.phase12.lowerAtZero : ℝ) + (Native6Data.phase12.meanCoefficient : ℝ) *
        profileMean (overlapProfile h)^2 ≤
      quartetFunctional h (phaseKernel Native6Data.phase12.cells Native6Data.phase12.gamma) := by
  have hbound := certificate.kernel_functional_lower_bound hh
  rw [gamma_exact, lower_exact, mean_exact] at hbound
  rw [cells_exact]
  exact hbound

end ErdosOverlap.Gram.Native6Phase12
