def certificate : RawPhaseCertificate 43 where
  denominator := Native6Raw19.denominator
  diagonal := Native6Raw19.diagonal
  gamma := Native6Raw19.gamma
  nonnegative := Native6Raw19.nonnegative
  eta := Native6Raw19.eta
