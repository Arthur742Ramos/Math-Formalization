/-- Unconditional physical validity of the exact native phase row. -/
theorem functional_lower_bound {h : ℝ → ℝ} (hh : Admissible h) :
    (Native6Data.phase19.lowerAtZero : ℝ) + (Native6Data.phase19.meanCoefficient : ℝ) *
        profileMean (overlapProfile h)^2 ≤
      quartetFunctional h (phaseKernel Native6Data.phase19.cells Native6Data.phase19.gamma) := by
  have hbound := certificate.kernel_functional_lower_bound hh
  rw [gamma_exact, lower_exact, mean_exact] at hbound
  rw [cells_exact]
  exact hbound

