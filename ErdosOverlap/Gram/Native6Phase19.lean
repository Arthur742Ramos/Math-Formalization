theorem cells_exact : Native6Data.phase19.cells = 43 := rfl

theorem gamma_exact : certificate.gammaRational = Native6Data.phase19.gamma := by
  decide +kernel

theorem lower_exact : certificate.lowerRational = Native6Data.phase19.lowerAtZero := by
  change phaseLowerRational 43 Native6Raw19.denominator Native6Raw19.diagonal Native6Raw19.gamma
    Native6Raw19.nonnegative Native6Raw19.eta Native6Raw19.triangles = _
  rw [Native6Raw19.lower_exact]
