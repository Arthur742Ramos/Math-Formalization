open scoped BigOperators
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
set_option Elab.async false

def certificate : RawPhaseCertificate 61 where
  denominator := Native6Raw20.denominator
  diagonal := Native6Raw20.diagonal
  gamma := Native6Raw20.gamma
  nonnegative := Native6Raw20.nonnegative
  eta := Native6Raw20.eta
  triangles := Native6Raw20.triangles
  triangleTable := Native6Raw20.triangleTable
  cells_pos := by decide +kernel
  denominator_pos := Native6Raw20.denominator_pos
  diagonal_nonnegative := fun i => (Native6Raw20.nonnegative_multipliers i).1
  auxiliary_nonnegative := fun i => (Native6Raw20.nonnegative_multipliers i).2
  eta_nonnegative := Native6Raw20.eta_nonnegative
  triangles_valid := Native6Raw20.triangles_valid
  triangle_aggregation := Native6Raw20.triangle_aggregation
  full_nonnegative := by
    intro y hy
    simpa only [Native6Raw20.fullMatrix, Native6Raw20.fullInteger, Native6Raw20.scale_exact, Nat.cast_ofNat] using
      Native6Raw20.nonnegative_on_sum_zero y hy

theorem cells_exact : Native6Data.phase20.cells = 61 := rfl

theorem gamma_exact : certificate.gammaRational = Native6Data.phase20.gamma := by
  decide +kernel

theorem lower_exact : certificate.lowerRational = Native6Data.phase20.lowerAtZero := by
  change phaseLowerRational 61 Native6Raw20.denominator Native6Raw20.diagonal Native6Raw20.gamma
    Native6Raw20.nonnegative Native6Raw20.eta Native6Raw20.triangles = _
  rw [Native6Raw20.lower_exact]
  decide +kernel

theorem mean_exact : certificate.meanCoefficient = Native6Data.phase20.meanCoefficient := by
  decide +kernel

/-- Unconditional physical validity of the exact native phase row. -/
theorem functional_lower_bound {h : ℝ → ℝ} (hh : Admissible h) :
    (Native6Data.phase20.lowerAtZero : ℝ) + (Native6Data.phase20.meanCoefficient : ℝ) *
        profileMean (overlapProfile h)^2 ≤
      quartetFunctional h (phaseKernel Native6Data.phase20.cells Native6Data.phase20.gamma) := by
  have hbound := certificate.kernel_functional_lower_bound hh
  rw [gamma_exact, lower_exact, mean_exact] at hbound
  rw [cells_exact]
  exact hbound

