          "declaration": "ComputationalHodge.PresentationHomology.boundary_word",
          "original_declaration": "theorem boundary_word {S : GeometricStepSystem A E} {a b : A} (p : GeometricTrace S a b) :\n    boundary\u2081 S (wordChain p) = Finsupp.single b 1 - Finsupp.single a 1 := by\n  induction p with\n  | refl a => simp [wordChain]\n  | single e => exact (EuclideanSpace.basisFun E \u211d).toBasis.constr_basis \u211d _ e\n  | trans p q hp hq => simp only [wordChain, map_add, hp, hq]; abel\n  | symm p hp => simp only [wordChain, map_neg, hp]; abel\n\n",
          "adapted_declaration": "theorem boundary_word {S : GeometricStepSystem A E} {a b : A} (p : GeometricTrace S a b) :\n    boundary\u2081 S (wordChain p) = Finsupp.single b 1 - Finsupp.single a 1 := by\n  induction p with\n  | refl a => exact (map_zero _).trans (sub_self (Finsupp.single a 1)).symm\n  | single e => exact (EuclideanSpace.basisFun E \u211d).toBasis.constr_basis \u211d _ e\n  | trans p q hp hq =>\n    exact (map_add _ _ _).trans ((congrArg\u2082 (\u00b7 + \u00b7) hp hq).trans\n      ((add_comm _ _).trans (sub_add_sub_cancel _ _ _)))\n  | symm p hp =>\n    exact (map_neg _ _).trans ((congrArg Neg.neg hp).trans (neg_sub _ _))\n\n",
          "original_sha256": "e90231954742f7cbfd6222bd221eea5e182944bcab9cc85dbfa88f14f7e67526",
