namespace ComputationalPaths.Path.GeometricTopology
open scoped ContinuousMap Topology
universe u v

structure GeometricStepSystem (A : Type u) [TopologicalSpace A] (Step : Type v) where
  src : Step → A
  tgt : Step → A
  realize : (s : Step) → _root_.Path (src s) (tgt s)

/-- A finite trace of endpoint-changing geometric computations. -/
inductive GeometricTrace {A : Type u} [TopologicalSpace A] {Step : Type v}
    (S : GeometricStepSystem A Step) : A → A → Type (max u v) where
  | refl (a : A) : GeometricTrace S a a
  | single (s : Step) : GeometricTrace S (S.src s) (S.tgt s)
  | trans {a b c : A} :
      GeometricTrace S a b → GeometricTrace S b c → GeometricTrace S a c
  | symm {a b : A} : GeometricTrace S a b → GeometricTrace S b a

namespace GeometricTrace

variable {A : Type u} [TopologicalSpace A] {Step : Type v}
  {S : GeometricStepSystem A Step}

/-- The continuous path obtained by executing a geometric trace. -/
noncomputable def realize {a b : A} : GeometricTrace S a b → _root_.Path a b
  | .refl a => _root_.Path.refl a
  | .single s => S.realize s
  | .trans p q => _root_.Path.trans (realize p) (realize q)
  | .symm p => _root_.Path.symm (realize p)

end GeometricTrace

structure ContinuousGeometricStepSystem (A : Type u) [TopologicalSpace A]
    (Step : Type v) [TopologicalSpace Step]
    extends GeometricStepSystem A Step where
  continuous_src : Continuous src
  continuous_tgt : Continuous tgt
  continuous_realize :
    Continuous (fun s => (realize s).toContinuousMap)

structure ScopedGeometricRewritePresentation
    {A : Type u} [TopologicalSpace A]
    {Step : Type v} [TopologicalSpace Step]
    (S : ContinuousGeometricStepSystem A Step) where
  rule : ∀ {a b : A},
    GeometricTrace S.toGeometricStepSystem a b →
      GeometricTrace S.toGeometricStepSystem a b → Prop
  sound_rule : ∀ {a b : A}
    {p q : GeometricTrace S.toGeometricStepSystem a b},
    rule p q →
      _root_.Path.Homotopic
        (GeometricTrace.realize p) (GeometricTrace.realize q)

/-! ## Scoped closure -/

/-- The equivalence congruence generated by the named presentation rules and
the strict groupoid coherence laws of geometric traces. -/
inductive ScopedRwEq
    {A : Type u} [TopologicalSpace A]
    {Step : Type v} [TopologicalSpace Step]
    {S : ContinuousGeometricStepSystem A Step}
    (P : ScopedGeometricRewritePresentation S) :
    {a b : A} →
      GeometricTrace S.toGeometricStepSystem a b →
        GeometricTrace S.toGeometricStepSystem a b → Prop
  | refl {a b : A}
      (p : GeometricTrace S.toGeometricStepSystem a b) :
      ScopedRwEq P p p
  | generator {a b : A}
      {p q : GeometricTrace S.toGeometricStepSystem a b} :
      P.rule p q → ScopedRwEq P p q
  | symm {a b : A}
      {p q : GeometricTrace S.toGeometricStepSystem a b} :
      ScopedRwEq P p q → ScopedRwEq P q p
  | trans {a b : A}
      {p q r : GeometricTrace S.toGeometricStepSystem a b} :
      ScopedRwEq P p q → ScopedRwEq P q r → ScopedRwEq P p r
  | trans_congr {a b c : A}
      {p p' : GeometricTrace S.toGeometricStepSystem a b}
      {q q' : GeometricTrace S.toGeometricStepSystem b c} :
      ScopedRwEq P p p' → ScopedRwEq P q q' →
        ScopedRwEq P
          (GeometricTrace.trans p q) (GeometricTrace.trans p' q')
  | symm_congr {a b : A}
      {p q : GeometricTrace S.toGeometricStepSystem a b} :
      ScopedRwEq P p q →
        ScopedRwEq P (GeometricTrace.symm p) (GeometricTrace.symm q)
  | refl_trans {a b : A}
      (p : GeometricTrace S.toGeometricStepSystem a b) :
      ScopedRwEq P
        (GeometricTrace.trans (GeometricTrace.refl a) p) p
  | trans_refl {a b : A}
      (p : GeometricTrace S.toGeometricStepSystem a b) :
      ScopedRwEq P
        (GeometricTrace.trans p (GeometricTrace.refl b)) p
  | trans_assoc {a b c d : A}
      (p : GeometricTrace S.toGeometricStepSystem a b)
      (q : GeometricTrace S.toGeometricStepSystem b c)
      (r : GeometricTrace S.toGeometricStepSystem c d) :
      ScopedRwEq P
        (GeometricTrace.trans (GeometricTrace.trans p q) r)
        (GeometricTrace.trans p (GeometricTrace.trans q r))
  | symm_trans {a b : A}
      (p : GeometricTrace S.toGeometricStepSystem a b) :
      ScopedRwEq P
        (GeometricTrace.trans (GeometricTrace.symm p) p)
        (GeometricTrace.refl b)
  | trans_symm {a b : A}
      (p : GeometricTrace S.toGeometricStepSystem a b) :
      ScopedRwEq P
        (GeometricTrace.trans p (GeometricTrace.symm p))
        (GeometricTrace.refl a)
  | symm_symm {a b : A}
      (p : GeometricTrace S.toGeometricStepSystem a b) :
      ScopedRwEq P
        (GeometricTrace.symm (GeometricTrace.symm p)) p
  | symm_refl (a : A) :
      ScopedRwEq P
        (GeometricTrace.symm (GeometricTrace.refl a))
        (GeometricTrace.refl a)
  | symm_comp {a b c : A}
      (p : GeometricTrace S.toGeometricStepSystem a b)
      (q : GeometricTrace S.toGeometricStepSystem b c) :
      ScopedRwEq P
        (GeometricTrace.symm (GeometricTrace.trans p q))
        (GeometricTrace.trans (GeometricTrace.symm q)
          (GeometricTrace.symm p))

end ComputationalPaths.Path.GeometricTopology

namespace ComputationalHodge
open ComputationalPaths.Path.GeometricTopology

universe u v
variable {A : Type u} [TopologicalSpace A] {E : Type v} [Fintype E]

abbrev Cochain (E : Type v) [Fintype E] := EuclideanSpace ℝ E

def evaluation (e : E) : Cochain E →ₗ[ℝ] ℝ where
  toFun ω := ω e
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The actual signed integral of edge coefficients along a computational trace. -/
def period {S : GeometricStepSystem A E} {a b : A} :
    GeometricTrace S a b → Cochain E →ₗ[ℝ] ℝ
  | .refl _ => 0
  | .single e => evaluation e
  | .trans p q => period p + period q
  | .symm p => -period p

/-- The degree-zero coboundary, with actual source and target evaluations. -/
def d0 (S : GeometricStepSystem A E) : (A → ℝ) →ₗ[ℝ] Cochain E where
  toFun f := WithLp.toLp 2 (fun e => f (S.tgt e) - f (S.src e))
  map_add' f g := by
    ext e
    change (f (S.tgt e) + g (S.tgt e)) - (f (S.src e) + g (S.src e)) = _
    change _ = (f (S.tgt e) - f (S.src e)) + (g (S.tgt e) - g (S.src e))
    ring
  map_smul' r f := by
    ext e
    change r * f (S.tgt e) - r * f (S.src e) = r * (f (S.tgt e) - f (S.src e))
    ring

theorem period_d0 {S : GeometricStepSystem A E} (f : A → ℝ)
    {a b : A} (p : GeometricTrace S a b) : period p (d0 S f) = f b - f a := by
  induction p with
  | refl a => simp [period]
  | single e => rfl
  | trans p q hp hq =>
    change period p (d0 S f) + period q (d0 S f) = _
    rw [hp, hq]
    ring
  | symm p hp =>
    change -period p (d0 S f) = _
    rw [hp]
    ring

variable [TopologicalSpace E] {S : ContinuousGeometricStepSystem A E}

/-- All named rules, including their endpoints: no unlisted-rule assumption. -/
structure Cell (P : ScopedGeometricRewritePresentation S) where
  src : A
  tgt : A
  left : GeometricTrace S.toGeometricStepSystem src tgt
  right : GeometricTrace S.toGeometricStepSystem src tgt
  rule : P.rule left right

/-- The next coboundary evaluates every named relation's actual period difference. -/
def d1 (P : ScopedGeometricRewritePresentation S) : Cochain E →ₗ[ℝ] (Cell P → ℝ) :=
  LinearMap.pi fun c => period c.left - period c.right

def Closed (P : ScopedGeometricRewritePresentation S) : Submodule ℝ (Cochain E) :=
  LinearMap.ker (d1 P)

def Exact (S : ContinuousGeometricStepSystem A E) : Submodule ℝ (Cochain E) :=
  LinearMap.range (d0 S.toGeometricStepSystem)

theorem d1_d0 (P : ScopedGeometricRewritePresentation S) (f : A → ℝ) :
    d1 P (d0 S.toGeometricStepSystem f) = 0 := by
  funext c
  change period c.left (d0 S.toGeometricStepSystem f) -
    period c.right (d0 S.toGeometricStepSystem f) = 0
  rw [period_d0, period_d0, sub_self]

theorem exact_le_closed (P : ScopedGeometricRewritePresentation S) : Exact S ≤ Closed P := by
  rintro _ ⟨f, rfl⟩
  exact d1_d0 P f

theorem closed_rule (P : ScopedGeometricRewritePresentation S) (ω : Closed P)
    {a b : A} {p q : GeometricTrace S.toGeometricStepSystem a b} (h : P.rule p q) :
    period p ω = period q ω := by
  have h' := congrFun ω.property (Cell.mk a b p q h)
  exact sub_eq_zero.mp h'

/-- Closedness propagates through the full upstream scoped rewrite derivation. -/
theorem period_rewrite (P : ScopedGeometricRewritePresentation S) (ω : Closed P)
    {a b : A} {p q : GeometricTrace S.toGeometricStepSystem a b}
    (h : ScopedRwEq P p q) : period p ω = period q ω := by
  induction h with
  | refl _ => rfl
  | generator h => exact closed_rule P ω h
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | trans_congr _ _ ih₁ ih₂ => exact congrArg₂ (· + ·) ih₁ ih₂
  | symm_congr _ ih => exact congrArg Neg.neg ih
  | refl_trans p => exact zero_add _
  | trans_refl p => exact add_zero _
  | trans_assoc p q r => exact add_assoc _ _ _
  | symm_trans p => exact neg_add_cancel _
  | trans_symm p => exact add_neg_cancel _
  | symm_symm p => exact neg_neg _
  | symm_refl a => exact neg_zero
  | symm_comp p q =>
    change -(period p ω + period q ω) = -period q ω + -period p ω
    ring

theorem closed_iff_rewrite_invariant (P : ScopedGeometricRewritePresentation S) (ω : Cochain E) :
    ω ∈ Closed P ↔ ∀ {a b : A} (p q : GeometricTrace S.toGeometricStepSystem a b),
      ScopedRwEq P p q → period p ω = period q ω := by
  constructor
  · intro h _ _ p q hpq
    exact period_rewrite P ⟨ω, h⟩ hpq
  · intro h
    funext c
    exact sub_eq_zero.mpr (h c.left c.right (.generator c.rule))

def pathSetoid (P : ScopedGeometricRewritePresentation S) (a b : A) :
    Setoid (GeometricTrace S.toGeometricStepSystem a b) where
  r := ScopedRwEq P
  iseqv := ⟨ScopedRwEq.refl, ScopedRwEq.symm, ScopedRwEq.trans⟩

abbrev PathClass (P : ScopedGeometricRewritePresentation S) (a b : A) :=
  Quotient (pathSetoid P a b)

def quotientPeriod (P : ScopedGeometricRewritePresentation S) (ω : Closed P) {a b : A} :
    PathClass P a b → ℝ :=
  Quotient.lift (fun p => period p ω) (fun _ _ h => period_rewrite P ω h)

def compose (P : ScopedGeometricRewritePresentation S) {a b c : A}
    (p : PathClass P a b) (q : PathClass P b c) : PathClass P a c :=
  Quotient.liftOn₂ p q (fun p q => Quotient.mk _ (.trans p q))
    (fun _ _ _ _ hp hq => Quotient.sound (.trans_congr hp hq))

theorem quotientPeriod_compose (P : ScopedGeometricRewritePresentation S) (ω : Closed P)
    {a b c : A} (p : PathClass P a b) (q : PathClass P b c) :
    quotientPeriod P ω (compose P p q) = quotientPeriod P ω p + quotientPeriod P ω q := by
  induction p using Quotient.inductionOn with | _ p =>
  induction q using Quotient.inductionOn with | _ q =>
  rfl

end ComputationalHodge

namespace ComputationalHodge
open ComputationalPaths.Path.GeometricTopology
open scoped InnerProductSpace
universe u v
variable {A : Type u} [TopologicalSpace A] {E : Type v} [Fintype E] [TopologicalSpace E]
  {S : ContinuousGeometricStepSystem A E}

noncomputable def Harmonic (P : ScopedGeometricRewritePresentation S) : Submodule ℝ (Cochain E) :=
  Closed P ⊓ (Exact S)ᗮ

/-- Boundaries as a subspace of cycles, rather than an ill-typed ambient quotient. -/
def Boundaries (P : ScopedGeometricRewritePresentation S) : Submodule ℝ (Closed P) :=
  (Exact S).comap (Closed P).subtype

abbrev H1 (P : ScopedGeometricRewritePresentation S) := Closed P ⧸ Boundaries P

/-- Constructed by actual finite-dimensional orthogonal projection, with no
Hodge decomposition or representative existence supplied as a hypothesis. -/
noncomputable def harmonicProjection (P : ScopedGeometricRewritePresentation S) :
    Closed P →ₗ[ℝ] Harmonic P where
  toFun ω := ⟨(ω : Cochain E) - (Exact S).starProjection ω,
    (Closed P).sub_mem ω.property (exact_le_closed P <| (Exact S).starProjection_apply_mem _),
    (Exact S).sub_starProjection_mem_orthogonal _⟩
  map_add' ω η := by
    apply Subtype.ext
    change ((ω : Cochain E) + η) - (Exact S).starProjection (ω + η) = _
    rw [map_add]
    change _ = ((ω : Cochain E) - (Exact S).starProjection ω) +
      ((η : Cochain E) - (Exact S).starProjection η)
    abel
  map_smul' r ω := by
    apply Subtype.ext
    change r • (ω : Cochain E) - (Exact S).starProjection (r • (ω : Cochain E)) = _
    rw [map_smul]
    exact (smul_sub r (ω : Cochain E) ((Exact S).starProjection ω)).symm

theorem harmonicProjection_difference (P : ScopedGeometricRewritePresentation S) (ω : Closed P) :
    (ω : Cochain E) - (harmonicProjection P ω : Cochain E) ∈ Exact S := by
  change (ω : Cochain E) - ((ω : Cochain E) - (Exact S).starProjection ω) ∈ Exact S
  simpa only [sub_sub_cancel] using (Exact S).starProjection_apply_mem (ω : Cochain E)

theorem harmonic_exact_zero (P : ScopedGeometricRewritePresentation S) {ω : Cochain E}
    (hω : ω ∈ Harmonic P) (he : ω ∈ Exact S) : ω = 0 := by
  have h : ω ∈ Exact S ⊓ (Exact S)ᗮ := ⟨he, hω.2⟩
  simpa only [Submodule.inf_orthogonal_eq_bot, Submodule.mem_bot] using h

theorem unique_harmonic_representative (P : ScopedGeometricRewritePresentation S) (ω : Closed P) :
    ∃! h : Harmonic P, (ω : Cochain E) - (h : Cochain E) ∈ Exact S := by
  refine ⟨harmonicProjection P ω, harmonicProjection_difference P ω, ?_⟩
  intro h hh
  have he : (h : Cochain E) - (harmonicProjection P ω : Cochain E) ∈ Exact S := by
    have := (Exact S).sub_mem (harmonicProjection_difference P ω) hh
    convert this using 1
    abel
  have hz := harmonic_exact_zero P
    ((Harmonic P).sub_mem h.property (harmonicProjection P ω).property) he
  exact Subtype.ext (sub_eq_zero.mp hz)

theorem harmonicProjection_eq_zero_iff (P : ScopedGeometricRewritePresentation S) (ω : Closed P) :
    harmonicProjection P ω = 0 ↔ (ω : Cochain E) ∈ Exact S := by
  constructor
  · intro h
    have := harmonicProjection_difference P ω
    simpa only [h, ZeroMemClass.coe_zero, sub_zero] using this
  · intro h
    apply Subtype.ext
    change (ω : Cochain E) - (Exact S).starProjection ω = 0
    rw [Submodule.starProjection_eq_self_iff.mpr h, sub_self]

theorem harmonicProjection_self (P : ScopedGeometricRewritePresentation S) (h : Harmonic P) :
    harmonicProjection P ⟨h, h.property.1⟩ = h := by
  apply Subtype.ext
  change (h : Cochain E) - (Exact S).starProjection h = h
  rw [Submodule.starProjection_apply,
    Submodule.orthogonalProjectionOnto_eq_zero_iff.mpr h.property.2]
  simp

theorem harmonicProjection_surjective (P : ScopedGeometricRewritePresentation S) :
    Function.Surjective (harmonicProjection P) :=
  fun h => ⟨⟨h, h.property.1⟩, harmonicProjection_self P h⟩

theorem harmonicProjection_kernel (P : ScopedGeometricRewritePresentation S) :
    LinearMap.ker (harmonicProjection P) = Boundaries P := by
  ext ω
  exact harmonicProjection_eq_zero_iff P ω

/-- The actual first presentation cohomology is linearly equivalent to harmonic cochains. -/
noncomputable def hodgeEquiv (P : ScopedGeometricRewritePresentation S) : H1 P ≃ₗ[ℝ] Harmonic P :=
  (Submodule.quotEquivOfEq (Boundaries P) (LinearMap.ker (harmonicProjection P))
    (harmonicProjection_kernel P).symm).trans
    ((harmonicProjection P).quotKerEquivOfSurjective (harmonicProjection_surjective P))

theorem hodgeEquiv_mk (P : ScopedGeometricRewritePresentation S) (ω : Closed P) :
    hodgeEquiv P ((Boundaries P).mkQ ω) = harmonicProjection P ω := rfl

theorem harmonicProjection_preserves_loop_period (P : ScopedGeometricRewritePresentation S)
    (ω : Closed P) {a : A} (p : GeometricTrace S.toGeometricStepSystem a a) :
    period p (harmonicProjection P ω : Cochain E) = period p ω := by
  rcases harmonicProjection_difference P ω with ⟨f, hf⟩
  have h := period_d0 f p
  rw [hf, map_sub, sub_self] at h
  exact (sub_eq_zero.mp h).symm

theorem hodgeEquiv_preserves_periods (P : ScopedGeometricRewritePresentation S) {a : A}
    (p : GeometricTrace S.toGeometricStepSystem a a) (ω : Closed P) :
    period p (hodgeEquiv P ((Boundaries P).mkQ ω) : Cochain E) = period p ω :=
  harmonicProjection_preserves_loop_period P ω p

/-- Loop periods descend through the cochain quotient because exact periods telescope. -/
def cohomologyPeriod (P : ScopedGeometricRewritePresentation S) {a : A}
    (p : GeometricTrace S.toGeometricStepSystem a a) : H1 P →ₗ[ℝ] ℝ :=
  (Boundaries P).liftQ ((period p).comp (Closed P).subtype) (by
    rintro ω ⟨f, hf⟩
    change d0 S.toGeometricStepSystem f = (ω : Cochain E) at hf
    change period p (ω : Cochain E) = 0
    rw [← hf, period_d0, sub_self])

theorem cohomologyPeriod_mk (P : ScopedGeometricRewritePresentation S) {a : A}
    (p : GeometricTrace S.toGeometricStepSystem a a) (ω : Closed P) :
    cohomologyPeriod P p ((Boundaries P).mkQ ω) = period p ω := rfl

/-- A period pairing with both the actual scoped path quotient and actual H1. -/
def periodPairing (P : ScopedGeometricRewritePresentation S) (a : A) :
    PathClass P a a → H1 P →ₗ[ℝ] ℝ :=
  Quotient.lift (cohomologyPeriod P) (by
    intro p q hpq
    apply LinearMap.ext
    intro c
    induction c using Submodule.Quotient.induction_on with
    | _ ω => exact period_rewrite P ω hpq)

theorem periodPairing_compose (P : ScopedGeometricRewritePresentation S) {a : A}
    (p q : PathClass P a a) (c : H1 P) :
    periodPairing P a (compose P p q) c = periodPairing P a p c + periodPairing P a q c := by
  induction p using Quotient.inductionOn with | _ p =>
  induction q using Quotient.inductionOn with | _ q =>
  induction c using Submodule.Quotient.induction_on with | _ ω =>
  rfl

end ComputationalHodge

namespace ComputationalHodge
open ComputationalPaths.Path.GeometricTopology
universe u v
variable {A : Type u} [TopologicalSpace A] {E : Type v} [Fintype E]

def componentSetoid (S : GeometricStepSystem A E) : Setoid A where
  r a b := Nonempty (GeometricTrace S a b)
  iseqv := ⟨fun a => ⟨.refl a⟩,
    fun ⟨p⟩ => ⟨.symm p⟩, fun ⟨p⟩ ⟨q⟩ => ⟨.trans p q⟩⟩

noncomputable def componentRoot (S : GeometricStepSystem A E) (a : A) : A :=
  Quotient.out (Quotient.mk (componentSetoid S) a)

noncomputable def rootTrace (S : GeometricStepSystem A E) (a : A) :
    GeometricTrace S (componentRoot S a) a :=
  Classical.choice (Quotient.exact (Quotient.out_eq (Quotient.mk (componentSetoid S) a)))

/-- A componentwise potential is constructed from actual trace integrals. -/
noncomputable def potential (S : GeometricStepSystem A E) (ω : Cochain E) (a : A) : ℝ :=
  period (rootTrace S a) ω

theorem period_cast_source {S : GeometricStepSystem A E} {a a' b : A}
    (h : a = a') (p : GeometricTrace S a' b) (ω : Cochain E) :
    period (h.symm ▸ p) ω = period p ω := by
  cases h
  rfl

theorem potential_d0_of_zero_periods (S : GeometricStepSystem A E) (ω : Cochain E)
    (hz : ∀ (a : A) (p : GeometricTrace S a a), period p ω = 0) :
    d0 S (potential S ω) = ω := by
  ext e
  have hr : componentRoot S (S.src e) = componentRoot S (S.tgt e) :=
    congrArg Quotient.out (Quotient.sound (⟨GeometricTrace.single e⟩ :
      Nonempty (GeometricTrace S (S.src e) (S.tgt e))))
  let q : GeometricTrace S (componentRoot S (S.src e)) (S.tgt e) :=
    hr.symm ▸ rootTrace S (S.tgt e)
  have hq : period q ω = period (rootTrace S (S.tgt e)) ω := by
    exact period_cast_source hr (rootTrace S (S.tgt e)) ω
  have h := hz (componentRoot S (S.src e))
    (.trans (.trans (rootTrace S (S.src e)) (.single e)) (.symm q))
  change (period (rootTrace S (S.src e)) ω + ω e) - period q ω = 0 at h
  rw [hq] at h
  change potential S ω (S.tgt e) - potential S ω (S.src e) = ω e
  dsimp [potential]
  linarith

variable [TopologicalSpace E] {S : ContinuousGeometricStepSystem A E}

/-- All loop periods vanish exactly for actual coboundaries. No connectivity
or ambient geometric-completeness hypothesis is inserted. -/
theorem exact_iff_zero_loop_periods (ω : Cochain E) :
    ω ∈ Exact S ↔ ∀ (a : A) (p : GeometricTrace S.toGeometricStepSystem a a), period p ω = 0 := by
  constructor
  · rintro ⟨f, rfl⟩ a p
    rw [period_d0, sub_self]
  · intro hz
    exact ⟨potential S.toGeometricStepSystem ω,
      potential_d0_of_zero_periods S.toGeometricStepSystem ω hz⟩

theorem harmonic_determined_by_periods (P : ScopedGeometricRewritePresentation S)
    (h k : Harmonic P)
    (hperiod : ∀ (a : A) (p : GeometricTrace S.toGeometricStepSystem a a), period p h = period p k) :
    h = k := by
  have he : (h : Cochain E) - (k : Cochain E) ∈ Exact S := by
    apply (exact_iff_zero_loop_periods _).mpr
    intro a p
    rw [map_sub, hperiod, sub_self]
  have hz := harmonic_exact_zero P ((Harmonic P).sub_mem h.property k.property) he
  exact Subtype.ext (sub_eq_zero.mp hz)

theorem periodPairing_separates (P : ScopedGeometricRewritePresentation S) (c d : H1 P)
    (hp : ∀ (a : A) (p : PathClass P a a), periodPairing P a p c = periodPairing P a p d) :
    c = d := by
  induction c using Submodule.Quotient.induction_on with | _ ω =>
  induction d using Submodule.Quotient.induction_on with | _ η =>
  have he : (ω : Cochain E) - (η : Cochain E) ∈ Exact S := by
    apply (exact_iff_zero_loop_periods _).mpr
    intro a p
    rw [map_sub]
    exact sub_eq_zero.mpr (hp a (Quotient.mk _ p))
  exact (Submodule.Quotient.eq (Boundaries P)).mpr he

end ComputationalHodge

namespace ComputationalHodge.PresentationHomology
open ComputationalPaths.Path.GeometricTopology
open scoped InnerProductSpace
universe u v
variable {A : Type u} [TopologicalSpace A] {E : Type v} [Fintype E]

noncomputable def wordChain {S : GeometricStepSystem A E} {a b : A} :
    GeometricTrace S a b → Cochain E
  | .refl _ => 0
  | .single e => EuclideanSpace.basisFun E ℝ e
  | .trans p q => wordChain p + wordChain q
  | .symm p => -wordChain p

theorem wordChain_period {S : GeometricStepSystem A E} {a b : A}
    (p : GeometricTrace S a b) (ω : Cochain E) : inner ℝ (wordChain p) ω = period p ω := by
  induction p with
  | refl a => simp [wordChain, period]
  | single e => exact EuclideanSpace.basisFun_inner E ℝ ω e
  | trans p q hp hq => simp [wordChain, period, inner_add_left, hp, hq]
  | symm p hp => simp [wordChain, period, hp]

noncomputable def boundary₁ (S : GeometricStepSystem A E) : Cochain E →ₗ[ℝ] (A →₀ ℝ) :=
  (EuclideanSpace.basisFun E ℝ).toBasis.constr ℝ
    (fun e => Finsupp.single (S.tgt e) 1 - Finsupp.single (S.src e) 1)

theorem boundary_word {S : GeometricStepSystem A E} {a b : A} (p : GeometricTrace S a b) :
    boundary₁ S (wordChain p) = Finsupp.single b 1 - Finsupp.single a 1 := by
  induction p with
  | refl a => simp [wordChain]
  | single e => exact (EuclideanSpace.basisFun E ℝ).toBasis.constr_basis ℝ _ e
  | trans p q hp hq => simp only [wordChain, map_add, hp, hq]; abel
  | symm p hp => simp only [wordChain, map_neg, hp]; abel

noncomputable def vertexEval (f : A → ℝ) : (A →₀ ℝ) →ₗ[ℝ] ℝ :=
  Finsupp.linearCombination ℝ f

theorem boundary_pair (S : GeometricStepSystem A E) (f : A → ℝ) (z : Cochain E) :
    vertexEval f (boundary₁ S z) = inner ℝ (d0 S f) z := by
  have h : (vertexEval f).comp (boundary₁ S) = (innerSL ℝ (d0 S f)).toLinearMap := by
    apply (EuclideanSpace.basisFun E ℝ).toBasis.ext
    intro e
    change vertexEval f (boundary₁ S ((EuclideanSpace.basisFun E ℝ) e)) =
      inner ℝ (d0 S f) ((EuclideanSpace.basisFun E ℝ) e)
    rw [EuclideanSpace.inner_basisFun_real,
      show boundary₁ S ((EuclideanSpace.basisFun E ℝ) e) = _ from
        (EuclideanSpace.basisFun E ℝ).toBasis.constr_basis ℝ _ e]
    simp [vertexEval, d0]
  exact LinearMap.congr_fun h z

noncomputable def Cycles (S : GeometricStepSystem A E) : Submodule ℝ (Cochain E) :=
  LinearMap.ker (boundary₁ S)

variable [TopologicalSpace E] {S : ContinuousGeometricStepSystem A E}

theorem cycles_eq_exact_orthogonal : Cycles S.toGeometricStepSystem = (Exact S)ᗮ := by
  classical
  ext z
  constructor
  · intro hz u hu
    rcases hu with ⟨f, rfl⟩
    rw [← boundary_pair, show boundary₁ S.toGeometricStepSystem z = 0 from hz, map_zero]
  · intro hz
    apply Finsupp.ext
    intro a
    have h := hz (d0 S.toGeometricStepSystem (Pi.single a 1)) ⟨_, rfl⟩
    rw [← boundary_pair] at h
    simpa [vertexEval] using h

noncomputable def boundary₂ (P : ScopedGeometricRewritePresentation S) :
    (Cell P →₀ ℝ) →ₗ[ℝ] Cochain E :=
  Finsupp.linearCombination ℝ (fun c => wordChain c.left - wordChain c.right)

noncomputable def Relations (P : ScopedGeometricRewritePresentation S) : Submodule ℝ (Cochain E) :=
  LinearMap.range (boundary₂ P)

theorem relations_eq_span (P : ScopedGeometricRewritePresentation S) :
    Relations P = Submodule.span ℝ (Set.range fun c : Cell P => wordChain c.left - wordChain c.right) :=
  Finsupp.range_linearCombination ℝ

theorem boundary_squared (P : ScopedGeometricRewritePresentation S) :
    (boundary₁ S.toGeometricStepSystem).comp (boundary₂ P) = 0 := by
  apply Finsupp.lhom_ext
  intro c r
  simp [boundary₂, boundary_word]

theorem relations_le_cycles (P : ScopedGeometricRewritePresentation S) :
    Relations P ≤ Cycles S.toGeometricStepSystem := by
  rintro z ⟨c, rfl⟩
  exact LinearMap.congr_fun (boundary_squared P) c

theorem closed_eq_relations_orthogonal (P : ScopedGeometricRewritePresentation S) :
    Closed P = (Relations P)ᗮ := by
  ext ω
  constructor
  · intro hω z hz
    have h : Relations P ≤ LinearMap.ker (innerSL ℝ ω).toLinearMap := by
      rw [relations_eq_span]
      apply Submodule.span_le.mpr
      rintro _ ⟨c, rfl⟩
      change inner ℝ ω (wordChain c.left - wordChain c.right) = 0
      rw [real_inner_comm, inner_sub_left, wordChain_period, wordChain_period]
      exact congrFun hω c
    exact (real_inner_comm _ _).trans (h hz)
  · intro hω
    funext c
    change period c.left ω - period c.right ω = 0
    have hc : wordChain c.left - wordChain c.right ∈ Relations P := by
      rw [relations_eq_span]
      exact Submodule.subset_span ⟨c, rfl⟩
    exact (by simpa [inner_sub_left, wordChain_period] using hω _ hc)

noncomputable def LoopSpan (S : GeometricStepSystem A E) : Submodule ℝ (Cochain E) :=
  Submodule.span ℝ (Set.range fun l : Σ a, GeometricTrace S a a => wordChain l.2)

theorem loopSpan_orthogonal : (LoopSpan S.toGeometricStepSystem)ᗮ = Exact S := by
  ext ω
  rw [exact_iff_zero_loop_periods]
  constructor
  · intro h a p
    exact (wordChain_period p ω).symm.trans (h _ (Submodule.subset_span ⟨⟨a,p⟩,rfl⟩))
  · intro h
    have hs : LoopSpan S.toGeometricStepSystem ≤ LinearMap.ker (innerSL ℝ ω).toLinearMap := by
      apply Submodule.span_le.mpr
      rintro _ ⟨⟨a,p⟩,rfl⟩
      change inner ℝ ω (wordChain p) = 0
      rw [real_inner_comm, wordChain_period, h a p]
    intro z hz
    exact (real_inner_comm _ _).trans (hs hz)

theorem loopSpan_eq_cycles : LoopSpan S.toGeometricStepSystem = Cycles S.toGeometricStepSystem := by
  rw [cycles_eq_exact_orthogonal, ← loopSpan_orthogonal, Submodule.orthogonal_orthogonal]

end ComputationalHodge.PresentationHomology

namespace ComputationalHodge.PresentationHomology
open ComputationalPaths.Path.GeometricTopology
open scoped InnerProductSpace
universe u v
variable {A : Type u} [TopologicalSpace A] {E : Type v} [Fintype E] [TopologicalSpace E]
  {S : ContinuousGeometricStepSystem A E}

noncomputable def ChainBoundaries (P : ScopedGeometricRewritePresentation S) :
    Submodule ℝ (Cycles S.toGeometricStepSystem) :=
  (Relations P).comap (Cycles S.toGeometricStepSystem).subtype
abbrev ChainH1 (P : ScopedGeometricRewritePresentation S) :=
  Cycles S.toGeometricStepSystem ⧸ ChainBoundaries P

noncomputable def chainHarmonicProjection (P : ScopedGeometricRewritePresentation S) :
    Cycles S.toGeometricStepSystem →ₗ[ℝ] Harmonic P where
  toFun z := ⟨(z : Cochain E) - (Relations P).starProjection z, by
    rw [closed_eq_relations_orthogonal]
    exact (Relations P).sub_starProjection_mem_orthogonal _, by
    rw [← cycles_eq_exact_orthogonal]
    exact (Cycles S.toGeometricStepSystem).sub_mem z.property
      (relations_le_cycles P ((Relations P).starProjection_apply_mem _))⟩
  map_add' z w := by
    apply Subtype.ext
    change (z.val + w.val) - (Relations P).starProjection (z.val + w.val) =
      (z.val - (Relations P).starProjection z.val) + (w.val - (Relations P).starProjection w.val)
    rw [map_add]; abel
  map_smul' r z := by
    apply Subtype.ext
    change r • z.val - (Relations P).starProjection (r • z.val) =
      r • (z.val - (Relations P).starProjection z.val)
    rw [map_smul, smul_sub]

theorem chainProjection_difference (P : ScopedGeometricRewritePresentation S)
    (z : Cycles S.toGeometricStepSystem) :
    (z : Cochain E) - (chainHarmonicProjection P z : Cochain E) ∈ Relations P := by
  change (z : Cochain E) - ((z : Cochain E) - (Relations P).starProjection z) ∈ Relations P
  simpa only [sub_sub_cancel] using (Relations P).starProjection_apply_mem (z : Cochain E)

theorem chainProjection_zero_iff (P : ScopedGeometricRewritePresentation S)
    (z : Cycles S.toGeometricStepSystem) : chainHarmonicProjection P z = 0 ↔
      (z : Cochain E) ∈ Relations P := by
  constructor
  · intro h
    simpa only [h, ZeroMemClass.coe_zero, sub_zero] using chainProjection_difference P z
  · intro h
    apply Subtype.ext
    change (z : Cochain E) - (Relations P).starProjection z = 0
    rw [Submodule.starProjection_eq_self_iff.mpr h, sub_self]

theorem harmonic_mem_cycles (P : ScopedGeometricRewritePresentation S) (h : Harmonic P) :
    (h : Cochain E) ∈ Cycles S.toGeometricStepSystem := by
  rw [cycles_eq_exact_orthogonal]; exact h.property.2

theorem chainProjection_self (P : ScopedGeometricRewritePresentation S) (h : Harmonic P) :
    chainHarmonicProjection P ⟨h, harmonic_mem_cycles P h⟩ = h := by
  apply Subtype.ext
  have hc : (h : Cochain E) ∈ (Relations P)ᗮ := by
    rw [← closed_eq_relations_orthogonal]; exact h.property.1
  change (h : Cochain E) - (Relations P).starProjection h = h
  rw [Submodule.starProjection_apply,
    Submodule.orthogonalProjectionOnto_eq_zero_iff.mpr hc]
  simp

theorem chainProjection_surjective (P : ScopedGeometricRewritePresentation S) :
    Function.Surjective (chainHarmonicProjection P) :=
  fun h => ⟨⟨h, harmonic_mem_cycles P h⟩, chainProjection_self P h⟩

theorem chainProjection_kernel (P : ScopedGeometricRewritePresentation S) :
    LinearMap.ker (chainHarmonicProjection P) = ChainBoundaries P := by
  ext z; exact chainProjection_zero_iff P z

noncomputable def homologyHodgeEquiv (P : ScopedGeometricRewritePresentation S) :
    ChainH1 P ≃ₗ[ℝ] Harmonic P :=
  (Submodule.quotEquivOfEq (ChainBoundaries P) (LinearMap.ker (chainHarmonicProjection P))
    (chainProjection_kernel P).symm).trans
    ((chainHarmonicProjection P).quotKerEquivOfSurjective (chainProjection_surjective P))

theorem homologyHodge_mk (P : ScopedGeometricRewritePresentation S)
    (z : Cycles S.toGeometricStepSystem) :
    homologyHodgeEquiv P ((ChainBoundaries P).mkQ z) = chainHarmonicProjection P z := rfl

theorem rewrite_chain_difference (P : ScopedGeometricRewritePresentation S)
    {a b : A} {p q : GeometricTrace S.toGeometricStepSystem a b} (h : ScopedRwEq P p q) :
    wordChain p - wordChain q ∈ Relations P := by
  rw [← Submodule.orthogonal_orthogonal (K := Relations P)]
  intro ω hω
  have hc : ω ∈ Closed P := by rw [closed_eq_relations_orthogonal]; exact hω
  rw [real_inner_comm, inner_sub_left, wordChain_period, wordChain_period,
    period_rewrite P ⟨ω,hc⟩ h, sub_self]

noncomputable def loopCycle {S : GeometricStepSystem A E} {a : A}
    (p : GeometricTrace S a a) : Cycles S :=
  ⟨wordChain p, by change boundary₁ S (wordChain p) = 0; simp [boundary_word]⟩

noncomputable def loopClass (P : ScopedGeometricRewritePresentation S) (a : A) :
    PathClass P a a → ChainH1 P :=
  Quotient.lift (fun p => (ChainBoundaries P).mkQ (loopCycle p))
    (by
      intro p q hpq
      apply (Submodule.Quotient.eq (ChainBoundaries P)).mpr
      exact rewrite_chain_difference P hpq)

theorem loopClass_compose (P : ScopedGeometricRewritePresentation S) {a : A}
    (p q : PathClass P a a) : loopClass P a (compose P p q) = loopClass P a p + loopClass P a q := by
  induction p using Quotient.inductionOn with | _ p =>
  induction q using Quotient.inductionOn with | _ q =>
  change (ChainBoundaries P).mkQ (loopCycle (.trans p q)) =
    (ChainBoundaries P).mkQ (loopCycle p) + (ChainBoundaries P).mkQ (loopCycle q)
  rw [show loopCycle (.trans p q) = loopCycle p + loopCycle q from Subtype.ext rfl, map_add]

theorem loopClass_refl (P : ScopedGeometricRewritePresentation S) (a : A) :
    loopClass P a (Quotient.mk _ (.refl a)) = 0 := by
  change (ChainBoundaries P).mkQ (loopCycle (.refl a)) = 0
  rw [show loopCycle (.refl a) = 0 from Subtype.ext rfl, map_zero]

theorem loopClass_symm (P : ScopedGeometricRewritePresentation S) {a : A}
    (p : GeometricTrace S.toGeometricStepSystem a a) :
    loopClass P a (Quotient.mk _ (.symm p)) = -loopClass P a (Quotient.mk _ p) := by
  change (ChainBoundaries P).mkQ (loopCycle (.symm p)) = -(ChainBoundaries P).mkQ (loopCycle p)
  rw [show loopCycle (.symm p) = -loopCycle p from Subtype.ext rfl, map_neg]

def reverse (P : ScopedGeometricRewritePresentation S) {a b : A} : PathClass P a b → PathClass P b a :=
  Quotient.lift (fun p => Quotient.mk _ (.symm p)) (fun _ _ h => Quotient.sound (.symm_congr h))

theorem loopClass_reverse (P : ScopedGeometricRewritePresentation S) {a : A}
    (p : PathClass P a a) : loopClass P a (reverse P p) = -loopClass P a p := by
  induction p using Quotient.inductionOn with | _ p => exact loopClass_symm P p

theorem loopClasses_span (P : ScopedGeometricRewritePresentation S) :
    Submodule.span ℝ (Set.range fun l : Σ a, PathClass P a a => loopClass P l.1 l.2) = ⊤ := by
  let L := Submodule.span ℝ (Set.range fun l : Σ a, PathClass P a a => loopClass P l.1 l.2)
  have hs : LoopSpan S.toGeometricStepSystem ≤
      (L.comap (ChainBoundaries P).mkQ).map (Cycles S.toGeometricStepSystem).subtype := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨a,p⟩,rfl⟩
    exact ⟨loopCycle p, Submodule.subset_span ⟨⟨a,Quotient.mk _ p⟩,rfl⟩,rfl⟩
  apply top_unique
  intro c _
  induction c using Submodule.Quotient.induction_on with | _ z =>
  have hz : (z : Cochain E) ∈ LoopSpan S.toGeometricStepSystem := by
    rw [loopSpan_eq_cycles]; exact z.property
  obtain ⟨w,hw,heq⟩ := hs hz
  have hwz : w = z := Subtype.ext heq
  change (ChainBoundaries P).mkQ w ∈ L at hw
  change (ChainBoundaries P).mkQ z ∈ L
  simpa only [hwz] using hw

end ComputationalHodge.PresentationHomology

namespace ComputationalHodge.PresentationHomology
open ComputationalPaths.Path.GeometricTopology
open scoped InnerProductSpace
universe u v
variable {A : Type u} [TopologicalSpace A] {E : Type v} [Fintype E] [TopologicalSpace E]
  {S : ContinuousGeometricStepSystem A E}

noncomputable def cycleEvaluation (P : ScopedGeometricRewritePresentation S) (ω : Closed P) :
    Module.Dual ℝ (ChainH1 P) :=
  (ChainBoundaries P).liftQ
    ((innerSL ℝ (ω : Cochain E)).toLinearMap.comp (Cycles S.toGeometricStepSystem).subtype) (by
      intro z hz
      have hc : (ω : Cochain E) ∈ (Relations P)ᗮ := by
        rw [← closed_eq_relations_orthogonal]; exact ω.property
      exact Submodule.inner_left_of_mem_orthogonal
        (show (z : Cochain E) ∈ Relations P from hz) hc)

noncomputable def evaluationMap (P : ScopedGeometricRewritePresentation S) :
    Closed P →ₗ[ℝ] Module.Dual ℝ (ChainH1 P) where
  toFun := cycleEvaluation P
  map_add' ω η := by
    apply LinearMap.ext; intro z
    induction z using Submodule.Quotient.induction_on with | _ z =>
    change inner ℝ ((ω : Cochain E) + η) z =
      inner ℝ (ω : Cochain E) (z : Cochain E) + inner ℝ (η : Cochain E) (z : Cochain E)
    exact inner_add_left _ _ _
  map_smul' r ω := by
    apply LinearMap.ext; intro z
    induction z using Submodule.Quotient.induction_on with | _ z =>
    change inner ℝ (r • (ω : Cochain E)) z = r * inner ℝ (ω : Cochain E) (z : Cochain E)
    exact real_inner_smul_left _ _ r

noncomputable def pairing (P : ScopedGeometricRewritePresentation S) :
    H1 P →ₗ[ℝ] Module.Dual ℝ (ChainH1 P) :=
  (Boundaries P).liftQ (evaluationMap P) (by
    intro ω hω
    apply LinearMap.ext; intro z
    induction z using Submodule.Quotient.induction_on with | _ z =>
    change inner ℝ (ω : Cochain E) z = 0
    have hz : (z : Cochain E) ∈ (Exact S)ᗮ := by
      rw [← cycles_eq_exact_orthogonal]; exact z.property
    exact Submodule.inner_right_of_mem_orthogonal
      (show (ω : Cochain E) ∈ Exact S from hω) hz)

theorem pairing_mk (P : ScopedGeometricRewritePresentation S) (ω : Closed P)
    (z : Cycles S.toGeometricStepSystem) :
    pairing P ((Boundaries P).mkQ ω) ((ChainBoundaries P).mkQ z) = inner ℝ (ω : Cochain E) z := rfl

theorem pairing_harmonic (P : ScopedGeometricRewritePresentation S) (c : H1 P)
    (z : Cycles S.toGeometricStepSystem) :
    pairing P c ((ChainBoundaries P).mkQ z) = inner ℝ (hodgeEquiv P c : Cochain E) z := by
  induction c using Submodule.Quotient.induction_on with | _ ω =>
  change inner ℝ (ω : Cochain E) z = inner ℝ (harmonicProjection P ω : Cochain E) z
  have hz : (z : Cochain E) ∈ (Exact S)ᗮ := by
    rw [← cycles_eq_exact_orthogonal]; exact z.property
  have h := Submodule.inner_right_of_mem_orthogonal (harmonicProjection_difference P ω) hz
  rw [inner_sub_left] at h
  exact sub_eq_zero.mp h

theorem pairing_injective (P : ScopedGeometricRewritePresentation S) :
    Function.Injective (pairing P) := by
  apply LinearMap.ker_eq_bot.mp
  apply bot_unique
  intro c hc
  change c = 0
  apply (hodgeEquiv P).injective
  rw [map_zero]
  apply Subtype.ext
  have hz := LinearMap.congr_fun (show pairing P c = 0 from hc)
    ((ChainBoundaries P).mkQ ⟨hodgeEquiv P c, harmonic_mem_cycles P (hodgeEquiv P c)⟩)
  rw [pairing_harmonic] at hz
  have hself : inner ℝ (hodgeEquiv P c : Cochain E) (hodgeEquiv P c : Cochain E) = 0 := hz
  exact inner_self_eq_zero.mp hself

theorem pairing_finrank (P : ScopedGeometricRewritePresentation S) :
    Module.finrank ℝ (H1 P) = Module.finrank ℝ (Module.Dual ℝ (ChainH1 P)) := by
  rw [Subspace.dual_finrank_eq]
  exact (hodgeEquiv P).finrank_eq.trans (homologyHodgeEquiv P).finrank_eq.symm

noncomputable def periodDuality (P : ScopedGeometricRewritePresentation S) :
    H1 P ≃ₗ[ℝ] Module.Dual ℝ (ChainH1 P) :=
  LinearEquiv.ofBijective (pairing P) ⟨pairing_injective P,
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (pairing_finrank P)).mp
      (pairing_injective P)⟩

theorem periodDuality_mk (P : ScopedGeometricRewritePresentation S) (ω : Closed P)
    (z : Cycles S.toGeometricStepSystem) :
    periodDuality P ((Boundaries P).mkQ ω) ((ChainBoundaries P).mkQ z) = inner ℝ (ω : Cochain E) z := rfl

theorem pairing_loopClass (P : ScopedGeometricRewritePresentation S) {a : A}
    (p : PathClass P a a) (c : H1 P) : pairing P c (loopClass P a p) = periodPairing P a p c := by
  induction p using Quotient.inductionOn with | _ p =>
  induction c using Submodule.Quotient.induction_on with | _ ω =>
  change inner ℝ (ω : Cochain E) (wordChain p) = period p ω
  rw [real_inner_comm, wordChain_period]

end ComputationalHodge.PresentationHomology

namespace ComputationalHodge.PresentationHomology.OneLoop
open ComputationalPaths.Path.GeometricTopology

def system : ContinuousGeometricStepSystem Unit Unit where
  src _ := (); tgt _ := (); realize _ := _root_.Path.refl ()
  continuous_src := continuous_const
  continuous_tgt := continuous_const
  continuous_realize := continuous_const
def presentation : ScopedGeometricRewritePresentation system where
  rule _ _ := False
  sound_rule h := False.elim h
noncomputable def coefficient : Cochain Unit := EuclideanSpace.basisFun Unit ℝ ()
noncomputable def closedCoefficient : Closed presentation :=
  ⟨coefficient, by funext c; exact False.elim c.rule⟩
noncomputable def cohomologyClass : H1 presentation := (Boundaries presentation).mkQ closedCoefficient
noncomputable def generator : ChainH1 presentation :=
  loopClass presentation () (Quotient.mk _ (.single ()))

theorem primitive_period : period (GeometricTrace.single (S := system.toGeometricStepSystem) ())
    coefficient = 1 := by
  change ((EuclideanSpace.basisFun Unit ℝ) ()) () = 1
  simp only [EuclideanSpace.basisFun_apply, PiLp.single_apply, ↓reduceIte]

theorem evaluates_generator : pairing presentation cohomologyClass generator = 1 := by
  rw [generator, pairing_loopClass]
  exact primitive_period

theorem generator_nonzero : generator ≠ 0 := by
  intro h
  have he := evaluates_generator
  rw [h, map_zero] at he
  norm_num at he

theorem integral_period {a b : Unit} (p : GeometricTrace system.toGeometricStepSystem a b) :
    ∃ n : ℤ, period p coefficient = (n : ℝ) := by
  induction p with
  | refl a => exact ⟨0, by simp [period]⟩
  | single e => exact ⟨1, by cases e; simpa using primitive_period⟩
  | trans p q hp hq =>
    obtain ⟨n,hn⟩ := hp; obtain ⟨m,hm⟩ := hq
    exact ⟨n+m, by change period p coefficient + period q coefficient = _; rw [hn,hm,Int.cast_add]⟩
  | symm p hp =>
    obtain ⟨n,hn⟩ := hp
    exact ⟨-n, by change -period p coefficient = _; rw [hn,Int.cast_neg]⟩

theorem fractional_not_single_loop :
    ¬ ∃ p : PathClass presentation () (), loopClass presentation () p = (1/2 : ℝ) • generator := by
  rintro ⟨p,hp⟩
  induction p using Quotient.inductionOn with | _ p =>
  have he := congrArg (pairing presentation cohomologyClass) hp
  rw [map_smul, evaluates_generator, pairing_loopClass] at he
  change period p coefficient = (1/2 : ℝ) * 1 at he
  obtain ⟨n,hn⟩ := integral_period p
  have hr : (n : ℝ) = 1/2 := by linarith
  have hn0 : 0 < n := by exact_mod_cast (show (0 : ℝ) < (n : ℝ) by rw [hr]; norm_num)
  have hn1 : n < 1 := by exact_mod_cast (show (n : ℝ) < (1 : ℝ) by rw [hr]; norm_num)
  omega

end ComputationalHodge.PresentationHomology.OneLoop
