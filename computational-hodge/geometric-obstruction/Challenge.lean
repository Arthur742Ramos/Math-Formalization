namespace ComputationalHodge.PresentationHomology.OneLoop
open ComputationalPaths.Path.GeometricTopology

def system : ContinuousGeometricStepSystem Unit Unit where
  src _ := (); tgt _ := (); realize _ := _root_.Path.refl ()
  continuous_src := continuous_const
  continuous_tgt := continuous_const
  continuous_realize := continuous_const
def presentation : ScopedGeometricRewritePresentation system where
  rule _ _ := False
  sound_rule h := False.elim h
noncomputable def coefficient : Cochain Unit := EuclideanSpace.basisFun Unit ℝ ()
noncomputable def closedCoefficient : Closed presentation :=
  ⟨coefficient, by funext c; exact False.elim c.rule⟩

theorem primitive_period : period (GeometricTrace.single (S := system.toGeometricStepSystem) ())
    coefficient = 1 := by
  change ((EuclideanSpace.basisFun Unit ℝ) ()) () = 1
  simp only [EuclideanSpace.basisFun_apply, PiLp.single_apply, ↓reduceIte]


end ComputationalHodge.PresentationHomology.OneLoop

namespace ComputationalHodge.GeometricDescent
open ComputationalPaths.Path.GeometricTopology
open ComputationalHodge.PresentationHomology
open scoped InnerProductSpace
universe u v
variable {A : Type u} [TopologicalSpace A] {E : Type v} [Fintype E] [TopologicalSpace E]
  {S : ContinuousGeometricStepSystem A E}

/-- The finite-system analogue of the user's universal geometric presentation. -/
noncomputable def geometricPresentation (S : ContinuousGeometricStepSystem A E) :
    ScopedGeometricRewritePresentation S where
  rule p q := _root_.Path.Homotopic (GeometricTrace.realize p) (GeometricTrace.realize q)
  sound_rule h := h


def NullLoop (S : ContinuousGeometricStepSystem A E) :=
  {l : Σ a, GeometricTrace S.toGeometricStepSystem a a //
    _root_.Path.Homotopic (GeometricTrace.realize l.2) (_root_.Path.refl l.1)}

noncomputable def NullSpan (S : ContinuousGeometricStepSystem A E) : Submodule ℝ (Cochain E) :=
  Submodule.span ℝ (Set.range (fun l : NullLoop S => wordChain l.val.2))

omit [Fintype E] in
theorem difference_nullhomotopic {a b : A} {p q : GeometricTrace S.toGeometricStepSystem a b}
    (h : _root_.Path.Homotopic (GeometricTrace.realize p) (GeometricTrace.realize q)) :
    _root_.Path.Homotopic (GeometricTrace.realize (.trans p (.symm q))) (_root_.Path.refl a) := by
  exact (h.hcomp (_root_.Path.Homotopic.refl _)).trans
    ⟨(_root_.Path.Homotopy.reflTransSymm (GeometricTrace.realize q)).symm⟩

theorem geometric_relations_eq_nullSpan : Relations (geometricPresentation S) = NullSpan S := by
  rw [relations_eq_span]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨c,rfl⟩
    have h := Submodule.subset_span (R := ℝ)
      (show wordChain (.trans c.left (.symm c.right)) ∈
        Set.range (fun l : NullLoop S => wordChain l.val.2) from
        ⟨⟨⟨c.src,.trans c.left (.symm c.right)⟩,difference_nullhomotopic c.rule⟩,rfl⟩)
    simpa only [NullSpan,wordChain, sub_eq_add_neg] using h
  · apply Submodule.span_le.mpr
    rintro _ ⟨l,rfl⟩
    have h := Submodule.subset_span (R := ℝ)
      (show wordChain l.val.2 - wordChain (.refl l.val.1) ∈
        Set.range (fun c : Cell (geometricPresentation S) => wordChain c.left - wordChain c.right) from
        ⟨⟨l.val.1,l.val.1,l.val.2,.refl l.val.1,l.property⟩,rfl⟩)
    simpa only [wordChain,sub_zero] using h

theorem presentation_relations_le_nullSpan (P : ScopedGeometricRewritePresentation S) :
    Relations P ≤ NullSpan S := by
  rw [relations_eq_span]
  apply Submodule.span_le.mpr
  rintro _ ⟨c,rfl⟩
  rw [← geometric_relations_eq_nullSpan,relations_eq_span]
  exact Submodule.subset_span ⟨⟨c.src,c.tgt,c.left,c.right,P.sound_rule c.rule⟩,rfl⟩

end ComputationalHodge.GeometricDescent

namespace ComputationalHodge.GeometricDescent
open ComputationalPaths.Path.GeometricTopology
open ComputationalHodge.PresentationHomology
open scoped InnerProductSpace
universe u v
variable {A : Type u} [TopologicalSpace A] {E : Type v} [Fintype E] [TopologicalSpace E]
  {S : ContinuousGeometricStepSystem A E}


theorem chainBoundaries_le (P : ScopedGeometricRewritePresentation S) :
    ChainBoundaries P ≤ ChainBoundaries (geometricPresentation S) := by
  intro z hz
  change (z : Cochain E) ∈ Relations (geometricPresentation S)
  rw [geometric_relations_eq_nullSpan]
  exact presentation_relations_le_nullSpan P hz

noncomputable def homologyMap (P : ScopedGeometricRewritePresentation S) :
    ChainH1 P →ₗ[ℝ] ChainH1 (geometricPresentation S) :=
  (ChainBoundaries P).liftQ (ChainBoundaries (geometricPresentation S)).mkQ
    (by simpa only [Submodule.ker_mkQ] using chainBoundaries_le P)

theorem homologyMap_mk (P : ScopedGeometricRewritePresentation S)
    (z : Cycles S.toGeometricStepSystem) :
    homologyMap P ((ChainBoundaries P).mkQ z) =
      (ChainBoundaries (geometricPresentation S)).mkQ z := rfl


theorem geometric_closed_iff_null_periods (ω : Cochain E) :
    ω ∈ Closed (geometricPresentation S) ↔ ∀ l : NullLoop S, period l.val.2 ω = 0 := by
  rw [closed_eq_relations_orthogonal,geometric_relations_eq_nullSpan]
  constructor
  · intro h l
    exact (wordChain_period l.val.2 ω).symm.trans (h _ (Submodule.subset_span ⟨l,rfl⟩))
  · intro h
    have hz : NullSpan S ≤ LinearMap.ker (innerSL ℝ ω).toLinearMap := by
      apply Submodule.span_le.mpr
      rintro _ ⟨l,rfl⟩
      change inner ℝ ω (wordChain l.val.2) = 0
      rw [real_inner_comm,wordChain_period,h l]
    intro z hz'
    exact (real_inner_comm _ _).trans (hz hz')

def GeometricInvariant (ω : Cochain E) : Prop :=
  ∀ {a b : A} (p q : GeometricTrace S.toGeometricStepSystem a b),
    _root_.Path.Homotopic (GeometricTrace.realize p) (GeometricTrace.realize q) → period p ω = period q ω

theorem period_descent_iff (ω : Cochain E) :
    GeometricInvariant (S := S) ω ↔ ∀ l : NullLoop S, period l.val.2 ω = 0 := by
  constructor
  · intro h l
    exact (h l.val.2 (.refl l.val.1) l.property).trans rfl
  · intro h a b p q hpq
    exact period_rewrite (geometricPresentation S)
      ⟨ω,(geometric_closed_iff_null_periods ω).mpr h⟩ (.generator hpq)

theorem geometric_closed_le (P : ScopedGeometricRewritePresentation S) :
    Closed (geometricPresentation S) ≤ Closed P := by
  rw [closed_eq_relations_orthogonal,closed_eq_relations_orthogonal]
  intro ω h z hz
  exact h z (by rw [geometric_relations_eq_nullSpan]; exact presentation_relations_le_nullSpan P hz)


theorem harmonic_descent_iff (P : ScopedGeometricRewritePresentation S) (h : Harmonic P) :
    (h : Cochain E) ∈ Harmonic (geometricPresentation S) ↔
      ∀ l : NullLoop S, period l.val.2 h = 0 := by
  constructor
  · intro hg
    exact (geometric_closed_iff_null_periods _).mp hg.1
  · intro hn
    exact ⟨(geometric_closed_iff_null_periods _).mpr hn,h.property.2⟩

end ComputationalHodge.GeometricDescent

namespace ComputationalHodge.GeometricDescent
open ComputationalPaths.Path.GeometricTopology
open ComputationalHodge.PresentationHomology

def constantNullLoop : NullLoop OneLoop.system :=
  ⟨⟨(),.single ()⟩,_root_.Path.Homotopic.refl (_root_.Path.refl ())⟩


end ComputationalHodge.GeometricDescent

namespace ComputationalHodge.GeometricObstruction
open ComputationalPaths.Path.GeometricTopology
open ComputationalHodge.PresentationHomology ComputationalHodge.GeometricDescent
open scoped InnerProductSpace
universe u v
variable {A : Type u} [TopologicalSpace A] {E : Type v} [Fintype E] [TopologicalSpace E]
  {S : ContinuousGeometricStepSystem A E}

/-- The geometric relations not already removed by the old presentation. -/
noncomputable def Obstruction (P : ScopedGeometricRewritePresentation S) :
    Submodule ℝ (Cochain E) := NullSpan S ⊓ (Relations P)ᗮ

theorem nullSpan_le_cycles : NullSpan S ≤ Cycles S.toGeometricStepSystem := by
  rw [← geometric_relations_eq_nullSpan]
  exact relations_le_cycles _

theorem geometric_harmonic_orthogonal (g : Harmonic (geometricPresentation S)) :
    (g : Cochain E) ∈ (NullSpan S)ᗮ := by
  rw [← geometric_relations_eq_nullSpan,← closed_eq_relations_orthogonal]
  exact g.property.1

theorem correction_mem (P : ScopedGeometricRewritePresentation S) (h : Harmonic P) :
    (h : Cochain E) - (NullSpan S).starProjection h ∈ Harmonic (geometricPresentation S) := by
  constructor
  · rw [closed_eq_relations_orthogonal,geometric_relations_eq_nullSpan]
    exact (NullSpan S).sub_starProjection_mem_orthogonal _
  · have hb := nullSpan_le_cycles ((NullSpan S).starProjection_apply_mem (h : Cochain E))
    rw [cycles_eq_exact_orthogonal] at hb
    exact (Exact S)ᗮ.sub_mem h.property.2 hb

/-- Canonical geometric correction, using the actual nullhomotopic trace span. -/
noncomputable def geometricCorrection (P : ScopedGeometricRewritePresentation S) :
    Harmonic P →ₗ[ℝ] Harmonic (geometricPresentation S) where
  toFun h := ⟨(h : Cochain E) - (NullSpan S).starProjection h,correction_mem P h⟩
  map_add' h k := by
    apply Subtype.ext
    change ((h : Cochain E) + k) - (NullSpan S).starProjection (h + k) = _
    rw [map_add]
    change _ = ((h : Cochain E) - (NullSpan S).starProjection h) +
      ((k : Cochain E) - (NullSpan S).starProjection k)
    abel
  map_smul' r h := by
    apply Subtype.ext
    change r • (h : Cochain E) - (NullSpan S).starProjection (r • (h : Cochain E)) = _
    rw [map_smul]
    exact (smul_sub r (h : Cochain E) ((NullSpan S).starProjection h)).symm

theorem obstruction_mem (P : ScopedGeometricRewritePresentation S) (h : Harmonic P) :
    (NullSpan S).starProjection (h : Cochain E) ∈ Obstruction P := by
  refine ⟨(NullSpan S).starProjection_apply_mem _,?_⟩
  rw [← closed_eq_relations_orthogonal]
  have hg := geometric_closed_le P (geometricCorrection P h).property.1
  have hd := (Closed P).sub_mem h.property.1 hg
  change (NullSpan S).starProjection (h : Cochain E) ∈ Closed P
  change (h : Cochain E) - ((h : Cochain E) - (NullSpan S).starProjection h) ∈ Closed P at hd
  rw [sub_sub_cancel] at hd
  exact hd

noncomputable def obstructionProjection (P : ScopedGeometricRewritePresentation S) :
    Harmonic P →ₗ[ℝ] Obstruction P where
  toFun h := ⟨(NullSpan S).starProjection h,obstruction_mem P h⟩
  map_add' h k := Subtype.ext (map_add (NullSpan S).starProjection (h : Cochain E) (k : Cochain E))
  map_smul' r h := Subtype.ext (map_smul (NullSpan S).starProjection r (h : Cochain E))

theorem harmonic_decomposition (P : ScopedGeometricRewritePresentation S) (h : Harmonic P) :
    (h : Cochain E) = (geometricCorrection P h : Cochain E) + obstructionProjection P h :=
  (sub_add_cancel (h : Cochain E) ((NullSpan S).starProjection h)).symm

theorem geometric_obstruction_orthogonal (P : ScopedGeometricRewritePresentation S)
    (g : Harmonic (geometricPresentation S)) (b : Obstruction P) :
    inner ℝ (g : Cochain E) (b : Cochain E) = 0 :=
  (real_inner_comm _ _).trans (geometric_harmonic_orthogonal g b b.property.1)

theorem geometricCorrection_invariant (P : ScopedGeometricRewritePresentation S) (h : Harmonic P) :
    GeometricInvariant (S := S) (geometricCorrection P h : Cochain E) :=
  (period_descent_iff _).mpr ((geometric_closed_iff_null_periods _).mp
    (geometricCorrection P h).property.1)

theorem obstruction_zero_iff_descent (P : ScopedGeometricRewritePresentation S) (h : Harmonic P) :
    obstructionProjection P h = 0 ↔ GeometricInvariant (S := S) (h : Cochain E) := by
  rw [period_descent_iff,← harmonic_descent_iff P h]
  constructor
  · intro hb
    have he := harmonic_decomposition P h
    rw [hb,ZeroMemClass.coe_zero,add_zero] at he
    exact he ▸ (geometricCorrection P h).property
  · intro hg
    apply Subtype.ext
    change (NullSpan S).starProjection (h : Cochain E) = 0
    have ho : (h : Cochain E) ∈ (NullSpan S)ᗮ := by
      rw [← geometric_relations_eq_nullSpan,← closed_eq_relations_orthogonal]
      exact hg.1
    exact congrArg Subtype.val (Submodule.orthogonalProjectionOnto_eq_zero_iff.mpr ho)

theorem decomposition_unique (P : ScopedGeometricRewritePresentation S) (h : Harmonic P)
    (g : Harmonic (geometricPresentation S)) (b : Obstruction P)
    (he : (h : Cochain E) = (g : Cochain E) + b) :
    g = geometricCorrection P h ∧ b = obstructionProjection P h := by
  have hp : (NullSpan S).starProjection (h : Cochain E) = (b : Cochain E) :=
    Submodule.eq_starProjection_of_mem_orthogonal' b.property.1
      (geometric_harmonic_orthogonal g) (he.trans (add_comm _ _))
  constructor
  · apply Subtype.ext
    change (g : Cochain E) = (h : Cochain E) - (NullSpan S).starProjection h
    rw [hp,he,add_sub_cancel_right]
  · exact Subtype.ext hp.symm

theorem approximation_pythagoras (P : ScopedGeometricRewritePresentation S) (h : Harmonic P)
    (k : Harmonic (geometricPresentation S)) :
    ‖(h : Cochain E) - k‖ ^ 2 = ‖(obstructionProjection P h : Cochain E)‖ ^ 2 +
      ‖(geometricCorrection P h : Cochain E) - k‖ ^ 2 := by
  have he : (h : Cochain E) - k = (obstructionProjection P h : Cochain E) +
      ((geometricCorrection P h : Cochain E) - k) := by
    rw [harmonic_decomposition P h]; abel
  have ho : inner ℝ (obstructionProjection P h : Cochain E)
      ((geometricCorrection P h : Cochain E) - k) = 0 :=
    (real_inner_comm _ _).trans
      (geometric_obstruction_orthogonal P (geometricCorrection P h - k) (obstructionProjection P h))
  rw [he,norm_add_sq_real,ho,mul_zero,add_zero]

theorem correction_error (P : ScopedGeometricRewritePresentation S) (h : Harmonic P) :
    ‖(h : Cochain E) - geometricCorrection P h‖ = ‖(obstructionProjection P h : Cochain E)‖ := by
  rw [harmonic_decomposition P h,add_sub_cancel_left]

theorem correction_closest (P : ScopedGeometricRewritePresentation S) (h : Harmonic P)
    (k : Harmonic (geometricPresentation S)) :
    ‖(h : Cochain E) - geometricCorrection P h‖ ≤ ‖(h : Cochain E) - k‖ := by
  rw [correction_error]
  apply (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
  rw [approximation_pythagoras]
  exact le_add_of_nonneg_right (sq_nonneg _)

theorem correction_unique_closest (P : ScopedGeometricRewritePresentation S) (h : Harmonic P)
    (k : Harmonic (geometricPresentation S)) :
    ‖(h : Cochain E) - k‖ = ‖(h : Cochain E) - geometricCorrection P h‖ ↔
      k = geometricCorrection P h := by
  constructor
  · intro he
    rw [correction_error] at he
    have hs := approximation_pythagoras P h k
    rw [he] at hs
    have hz : ‖(geometricCorrection P h : Cochain E) - k‖ ^ 2 = 0 :=
      (add_eq_left.mp hs.symm)
    have hv := norm_eq_zero.mp (sq_eq_zero_iff.mp hz)
    exact (Subtype.ext (sub_eq_zero.mp hv)).symm
  · rintro rfl; rfl

end ComputationalHodge.GeometricObstruction

namespace ComputationalHodge.GeometricObstruction
open ComputationalPaths.Path.GeometricTopology
open ComputationalHodge.PresentationHomology ComputationalHodge.GeometricDescent
open scoped InnerProductSpace
universe u v
variable {A : Type u} [TopologicalSpace A] {E : Type v} [Fintype E] [TopologicalSpace E]
  {S : ContinuousGeometricStepSystem A E}

noncomputable def obstructionClass (P : ScopedGeometricRewritePresentation S) :
    Obstruction P →ₗ[ℝ] ChainH1 P where
  toFun b := (ChainBoundaries P).mkQ ⟨b,nullSpan_le_cycles b.property.1⟩
  map_add' b c := by
    change (ChainBoundaries P).mkQ
      (⟨(b : Cochain E) + c,nullSpan_le_cycles (b + c).property.1⟩ : Cycles S.toGeometricStepSystem) = _
    exact map_add (ChainBoundaries P).mkQ
      ⟨b,nullSpan_le_cycles b.property.1⟩ ⟨c,nullSpan_le_cycles c.property.1⟩
  map_smul' r b := by
    exact map_smul (ChainBoundaries P).mkQ r ⟨b,nullSpan_le_cycles b.property.1⟩

theorem obstructionClass_killed (P : ScopedGeometricRewritePresentation S) (b : Obstruction P) :
    homologyMap P (obstructionClass P b) = 0 := by
  change homologyMap P ((ChainBoundaries P).mkQ _) = 0
  rw [homologyMap_mk]
  apply (Submodule.Quotient.mk_eq_zero _).mpr
  change (b : Cochain E) ∈ Relations (geometricPresentation S)
  rw [geometric_relations_eq_nullSpan]
  exact b.property.1

noncomputable def obstructionToKernel (P : ScopedGeometricRewritePresentation S) :
    Obstruction P →ₗ[ℝ] LinearMap.ker (homologyMap P) where
  toFun b := ⟨obstructionClass P b,obstructionClass_killed P b⟩
  map_add' b c := Subtype.ext (map_add (obstructionClass P) b c)
  map_smul' r b := Subtype.ext (map_smul (obstructionClass P) r b)

theorem obstructionToKernel_injective (P : ScopedGeometricRewritePresentation S) :
    Function.Injective (obstructionToKernel P) := by
  intro b c he
  have hq := congrArg Subtype.val he
  have hc : (⟨(b : Cochain E),nullSpan_le_cycles b.property.1⟩ : Cycles S.toGeometricStepSystem) -
      ⟨(c : Cochain E),nullSpan_le_cycles c.property.1⟩ ∈ ChainBoundaries P :=
    (Submodule.Quotient.eq (ChainBoundaries P)).mp hq
  have hr : (b : Cochain E) - c ∈ Relations P := hc
  have ho : (b : Cochain E) - c ∈ (Relations P)ᗮ :=
    (Relations P)ᗮ.sub_mem b.property.2 c.property.2
  have hz : (b : Cochain E) - c = 0 := by
    have hi : (b : Cochain E) - c ∈ Relations P ⊓ (Relations P)ᗮ := ⟨hr,ho⟩
    simpa only [Submodule.inf_orthogonal_eq_bot,Submodule.mem_bot] using hi
  exact Subtype.ext (sub_eq_zero.mp hz)

theorem obstructionToKernel_surjective (P : ScopedGeometricRewritePresentation S) :
    Function.Surjective (obstructionToKernel P) := by
  rintro ⟨q,hq⟩
  induction q using Submodule.Quotient.induction_on with | _ z =>
  have hn : (z : Cochain E) ∈ NullSpan S := by
    change homologyMap P ((ChainBoundaries P).mkQ z) = 0 at hq
    rw [homologyMap_mk] at hq
    have hz := (Submodule.Quotient.mk_eq_zero _).mp hq
    change (z : Cochain E) ∈ Relations (geometricPresentation S) at hz
    rwa [geometric_relations_eq_nullSpan] at hz
  let b : Obstruction P := ⟨(z : Cochain E) - (Relations P).starProjection z,
    (NullSpan S).sub_mem hn (presentation_relations_le_nullSpan P ((Relations P).starProjection_apply_mem _)),
    (Relations P).sub_starProjection_mem_orthogonal _⟩
  refine ⟨b,Subtype.ext ?_⟩
  apply (Submodule.Quotient.eq _).mpr
  change ((z : Cochain E) - (Relations P).starProjection z) - z ∈ Relations P
  have hm := (Relations P).neg_mem ((Relations P).starProjection_apply_mem (z : Cochain E))
  convert hm using 1
  abel

/-- Norm preservation uses the inherited quotient norm on the actual old homology. -/
theorem obstructionToKernel_norm (P : ScopedGeometricRewritePresentation S) (b : Obstruction P) :
    ‖obstructionToKernel P b‖ = ‖b‖ := by
  let z : Cycles S.toGeometricStepSystem := ⟨b,nullSpan_le_cycles b.property.1⟩
  have ho : z ∈ (ChainBoundaries P)ᗮ := by
    intro w hw
    exact b.property.2 (w : Cochain E) hw
  have he := (ChainBoundaries P).quotientEquivOrthogonal_mk z ho
  have hn := (ChainBoundaries P).quotientEquivOrthogonal.norm_map ((ChainBoundaries P).mkQ z)
  change ‖(ChainBoundaries P).quotientEquivOrthogonal (Submodule.Quotient.mk z)‖ =
    ‖(Submodule.Quotient.mk z : ChainH1 P)‖ at hn
  rw [he] at hn
  exact hn.symm

/-- The actual geometric homology kernel, with its inherited quotient norm. -/
noncomputable def obstructionKernelEquiv (P : ScopedGeometricRewritePresentation S) :
    Obstruction P ≃ₗᵢ[ℝ] LinearMap.ker (homologyMap P) where
  __ := LinearEquiv.ofBijective (obstructionToKernel P)
    ⟨obstructionToKernel_injective P,obstructionToKernel_surjective P⟩
  norm_map' := obstructionToKernel_norm P

theorem obstructionKernelEquiv_class (P : ScopedGeometricRewritePresentation S) (b : Obstruction P) :
    (obstructionKernelEquiv P b).val =
      (ChainBoundaries P).mkQ ⟨(b : Cochain E),nullSpan_le_cycles b.property.1⟩ := by
  change (obstructionToKernel P b).val = _
  rfl

theorem correction_error_kernel (P : ScopedGeometricRewritePresentation S) (h : Harmonic P) :
    ‖(h : Cochain E) - geometricCorrection P h‖ =
      ‖obstructionKernelEquiv P (obstructionProjection P h)‖ := by
  rw [(obstructionKernelEquiv P).norm_map]
  exact correction_error P h

theorem kernel_error_pythagoras (P : ScopedGeometricRewritePresentation S) (h : Harmonic P)
    (k : Harmonic (geometricPresentation S)) :
    ‖(h : Cochain E) - k‖ ^ 2 =
      ‖obstructionKernelEquiv P (obstructionProjection P h)‖ ^ 2 +
      ‖(geometricCorrection P h : Cochain E) - k‖ ^ 2 := by
  rw [(obstructionKernelEquiv P).norm_map]
  exact approximation_pythagoras P h k

theorem kernel_obstruction_zero_iff (P : ScopedGeometricRewritePresentation S) (h : Harmonic P) :
    obstructionKernelEquiv P (obstructionProjection P h) = 0 ↔
      GeometricInvariant (S := S) (h : Cochain E) := by
  rw [← obstruction_zero_iff_descent P h]
  constructor
  · intro hz
    exact (obstructionKernelEquiv P).injective
      (hz.trans (obstructionKernelEquiv P).toLinearEquiv.map_zero.symm)
  · intro hz
    rw [hz]
    exact (obstructionKernelEquiv P).toLinearEquiv.map_zero

end ComputationalHodge.GeometricObstruction

namespace ComputationalHodge.GeometricObstruction
open ComputationalPaths.Path.GeometricTopology
open ComputationalHodge.PresentationHomology ComputationalHodge.GeometricDescent
open scoped InnerProductSpace

/-- A nonzero old harmonic cochain carried by a geometrically constant generator. -/
noncomputable def constantHarmonic : Harmonic OneLoop.presentation :=
  ⟨OneLoop.coefficient,OneLoop.closedCoefficient.property,by
    rintro _ ⟨f,rfl⟩
    have hz : d0 OneLoop.system.toGeometricStepSystem f = 0 := by
      ext e
      exact sub_self (f ())
    rw [hz,inner_zero_left]⟩

theorem constant_coefficient_null : OneLoop.coefficient ∈ NullSpan OneLoop.system :=
  Submodule.subset_span ⟨constantNullLoop,rfl⟩

theorem constant_obstruction_self :
    (obstructionProjection OneLoop.presentation constantHarmonic : Cochain Unit) =
      OneLoop.coefficient :=
  Submodule.starProjection_eq_self_iff.mpr constant_coefficient_null

theorem constant_correction_zero : geometricCorrection OneLoop.presentation constantHarmonic = 0 := by
  apply Subtype.ext
  change OneLoop.coefficient - (NullSpan OneLoop.system).starProjection OneLoop.coefficient = 0
  rw [Submodule.starProjection_eq_self_iff.mpr constant_coefficient_null,sub_self]

theorem constant_obstruction_nonzero : obstructionProjection OneLoop.presentation constantHarmonic ≠ 0 := by
  intro hz
  have he := congrArg (fun b : Obstruction OneLoop.presentation => (b : Cochain Unit)) hz
  rw [constant_obstruction_self] at he
  have hp := OneLoop.primitive_period
  rw [he,ZeroMemClass.coe_zero,map_zero] at hp
  exact zero_ne_one hp

theorem constant_kernel_error_positive :
    0 < ‖obstructionKernelEquiv OneLoop.presentation
      (obstructionProjection OneLoop.presentation constantHarmonic)‖ := by
  rw [(obstructionKernelEquiv OneLoop.presentation).norm_map]
  exact norm_pos_iff.mpr constant_obstruction_nonzero

end ComputationalHodge.GeometricObstruction
