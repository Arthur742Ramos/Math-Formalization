# INERT TEMPLATE: stored outside .github/workflows; copying/pushing requires
# one specific parent-coordinated approval for the exact pair and security footprint.
name: Lavrentieff approved exact-source full and conditional rendering
on:
  push:
    branches: [topology/lavrentieff-extension]
    paths: [.github/workflows/palomar-lavrentieff-pair.yml]
permissions:
  contents: read
concurrency:
  group: lavrentieff-canonical-one-pair
  cancel-in-progress: false
env:
  PALOMAR_EXECUTION_PROFILE: palomar-standard-v1
jobs:
  full:
    if: github.run_attempt == 1
    uses: PalomarRegistry/PalomarSubmission/.github/workflows/submission.yml@ad5db9e7ff8b17523d73aeb244aaeabcde810c64
    with:
      repository: Arthur742Ramos/Math-Formalization
      commit: e2d111be48a52d4e3dd803b7b77a72b31cd59ca7
      pipeline_commit: ad5db9e7ff8b17523d73aeb244aaeabcde810c64
      request_id: lavrentiefff1
      execution_attempt: lavrentieff-canonical-1
      mode: full
      execution_profile: palomar-standard-v1
      options: '{"project_path":"topology/lavrentieff-extension","comparator_config_path":"topology/lavrentieff-extension/comparator.json","formalization_metadata_path":"topology/lavrentieff-extension/formalization.yaml","authorization_relationship":"I have approval from a responsible author or maintainer"}'
  authenticate:
    needs: full
    if: always() && github.run_attempt == 1
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    outputs:
      render_allowed: ${{ steps.bind.outputs.render_allowed }}
      labels: ${{ steps.resolve.outputs.labels }}
      render_timeout: ${{ steps.resolve.outputs.render_timeout }}
    steps:
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          name: mechanical-report-lavrentiefff1
          path: mechanical-evidence
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ github.sha }}
          path: caller
          persist-credentials: false
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: e2d111be48a52d4e3dd803b7b77a72b31cd59ca7
          path: source
          persist-credentials: false
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          repository: PalomarRegistry/PalomarSubmission
          ref: ad5db9e7ff8b17523d73aeb244aaeabcde810c64
          path: pipeline
          persist-credentials: false
      - name: Authenticate original same-run full report and every frozen source binding
        id: bind
        env:
          FULL_JOB_RESULT: ${{ needs.full.result }}
        run: |
          test "$FULL_JOB_RESULT" = success
          python3 caller/catalog-evidence/lavrentieff-extension-2026-10-23/canonical-plan/report_gate.py             --plan caller/catalog-evidence/lavrentieff-extension-2026-10-23/canonical-plan/plan.json             --report mechanical-evidence/mechanical-report.json             --source-checkout source --pipeline-checkout pipeline             --workflow-url "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"             --workflow-head "${{ github.sha }}" --run-attempt "${{ github.run_attempt }}"             --output mechanical-evidence/authenticated-full-receipt.json
      - name: Resolve the explicitly selected standard renderer profile
        id: resolve
        if: steps.bind.outputs.render_allowed == 'true'
        run: python3 pipeline/scripts/verification_profile.py --profile palomar-standard-v1 --resolve
      - name: Retain original full report, source archive and authentication receipt
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: lavrentieff-authenticated-full
          path: mechanical-evidence
          retention-days: 90
          if-no-files-found: error
  render:
    needs: authenticate
    if: needs.authenticate.outputs.render_allowed == 'true' && github.run_attempt == 1
    runs-on: ${{ fromJSON(needs.authenticate.outputs.labels) }}
    timeout-minutes: ${{ fromJSON(needs.authenticate.outputs.render_timeout) }}
    steps:
      - name: Free disk space
        uses: jlumbroso/free-disk-space@54081f138730dfa15788a46383842cd2f914a1be
        with:
          tool-cache: false
          android: true
          dotnet: true
          haskell: true
          large-packages: false
          docker-images: true
          swap-storage: false
      - name: Checkout pinned canonical renderer
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          repository: PalomarRegistry/PalomarSubmission
          ref: ad5db9e7ff8b17523d73aeb244aaeabcde810c64
          path: pipeline
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97
        with:
          python-version: '3.11.10'
      - name: Require standard runner capacity before verifier installation
        run: python3 pipeline/scripts/verification_profile.py --profile palomar-standard-v1 --disk-path "$RUNNER_TEMP" > "$RUNNER_TEMP/lavrentieff-render-capacity.json"
      - name: Install verifier dependencies
        run: python -m pip install --disable-pip-version-check --require-hashes --no-deps -r pipeline/requirements.txt
      - name: Checkout source for Challenge hash binding
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: e2d111be48a52d4e3dd803b7b77a72b31cd59ca7
          path: source
          persist-credentials: false
      - name: Fetch and bind exact source
        id: prepare
        working-directory: pipeline
        run: |
          echo "153d5f02dea29239c8318cee4d06985d16d474135af7456b867297a9080ae0fc  $GITHUB_WORKSPACE/source/topology/lavrentieff-extension/LEChallenge.lean" | sha256sum --check
          python -m scripts.render_challenge prepare \
            --repository Arthur742Ramos/Math-Formalization \
            --commit e2d111be48a52d4e3dd803b7b77a72b31cd59ca7 \
            --challenge-sha256 "$(sha256sum "$GITHUB_WORKSPACE/source/topology/lavrentieff-extension/LEChallenge.lean" | cut -d' ' -f1)" \
            --project-path topology/lavrentieff-extension \
            --challenge-path topology/lavrentieff-extension/LEChallenge.lean \
            --solution-path topology/lavrentieff-extension/LESolution.lean \
            --comparator-config-path topology/lavrentieff-extension/comparator.json \
            --lakefile-path topology/lavrentieff-extension/lakefile.toml \
            --lean-toolchain-path topology/lavrentieff-extension/lean-toolchain \
            --work-dir "$RUNNER_TEMP/palomar-render" \
            --output "$RUNNER_TEMP/palomar-render/report.json"
      - name: Require the reviewed immutable Verso dependency before installer execution
        if: steps.prepare.outputs.ready == 'true'
        run: |
          python3 - <<'PYTHON'
          import json, os, pathlib
          report = json.loads((pathlib.Path(os.environ['RUNNER_TEMP']) / 'palomar-render' / 'report.json').read_text())
          assert report['verso_commit'] == '9f8096e40b31715b1d8d5997f15a0bd832f7e37d'
          assert report['source']['commit'] == 'e2d111be48a52d4e3dd803b7b77a72b31cd59ca7'
          assert report['source']['challenge_sha256'] == '153d5f02dea29239c8318cee4d06985d16d474135af7456b867297a9080ae0fc'
          PYTHON
      - name: Install pinned elan
        if: steps.prepare.outputs.ready == 'true'
        run: |
          python3 pipeline/scripts/trusted_download.py \
            --url https://github.com/leanprover/elan/releases/download/v4.2.3/elan-x86_64-unknown-linux-gnu.tar.gz \
            --output "$RUNNER_TEMP/elan.tar.gz" \
            --sha256 df0b2b3a439961ffcbb3985214365ffe40f49bc871df04dff268c7d8e21ca8b2
          mkdir "$RUNNER_TEMP/elan"
          tar -xzf "$RUNNER_TEMP/elan.tar.gz" -C "$RUNNER_TEMP/elan"
          "$RUNNER_TEMP/elan/elan-init" -y --no-modify-path --default-toolchain none
          echo "$HOME/.elan/bin" >> "$GITHUB_PATH"
      - name: Install verified Lean toolchain
        if: steps.prepare.outputs.ready == 'true'
        env:
          LEAN_TOOLCHAIN: ${{ steps.prepare.outputs.lean_toolchain }}
        run: elan toolchain install "$LEAN_TOOLCHAIN"
      - name: Build pinned bubblewrap
        if: steps.prepare.outputs.ready == 'true'
        run: |
          sudo apt-get update -qq >/dev/null
          sudo apt-get install -y -qq meson ninja-build libcap-dev pkg-config >/dev/null
          echo "PALOMAR_BWRAP=$(pipeline/scripts/install_bwrap.sh "$RUNNER_TEMP/bwrap-bin")" >> "$GITHUB_ENV"
      - name: Build, sanitize, and hash Challenge rendering
        if: steps.prepare.outputs.ready == 'true'
        working-directory: pipeline
        run: |
          python -m scripts.render_challenge execute \
            --work-dir "$RUNNER_TEMP/palomar-render" \
            --output "$RUNNER_TEMP/palomar-render/report.json" \
            --bwrap "$PALOMAR_BWRAP" \
            --renderer-commit ad5db9e7ff8b17523d73aeb244aaeabcde810c64 \
            --bwrap-source-tag v0.12.0 \
            --workflow-url "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
      - name: Retain bounded page-size diagnostics even when rendering fails
        if: always()
        run: |
          python3 - <<'PYTHON'
          import json, os, pathlib, stat
          work = pathlib.Path(os.environ['RUNNER_TEMP']) / 'palomar-render'
          raw = work / 'workspace' / 'topology' / 'lavrentieff-extension' / '.lake' / 'build' / 'palomar-render-raw'
          result = {'scope': 'raw HTML size diagnostic only; canonical verdict remains authoritative', 'per_file_cap': 8388608, 'raw_directory_present': raw.is_dir(), 'files': []}
          count = 0
          result['html_files_seen'] = 0
          ancestors = [raw, *raw.parents]
          safe = all(not p.is_symlink() for p in ancestors if p == work or work in p.parents)
          result['symlink_ancestor_rejected'] = not safe
          if safe and raw.is_dir() and not raw.is_symlink():
              for parent, dirs, files in os.walk(raw, followlinks=False):
                  dirs[:] = [d for d in dirs if not (pathlib.Path(parent) / d).is_symlink()]
                  for name in files:
                      count += 1
                      if count > 4000: break
                      p = pathlib.Path(parent) / name
                      mode = p.lstat().st_mode
                      if stat.S_ISREG(mode) and p.suffix.lower() == '.html':
                          n = p.stat().st_size
                          result['html_files_seen'] += 1
                          if len(result['files']) < 100:
                              result['files'].append({'path': p.relative_to(raw).as_posix()[:400], 'bytes': n, 'exceeds_cap': n > 8388608})
                  if count > 4000: break
          result['scan_truncated'] = count > 4000
          result['diagnostic_entries_truncated'] = result['html_files_seen'] > 100
          encoded = json.dumps(result, indent=2) + '\n'
          assert len(encoded.encode()) <= 512 * 1024
          work.mkdir(exist_ok=True)
          (work / 'size-diagnostic.json').write_text(encoded)
          PYTHON
      - name: Upload bounded render result
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: challenge-render-lavrentieff
          path: |
            ${{ runner.temp }}/palomar-render/report.json
            ${{ runner.temp }}/palomar-render/size-diagnostic.json
            ${{ runner.temp }}/lavrentieff-render-capacity.json
            ${{ runner.temp }}/palomar-render/result
          if-no-files-found: error
          retention-days: 30
      - name: Require a successful render
        if: always()
        run: |
          python -c 'import json, os, pathlib, sys; p = pathlib.Path(os.environ["RUNNER_TEMP"]) / "palomar-render" / "report.json"; sys.exit(0 if json.loads(p.read_text())["status"] == "pass" else 1)'
      - name: Publish bounded render report and bundle hashes
        if: always()
        run: |
          python3 - <<'PYTHON'
          import hashlib, json, os, pathlib
          root = pathlib.Path(os.environ['RUNNER_TEMP']) / 'palomar-render'
          report = root / 'report.json'
          assert report.stat().st_size < 2 * 1024 * 1024
          print('PALOMAR_RENDER_REPORT_SHA256', hashlib.sha256(report.read_bytes()).hexdigest())
          print('PALOMAR_RENDER_REPORT_BEGIN')
          print(json.dumps(json.loads(report.read_text()), sort_keys=True))
          print('PALOMAR_RENDER_REPORT_END')
          result = root / 'result'
          hashes = {p.relative_to(result).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest()
                    for p in sorted(result.rglob('*')) if p.is_file()}
          assert len(hashes) <= 2000
          print('PALOMAR_RENDER_FILES_BEGIN')
          print(json.dumps(hashes, sort_keys=True))
          print('PALOMAR_RENDER_FILES_END')
          PYTHON
