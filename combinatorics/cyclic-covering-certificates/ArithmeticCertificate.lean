@[expose] def total (xs : List Nat) : Nat := xs.foldl Nat.add 0

@[expose] def entry (classIndex row column : Nat) : Nat :=
  ((representatives.getD classIndex []).getD row []).getD column 0

@[expose] def phaseAt (w : LinearWitness) (row column : Nat) : Nat :=
  (w.low.getD row 0 + 3 - entry w.classIndex row column % 3) % 3

@[expose] def coefficient (w : LinearWitness) (equation row : Nat) : Nat :=
  if phaseAt w row (equation / 3) = equation % 3 then 1 else 0

@[expose] def rhs (w : LinearWitness) (equation : Nat) : Nat :=
  total ((List.range 10).map (fun row =>
    coefficient w equation row *
      (entry w.classIndex row (equation / 3) / 3 +
        if w.low.getD row 0 < entry w.classIndex row (equation / 3) % 3 then 1 else 0))) % 3

@[expose] def validTrits (xs : List Nat) (n : Nat) : Bool :=
  decide (xs.length = n) && xs.all (fun x => decide (x < 3))

@[expose] def checkWitness (w : LinearWitness) : Bool :=
  decide (w.classIndex < 17) && validTrits w.low 10 && validTrits w.multiplier 15 &&
  (List.range 10).all (fun row => decide (
    total ((List.range 15).map (fun eq => w.multiplier.getD eq 0 * coefficient w eq row)) % 3 = 0)) &&
  decide (total ((List.range 15).map (fun eq => w.multiplier.getD eq 0 * rhs w eq)) % 3 = 1)

@[expose] def checkRepresentativeShapes : Bool :=
  decide (representatives.length = 17) && representatives.all (fun m =>
    decide (m.length = 10) && m.all (fun row =>
      decide (row.length = 5) && row.all (fun x => decide (x < 9))))

theorem representativeShapes : checkRepresentativeShapes = true := by decide

/-- Closed arithmetic facts only. The mathematical soundness bridge remains
    an explicit future obligation in FORMAL_SPECIFICATION.md. -/
theorem allSeventyOneLinearWitnesses :
    witnesses.length = 71 ∧ witnesses.all checkWitness = true := by decide

#print axioms representativeShapes
#print axioms allSeventyOneLinearWitnesses

end CoveringFormalRound3Linear
