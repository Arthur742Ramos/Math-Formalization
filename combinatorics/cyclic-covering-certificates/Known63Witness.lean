    pair and residue there is exactly one row with that difference. -/
theorem known_cyclic63_index_one (i j : Fin 7) (h : i ≠ j) (d : Fin 63) :
    ∃ r : Fin 63, delta63 i.val j.val r.val = d.val ∧
      ∀ t : Fin 63, delta63 i.val j.val t.val = d.val → t = r := by
  let r : Fin 63 := ⟨inverse63 i.val j.val d.val, (inverse_right i j h d).1⟩
  refine ⟨r, (inverse_right i j h d).2, ?_⟩
  intro t ht
  apply Fin.ext
  have hi := inverse_left i j h t
  rw [ht] at hi
  exact hi.symm

@[expose] def differenceCount3 (i j d : Nat) : Nat :=
  (List.range 5).foldl (fun total r => total +
    if (entry rows3 r j + 3 - entry rows3 r i) % 3 = d then 1 else 0) 0

theorem cyclic3_six_columns : ∀ i j : Fin 6, i ≠ j →
    ∀ d : Fin 3, 0 < differenceCount3 i.val j.val d.val := by decide

