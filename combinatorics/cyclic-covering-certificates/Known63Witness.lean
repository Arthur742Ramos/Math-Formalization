@[expose] def entry (rows : List (List Nat)) (r c : Nat) : Nat :=
  (rows.getD r []).getD c 0

@[expose] def delta63 (i j r : Nat) : Nat :=
  (entry rows63 r j + 63 - entry rows63 r i) % 63

@[expose] def inverse63 (i j d : Nat) : Nat :=
  (inverseRows.getD (7*i+j) []).getD d 0

theorem matrix63_dimensions : rows63.length = 63 ∧
    ∀ r : Fin 63, (rows63.getD r.val []).length = 7 ∧
      ∀ j : Fin 7, entry rows63 r.val j.val < 63 := by decide

/-- Every residue has an explicit bounded row preimage. -/
theorem inverse_right : ∀ i j : Fin 7, i ≠ j →
    ∀ d : Fin 63, inverse63 i.val j.val d.val < 63 ∧
      delta63 i.val j.val (inverse63 i.val j.val d.val) = d.val := by decide

/-- No two distinct rows have the same difference, checked by an inverse. -/
theorem inverse_left : ∀ i j : Fin 7, i ≠ j →
    ∀ r : Fin 63, inverse63 i.val j.val (delta63 i.val j.val r.val) = r.val := by decide

