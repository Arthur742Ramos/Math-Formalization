@[expose] def isPermutation (xs : List Nat) (n : Nat) : Bool :=
  xs.length == n && (List.range n).all (fun v => xs.count v == 1)

@[expose] def targetEntry (record : Record) (r j : Nat) : Nat :=
  (record.target.getD r []).getD j 0

@[expose] def repEntry (record : Record) (r j : Nat) : Nat :=
  (((representatives[record.representative]?).getD []).getD r []).getD j 0

@[expose] def validRecord (record : Record) : Bool :=
  record.target.length == 10 && record.target.all (fun row => row.length == 5) &&
  record.representative < 17 && [1,2,4,5,7,8].contains record.unit &&
  isPermutation record.rows 10 && isPermutation record.columns 5 &&
  (List.range 10).all (fun r => (List.range 5).all (fun j =>
    targetEntry record r j ==
    (record.unit * (repEntry record (record.rows.getD r 0) (record.columns.getD j 0) + 9 -
      repEntry record (record.rows.getD r 0) (record.columns.getD 0 0))) % 9))

theorem batchDimensions : representatives.size = 17 ∧ archivedTriangles.length = 128 ∧ records.length = 128 := by decide
theorem batchTriangleCoverage : records.map Record.triangle = archivedTriangles := by decide
theorem allBatchCertificatesValid : records.all validRecord = true := by decide
#print axioms batchDimensions
#print axioms batchTriangleCoverage
#print axioms allBatchCertificatesValid
