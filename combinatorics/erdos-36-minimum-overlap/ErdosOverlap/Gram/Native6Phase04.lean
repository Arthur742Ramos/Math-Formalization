@[expose] public section

namespace ErdosOverlap.Gram.Native6Phase04

open scoped BigOperators
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
set_option Elab.async false

def certificate : RawPhaseCertificate 71 where
  denominator := Native6Raw04.denominator
  diagonal := Native6Raw04.diagonal
  gamma := Native6Raw04.gamma
  nonnegative := Native6Raw04.nonnegative
  eta := Native6Raw04.eta
  triangles := Native6Raw04.triangles
  triangleTable := Native6Raw04.triangleTable
  cells_pos := by decide +kernel
  denominator_pos := Native6Raw04.denominator_pos
  diagonal_nonnegative := fun i => (Native6Raw04.nonnegative_multipliers i).1
  auxiliary_nonnegative := fun i => (Native6Raw04.nonnegative_multipliers i).2
  eta_nonnegative := Native6Raw04.eta_nonnegative
  triangles_valid := Native6Raw04.triangles_valid
  triangle_aggregation := Native6Raw04.triangle_aggregation
  full_nonnegative := by
    intro y hy
    simpa only [Native6Raw04.fullMatrix, Native6Raw04.fullInteger, Native6Raw04.scale_exact, Nat.cast_ofNat] using
      Native6Raw04.nonnegative_on_sum_zero y hy

theorem cells_exact : Native6Data.phase04.cells = 71 := rfl

theorem gamma_exact : certificate.gammaRational = Native6Data.phase04.gamma := by
  decide +kernel

theorem lower_exact : certificate.lowerRational = Native6Data.phase04.lowerAtZero := by
  change phaseLowerRational 71 Native6Raw04.denominator Native6Raw04.diagonal Native6Raw04.gamma
    Native6Raw04.nonnegative Native6Raw04.eta Native6Raw04.triangles = _
  rw [Native6Raw04.lower_exact]
  decide +kernel

theorem mean_exact : certificate.meanCoefficient = Native6Data.phase04.meanCoefficient := by
  decide +kernel

/-- Unconditional physical validity of the exact native phase row. -/
theorem functional_lower_bound {h : ℝ → ℝ} (hh : Admissible h) :
    (Native6Data.phase04.lowerAtZero : ℝ) + (Native6Data.phase04.meanCoefficient : ℝ) *
        profileMean (overlapProfile h)^2 ≤
      quartetFunctional h (phaseKernel Native6Data.phase04.cells Native6Data.phase04.gamma) := by
  have hbound := certificate.kernel_functional_lower_bound hh
  rw [gamma_exact, lower_exact, mean_exact] at hbound
  rw [cells_exact]
  exact hbound

end ErdosOverlap.Gram.Native6Phase04
