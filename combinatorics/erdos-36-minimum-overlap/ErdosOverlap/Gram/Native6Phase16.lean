module

public import ErdosOverlap.Gram.Native6Raw16
public import ErdosOverlap.Gram.RawPhasePhysical
public import ErdosOverlap.Certificate.Native6KernelData

/-!
# Physical signed-functional theorem for native phase row 16

Generated by `scripts/generate_gram_sos.py`.  Splitting exact decisions across
small, sequentially imported modules bounds the kernel's temporary memory.
-/

@[expose] public section

namespace ErdosOverlap.Gram.Native6Phase16

open scoped BigOperators
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
set_option Elab.async false

def certificate : RawPhaseCertificate 43 where
  denominator := Native6Raw16.denominator
  diagonal := Native6Raw16.diagonal
  gamma := Native6Raw16.gamma
  nonnegative := Native6Raw16.nonnegative
  eta := Native6Raw16.eta
  triangles := Native6Raw16.triangles
  triangleTable := Native6Raw16.triangleTable
  cells_pos := by decide +kernel
  denominator_pos := Native6Raw16.denominator_pos
  diagonal_nonnegative := fun i => (Native6Raw16.nonnegative_multipliers i).1
  auxiliary_nonnegative := fun i => (Native6Raw16.nonnegative_multipliers i).2
  eta_nonnegative := Native6Raw16.eta_nonnegative
  triangles_valid := Native6Raw16.triangles_valid
  triangle_aggregation := Native6Raw16.triangle_aggregation
  full_nonnegative := by
    intro y hy
    simpa only [Native6Raw16.fullMatrix, Native6Raw16.fullInteger, Native6Raw16.scale_exact, Nat.cast_ofNat] using
      Native6Raw16.nonnegative_on_sum_zero y hy

theorem cells_exact : Native6Data.phase16.cells = 43 := rfl

theorem gamma_exact : certificate.gammaRational = Native6Data.phase16.gamma := by
  decide +kernel

theorem lower_exact : certificate.lowerRational = Native6Data.phase16.lowerAtZero := by
  change phaseLowerRational 43 Native6Raw16.denominator Native6Raw16.diagonal Native6Raw16.gamma
    Native6Raw16.nonnegative Native6Raw16.eta Native6Raw16.triangles = _
  rw [Native6Raw16.lower_exact]
  decide +kernel

theorem mean_exact : certificate.meanCoefficient = Native6Data.phase16.meanCoefficient := by
  decide +kernel

/-- Unconditional physical validity of the exact native phase row. -/
theorem functional_lower_bound {h : ℝ → ℝ} (hh : Admissible h) :
    (Native6Data.phase16.lowerAtZero : ℝ) + (Native6Data.phase16.meanCoefficient : ℝ) *
        profileMean (overlapProfile h)^2 ≤
      quartetFunctional h (phaseKernel Native6Data.phase16.cells Native6Data.phase16.gamma) := by
  have hbound := certificate.kernel_functional_lower_bound hh
  rw [gamma_exact, lower_exact, mean_exact] at hbound
  rw [cells_exact]
  exact hbound

end ErdosOverlap.Gram.Native6Phase16
