@[expose] public section

namespace ErdosOverlap.Gram.Native6Phase06

open scoped BigOperators
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
set_option Elab.async false

def certificate : RawPhaseCertificate 89 where
  denominator := Native6Raw06.denominator
  diagonal := Native6Raw06.diagonal
  gamma := Native6Raw06.gamma
  nonnegative := Native6Raw06.nonnegative
  eta := Native6Raw06.eta
  triangles := Native6Raw06.triangles
  triangleTable := Native6Raw06.triangleTable
  cells_pos := by decide +kernel
  denominator_pos := Native6Raw06.denominator_pos
  diagonal_nonnegative := fun i => (Native6Raw06.nonnegative_multipliers i).1
  auxiliary_nonnegative := fun i => (Native6Raw06.nonnegative_multipliers i).2
  eta_nonnegative := Native6Raw06.eta_nonnegative
  triangles_valid := Native6Raw06.triangles_valid
  triangle_aggregation := Native6Raw06.triangle_aggregation
  full_nonnegative := by
    intro y hy
    simpa only [Native6Raw06.fullMatrix, Native6Raw06.fullInteger, Native6Raw06.scale_exact, Nat.cast_ofNat] using
      Native6Raw06.nonnegative_on_sum_zero y hy

theorem cells_exact : Native6Data.phase06.cells = 89 := rfl

theorem gamma_exact : certificate.gammaRational = Native6Data.phase06.gamma := by
  decide +kernel

theorem lower_exact : certificate.lowerRational = Native6Data.phase06.lowerAtZero := by
  change phaseLowerRational 89 Native6Raw06.denominator Native6Raw06.diagonal Native6Raw06.gamma
    Native6Raw06.nonnegative Native6Raw06.eta Native6Raw06.triangles = _
  rw [Native6Raw06.lower_exact]
  decide +kernel

theorem mean_exact : certificate.meanCoefficient = Native6Data.phase06.meanCoefficient := by
  decide +kernel

/-- Unconditional physical validity of the exact native phase row. -/
theorem functional_lower_bound {h : ℝ → ℝ} (hh : Admissible h) :
    (Native6Data.phase06.lowerAtZero : ℝ) + (Native6Data.phase06.meanCoefficient : ℝ) *
        profileMean (overlapProfile h)^2 ≤
      quartetFunctional h (phaseKernel Native6Data.phase06.cells Native6Data.phase06.gamma) := by
  have hbound := certificate.kernel_functional_lower_bound hh
  rw [gamma_exact, lower_exact, mean_exact] at hbound
  rw [cells_exact]
  exact hbound

end ErdosOverlap.Gram.Native6Phase06
