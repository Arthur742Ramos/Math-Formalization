theorem periodic052_value (t : ℝ) : affineJumpSum periodic052 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic052) t := by
  rw [periodic052_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic052_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic052_part00_eq, periodic052_part01_eq, periodic052_part02_eq, periodic052_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic052 = ((FrontierData.periodic052.drop 0).take 16) ++ ((FrontierData.periodic052.drop 16).take 16) ++ ((FrontierData.periodic052.drop 32).take 16) ++ ((FrontierData.periodic052.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
end ErdosOverlap.FrontierJumps
