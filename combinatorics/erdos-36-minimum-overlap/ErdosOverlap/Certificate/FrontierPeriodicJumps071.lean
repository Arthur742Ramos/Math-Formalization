theorem periodic071_value (t : ℝ) : affineJumpSum periodic071 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic071) t := by
  rw [periodic071_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic071_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic071_part00_eq, periodic071_part01_eq, periodic071_part02_eq, periodic071_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
