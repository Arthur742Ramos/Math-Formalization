def periodic16_blocks : List (List AffineJump) := [periodic16_part00, periodic16_part01, periodic16_part02, periodic16_part03, periodic16_part04, periodic16_part05, periodic16_part06]

theorem periodic16_compiled : periodic16 = compiledJumpBlocks periodic16_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic16_value (t : ℝ) : affineJumpSum periodic16 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic16) t := by
  rw [periodic16_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic16_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic16_part00_eq, periodic16_part01_eq, periodic16_part02_eq, periodic16_part03_eq, periodic16_part04_eq, periodic16_part05_eq, periodic16_part06_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic16 = ((Native6Data.native6Periodic16.drop 0).take 42) ++ ((Native6Data.native6Periodic16.drop 42).take 42) ++ ((Native6Data.native6Periodic16.drop 84).take 42) ++ ((Native6Data.native6Periodic16.drop 126).take 42) ++ ((Native6Data.native6Periodic16.drop 168).take 42) ++ ((Native6Data.native6Periodic16.drop 210).take 42) ++ ((Native6Data.native6Periodic16.drop 252).take 4) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
