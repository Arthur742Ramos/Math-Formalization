def periodic013_blocks : List (List AffineJump) := [periodic013_part00, periodic013_part01, periodic013_part02, periodic013_part03]

theorem periodic013_compiled : periodic013 = compiledJumpBlocks periodic013_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic013_value (t : ℝ) : affineJumpSum periodic013 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic013) t := by
  rw [periodic013_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic013_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic013_part00_eq, periodic013_part01_eq, periodic013_part02_eq, periodic013_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic013 = ((FrontierData.periodic013.drop 0).take 16) ++ ((FrontierData.periodic013.drop 16).take 16) ++ ((FrontierData.periodic013.drop 32).take 16) ++ ((FrontierData.periodic013.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
