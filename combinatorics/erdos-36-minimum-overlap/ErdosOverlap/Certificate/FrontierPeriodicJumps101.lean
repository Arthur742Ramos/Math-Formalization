def periodic101_blocks : List (List AffineJump) := [periodic101_part00, periodic101_part01, periodic101_part02, periodic101_part03]

theorem periodic101_compiled : periodic101 = compiledJumpBlocks periodic101_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic101_value (t : ℝ) : affineJumpSum periodic101 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic101) t := by
  rw [periodic101_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic101_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic101_part00_eq, periodic101_part01_eq, periodic101_part02_eq, periodic101_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic101 = ((FrontierData.periodic101.drop 0).take 16) ++ ((FrontierData.periodic101.drop 16).take 16) ++ ((FrontierData.periodic101.drop 32).take 16) ++ ((FrontierData.periodic101.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
