def periodic047_blocks : List (List AffineJump) := [periodic047_part00, periodic047_part01, periodic047_part02, periodic047_part03]

theorem periodic047_compiled : periodic047 = compiledJumpBlocks periodic047_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic047_value (t : ℝ) : affineJumpSum periodic047 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic047) t := by
  rw [periodic047_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic047_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic047_part00_eq, periodic047_part01_eq, periodic047_part02_eq, periodic047_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic047 = ((FrontierData.periodic047.drop 0).take 16) ++ ((FrontierData.periodic047.drop 16).take 16) ++ ((FrontierData.periodic047.drop 32).take 16) ++ ((FrontierData.periodic047.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
