def periodic075_blocks : List (List AffineJump) := [periodic075_part00, periodic075_part01, periodic075_part02, periodic075_part03]

theorem periodic075_compiled : periodic075 = compiledJumpBlocks periodic075_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic075_value (t : ℝ) : affineJumpSum periodic075 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic075) t := by
  rw [periodic075_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic075_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic075_part00_eq, periodic075_part01_eq, periodic075_part02_eq, periodic075_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic075 = ((FrontierData.periodic075.drop 0).take 16) ++ ((FrontierData.periodic075.drop 16).take 16) ++ ((FrontierData.periodic075.drop 32).take 16) ++ ((FrontierData.periodic075.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

