def periodic05_blocks : List (List AffineJump) := [periodic05_part00, periodic05_part01, periodic05_part02, periodic05_part03]

theorem periodic05_compiled : periodic05 = compiledJumpBlocks periodic05_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic05_value (t : ℝ) : affineJumpSum periodic05 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic05) t := by
  rw [periodic05_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic05_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic05_part00_eq, periodic05_part01_eq, periodic05_part02_eq, periodic05_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic05 = ((Native6Data.native6Periodic05.drop 0).take 64) ++ ((Native6Data.native6Periodic05.drop 64).take 64) ++ ((Native6Data.native6Periodic05.drop 128).take 64) ++ ((Native6Data.native6Periodic05.drop 192).take 64) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
