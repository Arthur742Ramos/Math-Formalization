theorem periodic068_value (t : ℝ) : affineJumpSum periodic068 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic068) t := by
  rw [periodic068_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic068_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic068_part00_eq, periodic068_part01_eq, periodic068_part02_eq, periodic068_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
