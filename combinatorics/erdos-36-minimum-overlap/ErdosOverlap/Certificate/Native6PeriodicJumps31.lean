theorem periodic31_value (t : ℝ) : affineJumpSum periodic31 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic31) t := by
  rw [periodic31_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic31_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic31_part00_eq, periodic31_part01_eq, periodic31_part02_eq, periodic31_part03_eq, periodic31_part04_eq, periodic31_part05_eq, periodic31_part06_eq, periodic31_part07_eq, periodic31_part08_eq, periodic31_part09_eq, periodic31_part10_eq, periodic31_part11_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
