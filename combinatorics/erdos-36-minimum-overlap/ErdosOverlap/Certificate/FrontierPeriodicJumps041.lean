def periodic041_blocks : List (List AffineJump) := [periodic041_part00, periodic041_part01, periodic041_part02, periodic041_part03]

theorem periodic041_compiled : periodic041 = compiledJumpBlocks periodic041_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic041_value (t : ℝ) : affineJumpSum periodic041 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic041) t := by
  rw [periodic041_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic041_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic041_part00_eq, periodic041_part01_eq, periodic041_part02_eq, periodic041_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic041 = ((FrontierData.periodic041.drop 0).take 16) ++ ((FrontierData.periodic041.drop 16).take 16) ++ ((FrontierData.periodic041.drop 32).take 16) ++ ((FrontierData.periodic041.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
