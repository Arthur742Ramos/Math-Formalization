def nodes01 : List PLNode := densePLNodes 16178 values01

theorem nodes01_valid : PLValid 16384 nodes01 := by
  decide +kernel

theorem nodes01_mass : plMass nodes01 = 290475099599202 := by
  decide +kernel

def v01 : ℝ → ℝ := plWitness 16384 1000000000000000000 nodes01

def tau01 : ℚ := (174759880435807 / 1000000000000000000 : ℚ)
def Iv01 : ℚ := (17729193090771607 / 1000000000000000000000000 : ℚ)
def exactCost01 : ℚ := (145237549799601 / 8192000000000000000000 : ℚ)
def tauNumerator01 : ℤ := 174759880435807

theorem exactCost01_le : exactCost01 ≤ Iv01 := by
  decide +kernel

theorem v01_absolutelyContinuous : AbsolutelyContinuousOnInterval v01 0 1 :=
  plWitness_absolutelyContinuous 16384 1000000000000000000 nodes01

theorem v01_one : v01 1 = 0 := plWitness_one nodes01_valid
theorem v01_zero : v01 0 = 0 := plWitness_zero nodes01_valid

theorem v01_integral_abs : (∫ t in (0 : ℝ)..1, |v01 t|) = (exactCost01 : ℝ) := by
  change (∫ t in (0 : ℝ)..1, |plWitness 16384 1000000000000000000 nodes01 t|) = _
  rw [plWitness_integral_abs (by norm_num) (by norm_num) nodes01_valid, nodes01_mass]
  norm_num [exactCost01]

theorem v01_integral_abs_le : (∫ t in (0 : ℝ)..1, |v01 t|) ≤ (Iv01 : ℝ) := by
  rw [v01_integral_abs]
  exact_mod_cast exactCost01_le

