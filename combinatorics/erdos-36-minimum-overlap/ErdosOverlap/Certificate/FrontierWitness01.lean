theorem slopeCache01_checked :
    slopeCache01.check 16384 nodes01 tauNumerator01 = true := by
  apply PLSlopeCache.check_of_dense slopeCache01 16384 nodes01 tauNumerator01 values01
  · rfl
  · decide +kernel

theorem slopeCache01_prefix : ∀ p ∈ nodes01,
    slopeCache01.firstCell+1 ≤ p.index := by
  decide +kernel

theorem dualSlope01_before {l r : ℝ}
    (hr : r ≤ (16177 : ℝ)/16384) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau01 : ℝ) v01 t = 2*(tau01 : ℝ) := by
  exact plWitness_ae_dualSlope_before (by norm_num : 0 < 16384)
    1000000000000000000 nodes01 slopeCache01.firstCell
    (tau01 : ℝ) slopeCache01_prefix hr

theorem dualSlope01_on_leaf {j : ℕ} (hj : j < slopeCache01.numerators.size)
    {l r : ℝ} (hl : (((slopeCache01.firstCell+j : ℕ) : ℝ)/16384) ≤ l)
    (hr : r ≤ ((((slopeCache01.firstCell+j : ℕ) : ℝ)+1)/16384)) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau01 : ℝ) v01 t = (slopeCache01.value 1000000000000000000 j : ℝ) := by
  have htau : (tau01 : ℝ) = ((tauNumerator01 : ℤ) : ℝ) / 1000000000000000000 := by
    norm_num [tauNumerator01, tau01]
  rw [htau]
  exact slopeCache01.ae_dualSlope_on_leaf (by norm_num : 0 < 16384)
    1000000000000000000 nodes01 tauNumerator01 slopeCache01_checked hj hl hr

