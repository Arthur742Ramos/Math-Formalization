def periodic080_blocks : List (List AffineJump) := [periodic080_part00, periodic080_part01, periodic080_part02, periodic080_part03]

theorem periodic080_compiled : periodic080 = compiledJumpBlocks periodic080_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic080_value (t : ℝ) : affineJumpSum periodic080 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic080) t := by
  rw [periodic080_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic080_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic080_part00_eq, periodic080_part01_eq, periodic080_part02_eq, periodic080_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic080 = ((FrontierData.periodic080.drop 0).take 16) ++ ((FrontierData.periodic080.drop 16).take 16) ++ ((FrontierData.periodic080.drop 32).take 16) ++ ((FrontierData.periodic080.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
