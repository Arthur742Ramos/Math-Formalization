def periodic098_blocks : List (List AffineJump) := [periodic098_part00, periodic098_part01, periodic098_part02, periodic098_part03]

theorem periodic098_compiled : periodic098 = compiledJumpBlocks periodic098_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic098_value (t : ℝ) : affineJumpSum periodic098 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic098) t := by
  rw [periodic098_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic098_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic098_part00_eq, periodic098_part01_eq, periodic098_part02_eq, periodic098_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic098 = ((FrontierData.periodic098.drop 0).take 16) ++ ((FrontierData.periodic098.drop 16).take 16) ++ ((FrontierData.periodic098.drop 32).take 16) ++ ((FrontierData.periodic098.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
