def periodic08_blocks : List (List AffineJump) := [periodic08_part00, periodic08_part01, periodic08_part02, periodic08_part03]

theorem periodic08_compiled : periodic08 = compiledJumpBlocks periodic08_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic08_value (t : ℝ) : affineJumpSum periodic08 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic08) t := by
  rw [periodic08_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic08_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic08_part00_eq, periodic08_part01_eq, periodic08_part02_eq, periodic08_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic08 = ((Native6Data.native6Periodic08.drop 0).take 64) ++ ((Native6Data.native6Periodic08.drop 64).take 64) ++ ((Native6Data.native6Periodic08.drop 128).take 64) ++ ((Native6Data.native6Periodic08.drop 192).take 64) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
