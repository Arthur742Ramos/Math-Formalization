  simp only [periodic033_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic033_part00_eq, periodic033_part01_eq, periodic033_part02_eq, periodic033_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic033 = ((FrontierData.periodic033.drop 0).take 16) ++ ((FrontierData.periodic033.drop 16).take 16) ++ ((FrontierData.periodic033.drop 32).take 16) ++ ((FrontierData.periodic033.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
