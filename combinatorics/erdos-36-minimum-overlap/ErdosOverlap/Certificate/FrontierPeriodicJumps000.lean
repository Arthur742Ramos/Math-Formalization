def periodic000_blocks : List (List AffineJump) := [periodic000_part00, periodic000_part01, periodic000_part02, periodic000_part03]

theorem periodic000_compiled : periodic000 = compiledJumpBlocks periodic000_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic000_value (t : ℝ) : affineJumpSum periodic000 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic000) t := by
  rw [periodic000_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic000_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic000_part00_eq, periodic000_part01_eq, periodic000_part02_eq, periodic000_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic000 = ((FrontierData.periodic000.drop 0).take 16) ++ ((FrontierData.periodic000.drop 16).take 16) ++ ((FrontierData.periodic000.drop 32).take 16) ++ ((FrontierData.periodic000.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
