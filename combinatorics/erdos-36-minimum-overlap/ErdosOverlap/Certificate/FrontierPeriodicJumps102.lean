def periodic102_blocks : List (List AffineJump) := [periodic102_part00, periodic102_part01, periodic102_part02, periodic102_part03]

theorem periodic102_compiled : periodic102 = compiledJumpBlocks periodic102_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic102_value (t : ℝ) : affineJumpSum periodic102 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic102) t := by
  rw [periodic102_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic102_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic102_part00_eq, periodic102_part01_eq, periodic102_part02_eq, periodic102_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic102 = ((FrontierData.periodic102.drop 0).take 16) ++ ((FrontierData.periodic102.drop 16).take 16) ++ ((FrontierData.periodic102.drop 32).take 16) ++ ((FrontierData.periodic102.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
