def periodic099_blocks : List (List AffineJump) := [periodic099_part00, periodic099_part01, periodic099_part02, periodic099_part03]

theorem periodic099_compiled : periodic099 = compiledJumpBlocks periodic099_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic099_value (t : ℝ) : affineJumpSum periodic099 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic099) t := by
  rw [periodic099_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic099_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic099_part00_eq, periodic099_part01_eq, periodic099_part02_eq, periodic099_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic099 = ((FrontierData.periodic099.drop 0).take 16) ++ ((FrontierData.periodic099.drop 16).take 16) ++ ((FrontierData.periodic099.drop 32).take 16) ++ ((FrontierData.periodic099.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
