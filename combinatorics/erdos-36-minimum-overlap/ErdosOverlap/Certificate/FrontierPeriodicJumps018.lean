def periodic018_blocks : List (List AffineJump) := [periodic018_part00, periodic018_part01, periodic018_part02, periodic018_part03]

theorem periodic018_compiled : periodic018 = compiledJumpBlocks periodic018_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic018_value (t : ℝ) : affineJumpSum periodic018 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic018) t := by
  rw [periodic018_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic018_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic018_part00_eq, periodic018_part01_eq, periodic018_part02_eq, periodic018_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic018 = ((FrontierData.periodic018.drop 0).take 16) ++ ((FrontierData.periodic018.drop 16).take 16) ++ ((FrontierData.periodic018.drop 32).take 16) ++ ((FrontierData.periodic018.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
