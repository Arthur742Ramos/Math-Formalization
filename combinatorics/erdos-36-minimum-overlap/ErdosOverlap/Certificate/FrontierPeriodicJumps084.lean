def periodic084_blocks : List (List AffineJump) := [periodic084_part00, periodic084_part01, periodic084_part02, periodic084_part03]

theorem periodic084_compiled : periodic084 = compiledJumpBlocks periodic084_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic084_value (t : ℝ) : affineJumpSum periodic084 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic084) t := by
  rw [periodic084_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic084_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic084_part00_eq, periodic084_part01_eq, periodic084_part02_eq, periodic084_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic084 = ((FrontierData.periodic084.drop 0).take 16) ++ ((FrontierData.periodic084.drop 16).take 16) ++ ((FrontierData.periodic084.drop 32).take 16) ++ ((FrontierData.periodic084.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
