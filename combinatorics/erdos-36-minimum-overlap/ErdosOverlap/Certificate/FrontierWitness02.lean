theorem slopeCache02_checked :
    slopeCache02.check 16384 nodes02 tauNumerator02 = true := by
  apply PLSlopeCache.check_of_dense slopeCache02 16384 nodes02 tauNumerator02 values02
  · rfl
  · decide +kernel

theorem slopeCache02_prefix : ∀ p ∈ nodes02,
    slopeCache02.firstCell+1 ≤ p.index := by
  decide +kernel

theorem dualSlope02_before {l r : ℝ}
    (hr : r ≤ (16151 : ℝ)/16384) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau02 : ℝ) v02 t = 2*(tau02 : ℝ) := by
  exact plWitness_ae_dualSlope_before (by norm_num : 0 < 16384)
    1000000000000000000 nodes02 slopeCache02.firstCell
    (tau02 : ℝ) slopeCache02_prefix hr

theorem dualSlope02_on_leaf {j : ℕ} (hj : j < slopeCache02.numerators.size)
    {l r : ℝ} (hl : (((slopeCache02.firstCell+j : ℕ) : ℝ)/16384) ≤ l)
    (hr : r ≤ ((((slopeCache02.firstCell+j : ℕ) : ℝ)+1)/16384)) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau02 : ℝ) v02 t = (slopeCache02.value 1000000000000000000 j : ℝ) := by
  have htau : (tau02 : ℝ) = ((tauNumerator02 : ℤ) : ℝ) / 1000000000000000000 := by
    norm_num [tauNumerator02, tau02]
  rw [htau]
  exact slopeCache02.ae_dualSlope_on_leaf (by norm_num : 0 < 16384)
    1000000000000000000 nodes02 tauNumerator02 slopeCache02_checked hj hl hr

