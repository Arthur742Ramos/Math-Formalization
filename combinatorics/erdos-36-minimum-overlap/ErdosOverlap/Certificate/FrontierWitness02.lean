def nodes02 : List PLNode := densePLNodes 16152 values02

theorem nodes02_valid : PLValid 16384 nodes02 := by
  decide +kernel

theorem nodes02_mass : plMass nodes02 = 630787582694656 := by
  decide +kernel

def v02 : ℝ → ℝ := plWitness 16384 1000000000000000000 nodes02

def tau02 : ℚ := (1808685929653 / 6250000000000000 : ℚ)
def Iv02 : ℚ := (2464013994901 / 64000000000000000000 : ℚ)
def exactCost02 : ℚ := (2464013994901 / 64000000000000000000 : ℚ)
def tauNumerator02 : ℤ := 289389748744480

theorem exactCost02_le : exactCost02 ≤ Iv02 := by
  decide +kernel

theorem v02_absolutelyContinuous : AbsolutelyContinuousOnInterval v02 0 1 :=
  plWitness_absolutelyContinuous 16384 1000000000000000000 nodes02

theorem v02_one : v02 1 = 0 := plWitness_one nodes02_valid
theorem v02_zero : v02 0 = 0 := plWitness_zero nodes02_valid

theorem v02_integral_abs : (∫ t in (0 : ℝ)..1, |v02 t|) = (exactCost02 : ℝ) := by
  change (∫ t in (0 : ℝ)..1, |plWitness 16384 1000000000000000000 nodes02 t|) = _
  rw [plWitness_integral_abs (by norm_num) (by norm_num) nodes02_valid, nodes02_mass]
  norm_num [exactCost02]

theorem v02_integral_abs_le : (∫ t in (0 : ℝ)..1, |v02 t|) ≤ (Iv02 : ℝ) := by
  rw [v02_integral_abs]
  exact_mod_cast exactCost02_le

