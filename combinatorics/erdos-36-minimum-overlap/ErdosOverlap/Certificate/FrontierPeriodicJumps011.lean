def periodic011_blocks : List (List AffineJump) := [periodic011_part00, periodic011_part01, periodic011_part02, periodic011_part03]

theorem periodic011_compiled : periodic011 = compiledJumpBlocks periodic011_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic011_value (t : ℝ) : affineJumpSum periodic011 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic011) t := by
  rw [periodic011_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic011_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic011_part00_eq, periodic011_part01_eq, periodic011_part02_eq, periodic011_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic011 = ((FrontierData.periodic011.drop 0).take 16) ++ ((FrontierData.periodic011.drop 16).take 16) ++ ((FrontierData.periodic011.drop 32).take 16) ++ ((FrontierData.periodic011.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
