def periodic050_blocks : List (List AffineJump) := [periodic050_part00, periodic050_part01, periodic050_part02, periodic050_part03]

theorem periodic050_compiled : periodic050 = compiledJumpBlocks periodic050_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic050_value (t : ℝ) : affineJumpSum periodic050 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic050) t := by
  rw [periodic050_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic050_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic050_part00_eq, periodic050_part01_eq, periodic050_part02_eq, periodic050_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic050 = ((FrontierData.periodic050.drop 0).take 16) ++ ((FrontierData.periodic050.drop 16).take 16) ++ ((FrontierData.periodic050.drop 32).take 16) ++ ((FrontierData.periodic050.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
