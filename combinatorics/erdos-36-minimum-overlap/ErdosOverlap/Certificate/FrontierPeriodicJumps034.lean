def periodic034_blocks : List (List AffineJump) := [periodic034_part00, periodic034_part01, periodic034_part02, periodic034_part03]

theorem periodic034_compiled : periodic034 = compiledJumpBlocks periodic034_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic034_value (t : ℝ) : affineJumpSum periodic034 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic034) t := by
  rw [periodic034_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic034_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic034_part00_eq, periodic034_part01_eq, periodic034_part02_eq, periodic034_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic034 = ((FrontierData.periodic034.drop 0).take 16) ++ ((FrontierData.periodic034.drop 16).take 16) ++ ((FrontierData.periodic034.drop 32).take 16) ++ ((FrontierData.periodic034.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
end ErdosOverlap.FrontierJumps
