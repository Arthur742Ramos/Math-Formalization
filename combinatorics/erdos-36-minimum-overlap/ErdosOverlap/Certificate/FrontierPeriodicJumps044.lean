def periodic044_blocks : List (List AffineJump) := [periodic044_part00, periodic044_part01, periodic044_part02, periodic044_part03]

theorem periodic044_compiled : periodic044 = compiledJumpBlocks periodic044_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic044_value (t : ℝ) : affineJumpSum periodic044 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic044) t := by
  rw [periodic044_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic044_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic044_part00_eq, periodic044_part01_eq, periodic044_part02_eq, periodic044_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic044 = ((FrontierData.periodic044.drop 0).take 16) ++ ((FrontierData.periodic044.drop 16).take 16) ++ ((FrontierData.periodic044.drop 32).take 16) ++ ((FrontierData.periodic044.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
