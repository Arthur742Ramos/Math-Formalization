def periodic030_blocks : List (List AffineJump) := [periodic030_part00, periodic030_part01, periodic030_part02, periodic030_part03]

theorem periodic030_compiled : periodic030 = compiledJumpBlocks periodic030_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic030_value (t : ℝ) : affineJumpSum periodic030 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic030) t := by
  rw [periodic030_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic030_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic030_part00_eq, periodic030_part01_eq, periodic030_part02_eq, periodic030_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic030 = ((FrontierData.periodic030.drop 0).take 16) ++ ((FrontierData.periodic030.drop 16).take 16) ++ ((FrontierData.periodic030.drop 32).take 16) ++ ((FrontierData.periodic030.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
