def periodic100_blocks : List (List AffineJump) := [periodic100_part00, periodic100_part01, periodic100_part02, periodic100_part03]

theorem periodic100_compiled : periodic100 = compiledJumpBlocks periodic100_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic100_value (t : ℝ) : affineJumpSum periodic100 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic100) t := by
  rw [periodic100_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic100_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic100_part00_eq, periodic100_part01_eq, periodic100_part02_eq, periodic100_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic100 = ((FrontierData.periodic100.drop 0).take 16) ++ ((FrontierData.periodic100.drop 16).take 16) ++ ((FrontierData.periodic100.drop 32).take 16) ++ ((FrontierData.periodic100.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
