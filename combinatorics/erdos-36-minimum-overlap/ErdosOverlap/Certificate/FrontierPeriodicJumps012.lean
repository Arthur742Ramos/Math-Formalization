def periodic012_blocks : List (List AffineJump) := [periodic012_part00, periodic012_part01, periodic012_part02, periodic012_part03]

theorem periodic012_compiled : periodic012 = compiledJumpBlocks periodic012_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic012_value (t : ℝ) : affineJumpSum periodic012 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic012) t := by
  rw [periodic012_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic012_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic012_part00_eq, periodic012_part01_eq, periodic012_part02_eq, periodic012_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic012 = ((FrontierData.periodic012.drop 0).take 16) ++ ((FrontierData.periodic012.drop 16).take 16) ++ ((FrontierData.periodic012.drop 32).take 16) ++ ((FrontierData.periodic012.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
