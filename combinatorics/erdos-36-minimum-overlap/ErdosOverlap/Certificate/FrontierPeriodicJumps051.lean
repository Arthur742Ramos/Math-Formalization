def periodic051_blocks : List (List AffineJump) := [periodic051_part00, periodic051_part01, periodic051_part02, periodic051_part03]

theorem periodic051_compiled : periodic051 = compiledJumpBlocks periodic051_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic051_value (t : ℝ) : affineJumpSum periodic051 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic051) t := by
  rw [periodic051_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic051_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic051_part00_eq, periodic051_part01_eq, periodic051_part02_eq, periodic051_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic051 = ((FrontierData.periodic051.drop 0).take 16) ++ ((FrontierData.periodic051.drop 16).take 16) ++ ((FrontierData.periodic051.drop 32).take 16) ++ ((FrontierData.periodic051.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
