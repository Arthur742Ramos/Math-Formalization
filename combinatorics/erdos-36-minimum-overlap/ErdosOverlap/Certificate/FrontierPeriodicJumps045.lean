def periodic045_blocks : List (List AffineJump) := [periodic045_part00, periodic045_part01, periodic045_part02, periodic045_part03]

theorem periodic045_compiled : periodic045 = compiledJumpBlocks periodic045_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic045_value (t : ℝ) : affineJumpSum periodic045 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic045) t := by
  rw [periodic045_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic045_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic045_part00_eq, periodic045_part01_eq, periodic045_part02_eq, periodic045_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic045 = ((FrontierData.periodic045.drop 0).take 16) ++ ((FrontierData.periodic045.drop 16).take 16) ++ ((FrontierData.periodic045.drop 32).take 16) ++ ((FrontierData.periodic045.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
