def periodic063_blocks : List (List AffineJump) := [periodic063_part00, periodic063_part01, periodic063_part02, periodic063_part03]

theorem periodic063_compiled : periodic063 = compiledJumpBlocks periodic063_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic063_value (t : ℝ) : affineJumpSum periodic063 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic063) t := by
  rw [periodic063_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic063_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic063_part00_eq, periodic063_part01_eq, periodic063_part02_eq, periodic063_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic063 = ((FrontierData.periodic063.drop 0).take 16) ++ ((FrontierData.periodic063.drop 16).take 16) ++ ((FrontierData.periodic063.drop 32).take 16) ++ ((FrontierData.periodic063.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
