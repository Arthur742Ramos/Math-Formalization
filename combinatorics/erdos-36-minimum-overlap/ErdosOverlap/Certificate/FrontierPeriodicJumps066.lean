def periodic066_blocks : List (List AffineJump) := [periodic066_part00, periodic066_part01, periodic066_part02, periodic066_part03]

theorem periodic066_compiled : periodic066 = compiledJumpBlocks periodic066_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic066_value (t : ℝ) : affineJumpSum periodic066 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic066) t := by
  rw [periodic066_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic066_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic066_part00_eq, periodic066_part01_eq, periodic066_part02_eq, periodic066_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic066 = ((FrontierData.periodic066.drop 0).take 16) ++ ((FrontierData.periodic066.drop 16).take 16) ++ ((FrontierData.periodic066.drop 32).take 16) ++ ((FrontierData.periodic066.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
