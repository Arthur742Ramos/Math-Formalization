def periodic042_blocks : List (List AffineJump) := [periodic042_part00, periodic042_part01, periodic042_part02, periodic042_part03]

theorem periodic042_compiled : periodic042 = compiledJumpBlocks periodic042_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic042_value (t : ℝ) : affineJumpSum periodic042 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic042) t := by
  rw [periodic042_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic042_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic042_part00_eq, periodic042_part01_eq, periodic042_part02_eq, periodic042_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic042 = ((FrontierData.periodic042.drop 0).take 16) ++ ((FrontierData.periodic042.drop 16).take 16) ++ ((FrontierData.periodic042.drop 32).take 16) ++ ((FrontierData.periodic042.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
