def periodic067_blocks : List (List AffineJump) := [periodic067_part00, periodic067_part01, periodic067_part02, periodic067_part03]

theorem periodic067_compiled : periodic067 = compiledJumpBlocks periodic067_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic067_value (t : ℝ) : affineJumpSum periodic067 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic067) t := by
  rw [periodic067_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic067_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic067_part00_eq, periodic067_part01_eq, periodic067_part02_eq, periodic067_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic067 = ((FrontierData.periodic067.drop 0).take 16) ++ ((FrontierData.periodic067.drop 16).take 16) ++ ((FrontierData.periodic067.drop 32).take 16) ++ ((FrontierData.periodic067.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
