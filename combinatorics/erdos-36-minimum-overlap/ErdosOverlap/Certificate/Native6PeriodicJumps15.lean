def periodic15_blocks : List (List AffineJump) := [periodic15_part00, periodic15_part01, periodic15_part02, periodic15_part03, periodic15_part04]

theorem periodic15_compiled : periodic15 = compiledJumpBlocks periodic15_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic15_value (t : ℝ) : affineJumpSum periodic15 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic15) t := by
  rw [periodic15_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic15_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic15_part00_eq, periodic15_part01_eq, periodic15_part02_eq, periodic15_part03_eq, periodic15_part04_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic15 = ((Native6Data.native6Periodic15.drop 0).take 64) ++ ((Native6Data.native6Periodic15.drop 64).take 64) ++ ((Native6Data.native6Periodic15.drop 128).take 63) ++ ((Native6Data.native6Periodic15.drop 191).take 42) ++ ((Native6Data.native6Periodic15.drop 233).take 23) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
