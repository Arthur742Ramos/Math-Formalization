def periodic087_blocks : List (List AffineJump) := [periodic087_part00, periodic087_part01, periodic087_part02, periodic087_part03]

theorem periodic087_compiled : periodic087 = compiledJumpBlocks periodic087_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic087_value (t : ℝ) : affineJumpSum periodic087 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic087) t := by
  rw [periodic087_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic087_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic087_part00_eq, periodic087_part01_eq, periodic087_part02_eq, periodic087_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic087 = ((FrontierData.periodic087.drop 0).take 16) ++ ((FrontierData.periodic087.drop 16).take 16) ++ ((FrontierData.periodic087.drop 32).take 16) ++ ((FrontierData.periodic087.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
