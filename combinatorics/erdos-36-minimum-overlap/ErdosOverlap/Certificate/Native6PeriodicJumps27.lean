theorem periodic27_value (t : ℝ) : affineJumpSum periodic27 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic27) t := by
  rw [periodic27_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic27_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic27_part00_eq, periodic27_part01_eq, periodic27_part02_eq, periodic27_part03_eq, periodic27_part04_eq, periodic27_part05_eq, periodic27_part06_eq, periodic27_part07_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
