def periodic043_blocks : List (List AffineJump) := [periodic043_part00, periodic043_part01, periodic043_part02, periodic043_part03]

theorem periodic043_compiled : periodic043 = compiledJumpBlocks periodic043_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic043_value (t : ℝ) : affineJumpSum periodic043 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic043) t := by
  rw [periodic043_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic043_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic043_part00_eq, periodic043_part01_eq, periodic043_part02_eq, periodic043_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic043 = ((FrontierData.periodic043.drop 0).take 16) ++ ((FrontierData.periodic043.drop 16).take 16) ++ ((FrontierData.periodic043.drop 32).take 16) ++ ((FrontierData.periodic043.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
