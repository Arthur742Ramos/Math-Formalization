def periodic060_blocks : List (List AffineJump) := [periodic060_part00, periodic060_part01, periodic060_part02, periodic060_part03]

theorem periodic060_compiled : periodic060 = compiledJumpBlocks periodic060_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic060_value (t : ℝ) : affineJumpSum periodic060 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic060) t := by
  rw [periodic060_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic060_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic060_part00_eq, periodic060_part01_eq, periodic060_part02_eq, periodic060_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic060 = ((FrontierData.periodic060.drop 0).take 16) ++ ((FrontierData.periodic060.drop 16).take 16) ++ ((FrontierData.periodic060.drop 32).take 16) ++ ((FrontierData.periodic060.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
