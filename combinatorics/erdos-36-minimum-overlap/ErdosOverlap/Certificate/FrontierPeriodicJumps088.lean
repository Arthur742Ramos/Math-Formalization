def periodic088_blocks : List (List AffineJump) := [periodic088_part00, periodic088_part01, periodic088_part02, periodic088_part03]

theorem periodic088_compiled : periodic088 = compiledJumpBlocks periodic088_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic088_value (t : ℝ) : affineJumpSum periodic088 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic088) t := by
  rw [periodic088_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic088_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic088_part00_eq, periodic088_part01_eq, periodic088_part02_eq, periodic088_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic088 = ((FrontierData.periodic088.drop 0).take 16) ++ ((FrontierData.periodic088.drop 16).take 16) ++ ((FrontierData.periodic088.drop 32).take 16) ++ ((FrontierData.periodic088.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
