  have hparts : FrontierData.periodic032 = ((FrontierData.periodic032.drop 0).take 16) ++ ((FrontierData.periodic032.drop 16).take 16) ++ ((FrontierData.periodic032.drop 32).take 16) ++ ((FrontierData.periodic032.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
