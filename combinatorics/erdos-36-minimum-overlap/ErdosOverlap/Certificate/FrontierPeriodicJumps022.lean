def periodic022_blocks : List (List AffineJump) := [periodic022_part00, periodic022_part01, periodic022_part02, periodic022_part03]

theorem periodic022_compiled : periodic022 = compiledJumpBlocks periodic022_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic022_value (t : ℝ) : affineJumpSum periodic022 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic022) t := by
  rw [periodic022_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic022_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic022_part00_eq, periodic022_part01_eq, periodic022_part02_eq, periodic022_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic022 = ((FrontierData.periodic022.drop 0).take 16) ++ ((FrontierData.periodic022.drop 16).take 16) ++ ((FrontierData.periodic022.drop 32).take 16) ++ ((FrontierData.periodic022.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
