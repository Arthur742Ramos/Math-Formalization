theorem periodic076_compiled : periodic076 = compiledJumpBlocks periodic076_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic076_value (t : ℝ) : affineJumpSum periodic076 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic076) t := by
  rw [periodic076_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic076_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic076_part00_eq, periodic076_part01_eq, periodic076_part02_eq, periodic076_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic076 = ((FrontierData.periodic076.drop 0).take 16) ++ ((FrontierData.periodic076.drop 16).take 16) ++ ((FrontierData.periodic076.drop 32).take 16) ++ ((FrontierData.periodic076.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
