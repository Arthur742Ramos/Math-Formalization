def periodic002_blocks : List (List AffineJump) := [periodic002_part00, periodic002_part01, periodic002_part02, periodic002_part03]

theorem periodic002_compiled : periodic002 = compiledJumpBlocks periodic002_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic002_value (t : ℝ) : affineJumpSum periodic002 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic002) t := by
  rw [periodic002_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic002_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic002_part00_eq, periodic002_part01_eq, periodic002_part02_eq, periodic002_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic002 = ((FrontierData.periodic002.drop 0).take 16) ++ ((FrontierData.periodic002.drop 16).take 16) ++ ((FrontierData.periodic002.drop 32).take 16) ++ ((FrontierData.periodic002.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
