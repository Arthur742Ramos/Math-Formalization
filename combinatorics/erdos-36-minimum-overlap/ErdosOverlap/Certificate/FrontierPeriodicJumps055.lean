def periodic055_blocks : List (List AffineJump) := [periodic055_part00, periodic055_part01, periodic055_part02, periodic055_part03]

theorem periodic055_compiled : periodic055 = compiledJumpBlocks periodic055_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic055_value (t : ℝ) : affineJumpSum periodic055 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic055) t := by
  rw [periodic055_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic055_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic055_part00_eq, periodic055_part01_eq, periodic055_part02_eq, periodic055_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic055 = ((FrontierData.periodic055.drop 0).take 16) ++ ((FrontierData.periodic055.drop 16).take 16) ++ ((FrontierData.periodic055.drop 32).take 16) ++ ((FrontierData.periodic055.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
