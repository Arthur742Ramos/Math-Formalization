def nodes09 : List PLNode := densePLNodes 16161 values09

theorem nodes09_valid : PLValid 16384 nodes09 := by
  decide +kernel

theorem nodes09_mass : plMass nodes09 = 496479559103963 := by
  decide +kernel

def v09 : ℝ → ℝ := plWitness 16384 1000000000000000000 nodes09

def tau09 : ℚ := (247258610695001 / 1000000000000000000 : ℚ)
def Iv09 : ℚ := (7575676866210373 / 250000000000000000000000 : ℚ)
def exactCost09 : ℚ := (496479559103963 / 16384000000000000000000 : ℚ)
def tauNumerator09 : ℤ := 247258610695001

theorem exactCost09_le : exactCost09 ≤ Iv09 := by
  decide +kernel

theorem v09_absolutelyContinuous : AbsolutelyContinuousOnInterval v09 0 1 :=
  plWitness_absolutelyContinuous 16384 1000000000000000000 nodes09

theorem v09_one : v09 1 = 0 := plWitness_one nodes09_valid
theorem v09_zero : v09 0 = 0 := plWitness_zero nodes09_valid

theorem v09_integral_abs : (∫ t in (0 : ℝ)..1, |v09 t|) = (exactCost09 : ℝ) := by
  change (∫ t in (0 : ℝ)..1, |plWitness 16384 1000000000000000000 nodes09 t|) = _
  rw [plWitness_integral_abs (by norm_num) (by norm_num) nodes09_valid, nodes09_mass]
  norm_num [exactCost09]

theorem v09_integral_abs_le : (∫ t in (0 : ℝ)..1, |v09 t|) ≤ (Iv09 : ℝ) := by
  rw [v09_integral_abs]
  exact_mod_cast exactCost09_le

