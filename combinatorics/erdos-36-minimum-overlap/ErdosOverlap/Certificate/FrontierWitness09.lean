theorem slopeCache09_checked :
    slopeCache09.check 16384 nodes09 tauNumerator09 = true := by
  apply PLSlopeCache.check_of_dense slopeCache09 16384 nodes09 tauNumerator09 values09
  · rfl
  · decide +kernel

theorem slopeCache09_prefix : ∀ p ∈ nodes09,
    slopeCache09.firstCell+1 ≤ p.index := by
  decide +kernel

theorem dualSlope09_before {l r : ℝ}
    (hr : r ≤ (16160 : ℝ)/16384) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau09 : ℝ) v09 t = 2*(tau09 : ℝ) := by
  exact plWitness_ae_dualSlope_before (by norm_num : 0 < 16384)
    1000000000000000000 nodes09 slopeCache09.firstCell
    (tau09 : ℝ) slopeCache09_prefix hr

theorem dualSlope09_on_leaf {j : ℕ} (hj : j < slopeCache09.numerators.size)
    {l r : ℝ} (hl : (((slopeCache09.firstCell+j : ℕ) : ℝ)/16384) ≤ l)
    (hr : r ≤ ((((slopeCache09.firstCell+j : ℕ) : ℝ)+1)/16384)) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau09 : ℝ) v09 t = (slopeCache09.value 1000000000000000000 j : ℝ) := by
  have htau : (tau09 : ℝ) = ((tauNumerator09 : ℤ) : ℝ) / 1000000000000000000 := by
    norm_num [tauNumerator09, tau09]
  rw [htau]
  exact slopeCache09.ae_dualSlope_on_leaf (by norm_num : 0 < 16384)
    1000000000000000000 nodes09 tauNumerator09 slopeCache09_checked hj hl hr

