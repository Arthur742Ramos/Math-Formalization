def periodic104_blocks : List (List AffineJump) := [periodic104_part00, periodic104_part01, periodic104_part02, periodic104_part03]

theorem periodic104_compiled : periodic104 = compiledJumpBlocks periodic104_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic104_value (t : ℝ) : affineJumpSum periodic104 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic104) t := by
  rw [periodic104_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic104_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic104_part00_eq, periodic104_part01_eq, periodic104_part02_eq, periodic104_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic104 = ((FrontierData.periodic104.drop 0).take 16) ++ ((FrontierData.periodic104.drop 16).take 16) ++ ((FrontierData.periodic104.drop 32).take 16) ++ ((FrontierData.periodic104.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
