def periodic024_blocks : List (List AffineJump) := [periodic024_part00, periodic024_part01, periodic024_part02, periodic024_part03]

theorem periodic024_compiled : periodic024 = compiledJumpBlocks periodic024_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic024_value (t : ℝ) : affineJumpSum periodic024 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic024) t := by
  rw [periodic024_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic024_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic024_part00_eq, periodic024_part01_eq, periodic024_part02_eq, periodic024_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic024 = ((FrontierData.periodic024.drop 0).take 16) ++ ((FrontierData.periodic024.drop 16).take 16) ++ ((FrontierData.periodic024.drop 32).take 16) ++ ((FrontierData.periodic024.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
