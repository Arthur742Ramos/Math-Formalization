def periodic093_blocks : List (List AffineJump) := [periodic093_part00, periodic093_part01, periodic093_part02, periodic093_part03]

theorem periodic093_compiled : periodic093 = compiledJumpBlocks periodic093_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic093_value (t : ℝ) : affineJumpSum periodic093 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic093) t := by
  rw [periodic093_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic093_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic093_part00_eq, periodic093_part01_eq, periodic093_part02_eq, periodic093_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic093 = ((FrontierData.periodic093.drop 0).take 16) ++ ((FrontierData.periodic093.drop 16).take 16) ++ ((FrontierData.periodic093.drop 32).take 16) ++ ((FrontierData.periodic093.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
