def periodic090_blocks : List (List AffineJump) := [periodic090_part00, periodic090_part01, periodic090_part02, periodic090_part03]

theorem periodic090_compiled : periodic090 = compiledJumpBlocks periodic090_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic090_value (t : ℝ) : affineJumpSum periodic090 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic090) t := by
  rw [periodic090_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic090_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic090_part00_eq, periodic090_part01_eq, periodic090_part02_eq, periodic090_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic090 = ((FrontierData.periodic090.drop 0).take 16) ++ ((FrontierData.periodic090.drop 16).take 16) ++ ((FrontierData.periodic090.drop 32).take 16) ++ ((FrontierData.periodic090.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
