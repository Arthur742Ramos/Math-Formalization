def periodic019_blocks : List (List AffineJump) := [periodic019_part00, periodic019_part01, periodic019_part02, periodic019_part03]

theorem periodic019_compiled : periodic019 = compiledJumpBlocks periodic019_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic019_value (t : ℝ) : affineJumpSum periodic019 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic019) t := by
  rw [periodic019_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic019_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic019_part00_eq, periodic019_part01_eq, periodic019_part02_eq, periodic019_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic019 = ((FrontierData.periodic019.drop 0).take 16) ++ ((FrontierData.periodic019.drop 16).take 16) ++ ((FrontierData.periodic019.drop 32).take 16) ++ ((FrontierData.periodic019.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
