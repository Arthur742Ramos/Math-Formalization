def periodic010_blocks : List (List AffineJump) := [periodic010_part00, periodic010_part01, periodic010_part02, periodic010_part03]

theorem periodic010_compiled : periodic010 = compiledJumpBlocks periodic010_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic010_value (t : ℝ) : affineJumpSum periodic010 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic010) t := by
  rw [periodic010_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic010_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic010_part00_eq, periodic010_part01_eq, periodic010_part02_eq, periodic010_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic010 = ((FrontierData.periodic010.drop 0).take 16) ++ ((FrontierData.periodic010.drop 16).take 16) ++ ((FrontierData.periodic010.drop 32).take 16) ++ ((FrontierData.periodic010.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
