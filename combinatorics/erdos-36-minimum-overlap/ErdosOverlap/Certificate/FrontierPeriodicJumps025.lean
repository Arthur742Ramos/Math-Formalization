def periodic025_blocks : List (List AffineJump) := [periodic025_part00, periodic025_part01, periodic025_part02, periodic025_part03]

theorem periodic025_compiled : periodic025 = compiledJumpBlocks periodic025_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic025_value (t : ℝ) : affineJumpSum periodic025 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic025) t := by
  rw [periodic025_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic025_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic025_part00_eq, periodic025_part01_eq, periodic025_part02_eq, periodic025_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic025 = ((FrontierData.periodic025.drop 0).take 16) ++ ((FrontierData.periodic025.drop 16).take 16) ++ ((FrontierData.periodic025.drop 32).take 16) ++ ((FrontierData.periodic025.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
