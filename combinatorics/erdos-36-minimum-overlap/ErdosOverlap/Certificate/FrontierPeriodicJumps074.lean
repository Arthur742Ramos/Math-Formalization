def periodic074_blocks : List (List AffineJump) := [periodic074_part00, periodic074_part01, periodic074_part02, periodic074_part03]

theorem periodic074_compiled : periodic074 = compiledJumpBlocks periodic074_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic074_value (t : ℝ) : affineJumpSum periodic074 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic074) t := by
  rw [periodic074_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic074_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic074_part00_eq, periodic074_part01_eq, periodic074_part02_eq, periodic074_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic074 = ((FrontierData.periodic074.drop 0).take 16) ++ ((FrontierData.periodic074.drop 16).take 16) ++ ((FrontierData.periodic074.drop 32).take 16) ++ ((FrontierData.periodic074.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

