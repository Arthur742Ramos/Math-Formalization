theorem periodic037_value (t : ℝ) : affineJumpSum periodic037 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic037) t := by
  rw [periodic037_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic037_blocks, List.flatten_cons, List.flatten_nil,
