def periodic003_blocks : List (List AffineJump) := [periodic003_part00, periodic003_part01, periodic003_part02, periodic003_part03]

theorem periodic003_compiled : periodic003 = compiledJumpBlocks periodic003_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic003_value (t : ℝ) : affineJumpSum periodic003 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic003) t := by
  rw [periodic003_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic003_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic003_part00_eq, periodic003_part01_eq, periodic003_part02_eq, periodic003_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic003 = ((FrontierData.periodic003.drop 0).take 16) ++ ((FrontierData.periodic003.drop 16).take 16) ++ ((FrontierData.periodic003.drop 32).take 16) ++ ((FrontierData.periodic003.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
