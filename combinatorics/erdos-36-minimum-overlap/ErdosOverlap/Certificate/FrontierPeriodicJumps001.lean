def periodic001_blocks : List (List AffineJump) := [periodic001_part00, periodic001_part01, periodic001_part02, periodic001_part03]

theorem periodic001_compiled : periodic001 = compiledJumpBlocks periodic001_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic001_value (t : ℝ) : affineJumpSum periodic001 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic001) t := by
  rw [periodic001_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic001_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic001_part00_eq, periodic001_part01_eq, periodic001_part02_eq, periodic001_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic001 = ((FrontierData.periodic001.drop 0).take 16) ++ ((FrontierData.periodic001.drop 16).take 16) ++ ((FrontierData.periodic001.drop 32).take 16) ++ ((FrontierData.periodic001.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
