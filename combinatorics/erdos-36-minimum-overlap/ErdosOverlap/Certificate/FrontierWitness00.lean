theorem slopeCache00_checked :
    slopeCache00.check 16384 nodes00 tauNumerator00 = true := by
  apply PLSlopeCache.check_of_dense slopeCache00 16384 nodes00 tauNumerator00 values00
  · rfl
  · decide +kernel

theorem slopeCache00_prefix : ∀ p ∈ nodes00,
    slopeCache00.firstCell+1 ≤ p.index := by
  decide +kernel

theorem dualSlope00_before {l r : ℝ}
    (hr : r ≤ (16129 : ℝ)/16384) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau00 : ℝ) v00 t = 2*(tau00 : ℝ) := by
  exact plWitness_ae_dualSlope_before (by norm_num : 0 < 16384)
    1000000000000000000 nodes00 slopeCache00.firstCell
    (tau00 : ℝ) slopeCache00_prefix hr

theorem dualSlope00_on_leaf {j : ℕ} (hj : j < slopeCache00.numerators.size)
    {l r : ℝ} (hl : (((slopeCache00.firstCell+j : ℕ) : ℝ)/16384) ≤ l)
    (hr : r ≤ ((((slopeCache00.firstCell+j : ℕ) : ℝ)+1)/16384)) :
    ∀ᵐ t ∂volume.restrict (Ioo l r),
      dualSlope (tau00 : ℝ) v00 t = (slopeCache00.value 1000000000000000000 j : ℝ) := by
  have htau : (tau00 : ℝ) = ((tauNumerator00 : ℤ) : ℝ) / 1000000000000000000 := by
    norm_num [tauNumerator00, tau00]
  rw [htau]
  exact slopeCache00.ae_dualSlope_on_leaf (by norm_num : 0 < 16384)
    1000000000000000000 nodes00 tauNumerator00 slopeCache00_checked hj hl hr

end
