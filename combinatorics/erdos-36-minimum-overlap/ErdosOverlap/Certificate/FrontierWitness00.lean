def nodes00 : List PLNode := densePLNodes 16130 values00

theorem nodes00_valid : PLValid 16384 nodes00 := by
  decide +kernel

theorem nodes00_mass : plMass nodes00 = 1041343145844172 := by
  decide +kernel

def v00 : ℝ → ℝ := plWitness 16384 1000000000000000000 nodes00

def tau00 : ℚ := (16085451792097 / 40000000000000000 : ℚ)
def Iv00 : ℚ := (63558541616465577 / 1000000000000000000000000 : ℚ)
def exactCost00 : ℚ := (260335786461043 / 4096000000000000000000 : ℚ)
def tauNumerator00 : ℤ := 402136294802425

theorem exactCost00_le : exactCost00 ≤ Iv00 := by
  decide +kernel

theorem v00_absolutelyContinuous : AbsolutelyContinuousOnInterval v00 0 1 :=
  plWitness_absolutelyContinuous 16384 1000000000000000000 nodes00

theorem v00_one : v00 1 = 0 := plWitness_one nodes00_valid
theorem v00_zero : v00 0 = 0 := plWitness_zero nodes00_valid

theorem v00_integral_abs : (∫ t in (0 : ℝ)..1, |v00 t|) = (exactCost00 : ℝ) := by
  change (∫ t in (0 : ℝ)..1, |plWitness 16384 1000000000000000000 nodes00 t|) = _
  rw [plWitness_integral_abs (by norm_num) (by norm_num) nodes00_valid, nodes00_mass]
  norm_num [exactCost00]

theorem v00_integral_abs_le : (∫ t in (0 : ℝ)..1, |v00 t|) ≤ (Iv00 : ℝ) := by
  rw [v00_integral_abs]
  exact_mod_cast exactCost00_le

