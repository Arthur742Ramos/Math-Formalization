def periodic081_blocks : List (List AffineJump) := [periodic081_part00, periodic081_part01, periodic081_part02, periodic081_part03]

theorem periodic081_compiled : periodic081 = compiledJumpBlocks periodic081_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic081_value (t : ℝ) : affineJumpSum periodic081 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic081) t := by
  rw [periodic081_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic081_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic081_part00_eq, periodic081_part01_eq, periodic081_part02_eq, periodic081_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic081 = ((FrontierData.periodic081.drop 0).take 16) ++ ((FrontierData.periodic081.drop 16).take 16) ++ ((FrontierData.periodic081.drop 32).take 16) ++ ((FrontierData.periodic081.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
