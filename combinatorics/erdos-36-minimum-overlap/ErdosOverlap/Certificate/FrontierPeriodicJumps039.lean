def periodic039_blocks : List (List AffineJump) := [periodic039_part00, periodic039_part01, periodic039_part02, periodic039_part03]

theorem periodic039_compiled : periodic039 = compiledJumpBlocks periodic039_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic039_value (t : ℝ) : affineJumpSum periodic039 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic039) t := by
  rw [periodic039_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic039_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic039_part00_eq, periodic039_part01_eq, periodic039_part02_eq, periodic039_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic039 = ((FrontierData.periodic039.drop 0).take 16) ++ ((FrontierData.periodic039.drop 16).take 16) ++ ((FrontierData.periodic039.drop 32).take 16) ++ ((FrontierData.periodic039.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
