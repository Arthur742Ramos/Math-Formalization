def periodic061_blocks : List (List AffineJump) := [periodic061_part00, periodic061_part01, periodic061_part02, periodic061_part03]

theorem periodic061_compiled : periodic061 = compiledJumpBlocks periodic061_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic061_value (t : ℝ) : affineJumpSum periodic061 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic061) t := by
  rw [periodic061_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic061_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic061_part00_eq, periodic061_part01_eq, periodic061_part02_eq, periodic061_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic061 = ((FrontierData.periodic061.drop 0).take 16) ++ ((FrontierData.periodic061.drop 16).take 16) ++ ((FrontierData.periodic061.drop 32).take 16) ++ ((FrontierData.periodic061.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
