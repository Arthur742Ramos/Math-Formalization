theorem periodic23_compiled : periodic23 = compiledJumpBlocks periodic23_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic23_value (t : ℝ) : affineJumpSum periodic23 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic23) t := by
  rw [periodic23_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic23_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic23_part00_eq, periodic23_part01_eq, periodic23_part02_eq, periodic23_part03_eq, periodic23_part04_eq, periodic23_part05_eq, periodic23_part06_eq, periodic23_part07_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic23 = ((Native6Data.native6Periodic23.drop 0).take 32) ++ ((Native6Data.native6Periodic23.drop 32).take 32) ++ ((Native6Data.native6Periodic23.drop 64).take 32) ++ ((Native6Data.native6Periodic23.drop 96).take 32) ++ ((Native6Data.native6Periodic23.drop 128).take 32) ++ ((Native6Data.native6Periodic23.drop 160).take 32) ++ ((Native6Data.native6Periodic23.drop 192).take 32) ++ ((Native6Data.native6Periodic23.drop 224).take 32) := by
    rfl
  conv_rhs => rw [hparts]
