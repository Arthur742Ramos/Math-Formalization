def periodic062_blocks : List (List AffineJump) := [periodic062_part00, periodic062_part01, periodic062_part02, periodic062_part03]

theorem periodic062_compiled : periodic062 = compiledJumpBlocks periodic062_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic062_value (t : ℝ) : affineJumpSum periodic062 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic062) t := by
  rw [periodic062_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic062_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic062_part00_eq, periodic062_part01_eq, periodic062_part02_eq, periodic062_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic062 = ((FrontierData.periodic062.drop 0).take 16) ++ ((FrontierData.periodic062.drop 16).take 16) ++ ((FrontierData.periodic062.drop 32).take 16) ++ ((FrontierData.periodic062.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
