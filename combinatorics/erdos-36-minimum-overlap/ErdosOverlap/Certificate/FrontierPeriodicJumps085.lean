def periodic085_blocks : List (List AffineJump) := [periodic085_part00, periodic085_part01, periodic085_part02, periodic085_part03]

theorem periodic085_compiled : periodic085 = compiledJumpBlocks periodic085_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic085_value (t : ℝ) : affineJumpSum periodic085 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic085) t := by
  rw [periodic085_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic085_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic085_part00_eq, periodic085_part01_eq, periodic085_part02_eq, periodic085_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic085 = ((FrontierData.periodic085.drop 0).take 16) ++ ((FrontierData.periodic085.drop 16).take 16) ++ ((FrontierData.periodic085.drop 32).take 16) ++ ((FrontierData.periodic085.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
