]

def periodic016_blocks : List (List AffineJump) := [periodic016_part00, periodic016_part01, periodic016_part02, periodic016_part03]

theorem periodic016_compiled : periodic016 = compiledJumpBlocks periodic016_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic016_value (t : ℝ) : affineJumpSum periodic016 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic016) t := by
  rw [periodic016_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic016_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic016_part00_eq, periodic016_part01_eq, periodic016_part02_eq, periodic016_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic016 = ((FrontierData.periodic016.drop 0).take 16) ++ ((FrontierData.periodic016.drop 16).take 16) ++ ((FrontierData.periodic016.drop 32).take 16) ++ ((FrontierData.periodic016.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
end ErdosOverlap.FrontierJumps
