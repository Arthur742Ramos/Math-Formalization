def periodic094_blocks : List (List AffineJump) := [periodic094_part00, periodic094_part01, periodic094_part02, periodic094_part03]

theorem periodic094_compiled : periodic094 = compiledJumpBlocks periodic094_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic094_value (t : ℝ) : affineJumpSum periodic094 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic094) t := by
  rw [periodic094_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic094_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic094_part00_eq, periodic094_part01_eq, periodic094_part02_eq, periodic094_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic094 = ((FrontierData.periodic094.drop 0).take 16) ++ ((FrontierData.periodic094.drop 16).take 16) ++ ((FrontierData.periodic094.drop 32).take 16) ++ ((FrontierData.periodic094.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
