def periodic014_blocks : List (List AffineJump) := [periodic014_part00, periodic014_part01, periodic014_part02, periodic014_part03]

theorem periodic014_compiled : periodic014 = compiledJumpBlocks periodic014_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic014_value (t : ℝ) : affineJumpSum periodic014 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic014) t := by
  rw [periodic014_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic014_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic014_part00_eq, periodic014_part01_eq, periodic014_part02_eq, periodic014_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic014 = ((FrontierData.periodic014.drop 0).take 16) ++ ((FrontierData.periodic014.drop 16).take 16) ++ ((FrontierData.periodic014.drop 32).take 16) ++ ((FrontierData.periodic014.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
