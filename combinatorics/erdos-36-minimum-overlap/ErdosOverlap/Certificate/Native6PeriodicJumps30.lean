theorem periodic30_value (t : ℝ) : affineJumpSum periodic30 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic30) t := by
  rw [periodic30_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic30_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic30_part00_eq, periodic30_part01_eq, periodic30_part02_eq, periodic30_part03_eq, periodic30_part04_eq, periodic30_part05_eq, periodic30_part06_eq, periodic30_part07_eq, periodic30_part08_eq, periodic30_part09_eq, periodic30_part10_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic30 = ((Native6Data.native6Periodic30.drop 0).take 25) ++ ((Native6Data.native6Periodic30.drop 25).take 25) ++ ((Native6Data.native6Periodic30.drop 50).take 25) ++ ((Native6Data.native6Periodic30.drop 75).take 25) ++ ((Native6Data.native6Periodic30.drop 100).take 25) ++ ((Native6Data.native6Periodic30.drop 125).take 25) ++ ((Native6Data.native6Periodic30.drop 150).take 25) ++ ((Native6Data.native6Periodic30.drop 175).take 25) ++ ((Native6Data.native6Periodic30.drop 200).take 25) ++ ((Native6Data.native6Periodic30.drop 225).take 25) ++ ((Native6Data.native6Periodic30.drop 250).take 6) := by
