def periodic103_blocks : List (List AffineJump) := [periodic103_part00, periodic103_part01, periodic103_part02, periodic103_part03]

theorem periodic103_compiled : periodic103 = compiledJumpBlocks periodic103_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic103_value (t : ℝ) : affineJumpSum periodic103 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic103) t := by
  rw [periodic103_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic103_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic103_part00_eq, periodic103_part01_eq, periodic103_part02_eq, periodic103_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic103 = ((FrontierData.periodic103.drop 0).take 16) ++ ((FrontierData.periodic103.drop 16).take 16) ++ ((FrontierData.periodic103.drop 32).take 16) ++ ((FrontierData.periodic103.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
