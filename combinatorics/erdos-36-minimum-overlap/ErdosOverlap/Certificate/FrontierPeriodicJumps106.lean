def periodic106_blocks : List (List AffineJump) := [periodic106_part00, periodic106_part01]

theorem periodic106_compiled : periodic106 = compiledJumpBlocks periodic106_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic106_value (t : ℝ) : affineJumpSum periodic106 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic106) t := by
  rw [periodic106_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic106_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic106_part00_eq, periodic106_part01_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic106 = ((FrontierData.periodic106.drop 0).take 16) ++ ((FrontierData.periodic106.drop 16).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
