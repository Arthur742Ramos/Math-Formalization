def periodic038_blocks : List (List AffineJump) := [periodic038_part00, periodic038_part01, periodic038_part02, periodic038_part03]

theorem periodic038_compiled : periodic038 = compiledJumpBlocks periodic038_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic038_value (t : ℝ) : affineJumpSum periodic038 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic038) t := by
  rw [periodic038_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic038_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic038_part00_eq, periodic038_part01_eq, periodic038_part02_eq, periodic038_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic038 = ((FrontierData.periodic038.drop 0).take 16) ++ ((FrontierData.periodic038.drop 16).take 16) ++ ((FrontierData.periodic038.drop 32).take 16) ++ ((FrontierData.periodic038.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
