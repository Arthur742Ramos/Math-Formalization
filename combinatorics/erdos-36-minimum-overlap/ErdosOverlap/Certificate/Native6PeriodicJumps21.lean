def periodic21_blocks : List (List AffineJump) := [periodic21_part00, periodic21_part01, periodic21_part02, periodic21_part03, periodic21_part04, periodic21_part05, periodic21_part06]

theorem periodic21_compiled : periodic21 = compiledJumpBlocks periodic21_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic21_value (t : ℝ) : affineJumpSum periodic21 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic21) t := by
  rw [periodic21_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic21_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic21_part00_eq, periodic21_part01_eq, periodic21_part02_eq, periodic21_part03_eq, periodic21_part04_eq, periodic21_part05_eq, periodic21_part06_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic21 = ((Native6Data.native6Periodic21.drop 0).take 42) ++ ((Native6Data.native6Periodic21.drop 42).take 42) ++ ((Native6Data.native6Periodic21.drop 84).take 42) ++ ((Native6Data.native6Periodic21.drop 126).take 42) ++ ((Native6Data.native6Periodic21.drop 168).take 39) ++ ((Native6Data.native6Periodic21.drop 207).take 32) ++ ((Native6Data.native6Periodic21.drop 239).take 17) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

