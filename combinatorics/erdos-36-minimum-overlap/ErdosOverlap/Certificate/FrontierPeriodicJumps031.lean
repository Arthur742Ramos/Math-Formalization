def periodic031_blocks : List (List AffineJump) := [periodic031_part00, periodic031_part01, periodic031_part02, periodic031_part03]

theorem periodic031_compiled : periodic031 = compiledJumpBlocks periodic031_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic031_value (t : ℝ) : affineJumpSum periodic031 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic031) t := by
  rw [periodic031_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic031_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic031_part00_eq, periodic031_part01_eq, periodic031_part02_eq, periodic031_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic031 = ((FrontierData.periodic031.drop 0).take 16) ++ ((FrontierData.periodic031.drop 16).take 16) ++ ((FrontierData.periodic031.drop 32).take 16) ++ ((FrontierData.periodic031.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
