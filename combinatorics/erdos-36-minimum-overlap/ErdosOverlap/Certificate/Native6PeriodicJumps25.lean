theorem periodic25_compiled : periodic25 = compiledJumpBlocks periodic25_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic25_value (t : ℝ) : affineJumpSum periodic25 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic25) t := by
  rw [periodic25_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic25_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic25_part00_eq, periodic25_part01_eq, periodic25_part02_eq, periodic25_part03_eq, periodic25_part04_eq, periodic25_part05_eq, periodic25_part06_eq, periodic25_part07_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic25 = ((Native6Data.native6Periodic25.drop 0).take 32) ++ ((Native6Data.native6Periodic25.drop 32).take 32) ++ ((Native6Data.native6Periodic25.drop 64).take 32) ++ ((Native6Data.native6Periodic25.drop 96).take 32) ++ ((Native6Data.native6Periodic25.drop 128).take 32) ++ ((Native6Data.native6Periodic25.drop 160).take 32) ++ ((Native6Data.native6Periodic25.drop 192).take 32) ++ ((Native6Data.native6Periodic25.drop 224).take 32) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

