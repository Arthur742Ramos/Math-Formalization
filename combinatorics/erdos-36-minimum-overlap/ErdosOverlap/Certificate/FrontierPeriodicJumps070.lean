def periodic070_blocks : List (List AffineJump) := [periodic070_part00, periodic070_part01, periodic070_part02, periodic070_part03]

theorem periodic070_compiled : periodic070 = compiledJumpBlocks periodic070_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic070_value (t : ℝ) : affineJumpSum periodic070 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic070) t := by
  rw [periodic070_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic070_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic070_part00_eq, periodic070_part01_eq, periodic070_part02_eq, periodic070_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic070 = ((FrontierData.periodic070.drop 0).take 16) ++ ((FrontierData.periodic070.drop 16).take 16) ++ ((FrontierData.periodic070.drop 32).take 16) ++ ((FrontierData.periodic070.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
