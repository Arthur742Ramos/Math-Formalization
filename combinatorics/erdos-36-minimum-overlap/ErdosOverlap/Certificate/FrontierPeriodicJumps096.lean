  rw [periodic096_part00_eq, periodic096_part01_eq, periodic096_part02_eq, periodic096_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic096 = ((FrontierData.periodic096.drop 0).take 16) ++ ((FrontierData.periodic096.drop 16).take 16) ++ ((FrontierData.periodic096.drop 32).take 16) ++ ((FrontierData.periodic096.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
