def periodic020_blocks : List (List AffineJump) := [periodic020_part00, periodic020_part01, periodic020_part02, periodic020_part03]

theorem periodic020_compiled : periodic020 = compiledJumpBlocks periodic020_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic020_value (t : ℝ) : affineJumpSum periodic020 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic020) t := by
  rw [periodic020_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic020_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic020_part00_eq, periodic020_part01_eq, periodic020_part02_eq, periodic020_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic020 = ((FrontierData.periodic020.drop 0).take 16) ++ ((FrontierData.periodic020.drop 16).take 16) ++ ((FrontierData.periodic020.drop 32).take 16) ++ ((FrontierData.periodic020.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
