def periodic01_blocks : List (List AffineJump) := [periodic01_part00, periodic01_part01, periodic01_part02, periodic01_part03]

theorem periodic01_compiled : periodic01 = compiledJumpBlocks periodic01_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic01_value (t : ℝ) : affineJumpSum periodic01 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic01) t := by
  rw [periodic01_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic01_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic01_part00_eq, periodic01_part01_eq, periodic01_part02_eq, periodic01_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : Native6Data.native6Periodic01 = ((Native6Data.native6Periodic01.drop 0).take 64) ++ ((Native6Data.native6Periodic01.drop 64).take 64) ++ ((Native6Data.native6Periodic01.drop 128).take 64) ++ ((Native6Data.native6Periodic01.drop 192).take 64) := by
    rfl
  conv_rhs => rw [hparts]
  simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
