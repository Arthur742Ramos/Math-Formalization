def periodic008_blocks : List (List AffineJump) := [periodic008_part00, periodic008_part01, periodic008_part02, periodic008_part03]

theorem periodic008_compiled : periodic008 = compiledJumpBlocks periodic008_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic008_value (t : ℝ) : affineJumpSum periodic008 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic008) t := by
  rw [periodic008_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic008_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic008_part00_eq, periodic008_part01_eq, periodic008_part02_eq, periodic008_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic008 = ((FrontierData.periodic008.drop 0).take 16) ++ ((FrontierData.periodic008.drop 16).take 16) ++ ((FrontierData.periodic008.drop 32).take 16) ++ ((FrontierData.periodic008.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
