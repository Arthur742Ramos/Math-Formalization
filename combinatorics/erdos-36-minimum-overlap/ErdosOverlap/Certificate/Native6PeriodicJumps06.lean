theorem periodic06_value (t : ℝ) : affineJumpSum periodic06 t =
    affineJumpSum (periodicRowsJumps 131072 Native6Data.native6Periodic06) t := by
  rw [periodic06_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic06_blocks, List.flatten_cons, List.flatten_nil, List.append_nil, affineJumpSum_append]
  rw [periodic06_part00_eq, periodic06_part01_eq, periodic06_part02_eq, periodic06_part03_eq]
