def periodic027_blocks : List (List AffineJump) := [periodic027_part00, periodic027_part01, periodic027_part02, periodic027_part03]

theorem periodic027_compiled : periodic027 = compiledJumpBlocks periodic027_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic027_value (t : ℝ) : affineJumpSum periodic027 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic027) t := by
  rw [periodic027_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic027_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic027_part00_eq, periodic027_part01_eq, periodic027_part02_eq, periodic027_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic027 = ((FrontierData.periodic027.drop 0).take 16) ++ ((FrontierData.periodic027.drop 16).take 16) ++ ((FrontierData.periodic027.drop 32).take 16) ++ ((FrontierData.periodic027.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
