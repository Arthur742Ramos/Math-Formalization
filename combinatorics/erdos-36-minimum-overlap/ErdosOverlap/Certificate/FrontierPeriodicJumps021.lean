def periodic021_blocks : List (List AffineJump) := [periodic021_part00, periodic021_part01, periodic021_part02, periodic021_part03]

theorem periodic021_compiled : periodic021 = compiledJumpBlocks periodic021_blocks := by
  apply affineJumpsEqual_sound
  decide +kernel

theorem periodic021_value (t : ℝ) : affineJumpSum periodic021 t =
    affineJumpSum (periodicRowsJumps 131072 FrontierData.periodic021) t := by
  rw [periodic021_compiled, affineJumpSum_compiledBlocks]
  simp only [periodic021_blocks, List.flatten_cons, List.flatten_nil,
    List.append_nil, affineJumpSum_append]
  rw [periodic021_part00_eq, periodic021_part01_eq, periodic021_part02_eq, periodic021_part03_eq]
  simp only [affineJumpSum_compiledPeriodicRows]
  have hparts : FrontierData.periodic021 = ((FrontierData.periodic021.drop 0).take 16) ++ ((FrontierData.periodic021.drop 16).take 16) ++ ((FrontierData.periodic021.drop 32).take 16) ++ ((FrontierData.periodic021.drop 48).take 16) := by rfl
  conv_rhs => rw [hparts]
  all_goals simp only [periodicRowsJumps_append, affineJumpSum_append, add_assoc]

end
