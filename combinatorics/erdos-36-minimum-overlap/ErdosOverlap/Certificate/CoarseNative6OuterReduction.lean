theorem outerRowsNeedingIntegrals_length : outerRowsNeedingIntegrals.length = 60 := rfl

theorem outerRowsExcludedByCap_length : outerRowsExcludedByCap.length = 30 := rfl

theorem outerRows_split :
    outerRows = outerRowsNeedingIntegrals ++ outerRowsExcludedByCap := rfl

theorem auxiliaryHeight_mean_threshold :
    2*(auxiliaryHeight : ℝ)-(auxiliaryHeight : ℝ)^2 < (5/8 : ℝ) := by
  norm_num [auxiliaryHeight]

theorem outerRowsExcludedByCap_lo {r : Row} (hr : r ∈ outerRowsExcludedByCap) :
    (5/8 : ℚ) ≤ r.lo := by
  have hc : outerRowsExcludedByCap.all (fun s => decide ((5/8 : ℚ) ≤ s.lo)) = true :=
    by decide +kernel
  exact of_decide_eq_true ((List.all_eq_true.mp hc) r hr)

/-- These thirty physical inequalities are unconditional; their cap premise
contradicts the proved bound on the actual physical first moment. -/
theorem outerRowsExcludedByCap_physical :
    PhysicalMeanInequalities outerRowsExcludedByCap auxiliaryHeight := by
  intro r hr
  apply physicalMeanInequality_of_cap_threshold (by norm_num [auxiliaryHeight])
  have hlo : (5/8 : ℝ) ≤ (r.lo : ℝ) := by
    have hc := (Rat.cast_le (K := ℝ)).2 (outerRowsExcludedByCap_lo hr)
    simpa only [Rat.cast_div, Rat.cast_ofNat] using hc
  exact auxiliaryHeight_mean_threshold.trans_le hlo

/-- Only sixty outer denominators remain among the original ninety rows. -/
theorem outerRows_physical_of_needed
    (hneeded : PhysicalMeanInequalities outerRowsNeedingIntegrals auxiliaryHeight) :
    PhysicalMeanInequalities outerRows auxiliaryHeight := by
  intro r hr
  rw [outerRows_split] at hr
  rcases List.mem_append.mp hr with hr | hr
  · exact hneeded r hr
  · exact outerRowsExcludedByCap_physical r hr

theorem headline_lt_of_native_and_needed_outer
    (hnative : PhysicalMeanInequalities nativeRows auxiliaryHeight)
    (hneeded : PhysicalMeanInequalities outerRowsNeedingIntegrals auxiliaryHeight) :
    (headlineTarget : ℝ) < erdosOverlapConstant := by
  apply headline_lt_erdosConstant_of_positive
  intro r hr
  change r ∈ nativeRows ++ outerRows at hr
  rcases List.mem_append.mp hr with hr | hr
  · exact hnative r hr
  · exact outerRows_physical_of_needed hneeded r hr

end ErdosOverlap.Certificate.CoarseNative6
